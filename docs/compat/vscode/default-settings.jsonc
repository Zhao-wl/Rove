	// 指定是否在 _贡献者_ 视图中显示头像图片而不是提交（或状态）图标
	"gitlens.views.contributors.avatars": true,

	// 指定是否压缩（平铺）_贡献者_ 视图中不必要的文件嵌套。仅在 `gitlens.views.contributors.files.layout` 设置为 `tree` 或 `auto` 时适用
	"gitlens.views.contributors.files.compact": true,

	// 指定 _贡献者_ 视图如何显示文件图标
	//  - status: 将文件的状态显示为图标
	//  - type: 将文件的类型（主题图标）显示为图标
	"gitlens.views.contributors.files.icon": "type",

	// 指定 _贡献者_ 视图如何显示文件
	//  - auto: 根据 `gitlens.views.contributors.files.threshold` 值和每个嵌套级别的文件数量，自动切换文件的显示形式（`tree` 或 `list`）
	//  - list: 以列表形式显示文件
	//  - tree: 以树形式显示文件
	"gitlens.views.contributors.files.layout": "auto",

	// 指定在 _贡献者_ 视图中，根据一个嵌套级别中的文件数量，何时在以 `tree` 或 `list` 形式显示文件之间切换。仅在 `gitlens.views.contributors.files.layout` 设置为 `auto` 时适用
	"gitlens.views.contributors.files.threshold": 5,

	// 指定等待所有贡献者加载的最长时间（以秒为单位）。使用 0 表示无限期等待（无超时）
	"gitlens.views.contributors.maxWait": 10,

	// 指定是否在 _贡献者_ 视图中查询与分支和提交关联的拉取请求。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.contributors.pullRequests.enabled": true,

	// 指定是否在 _贡献者_ 视图中显示与提交关联的拉取请求（如有）。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.contributors.pullRequests.showForCommits": true,

	// 指定是否在 _贡献者_ 视图中显示贡献者，否则将在 _仓库_ 视图中显示
	"gitlens.views.contributors.reveal": true,

	// 指定是否在 _贡献者_ 视图中显示来自所有分支的提交
	"gitlens.views.contributors.showAllBranches": false,

	// 指定是否在 _贡献者_ 视图中显示贡献者统计信息。计算可能需要一些时间，具体取决于仓库大小
	"gitlens.views.contributors.showStatistics": false,

	// 搜索和比较视图
	// 指定是否在 _搜索和比较_ 视图中显示头像图片而不是提交（或状态）图标
	"gitlens.views.searchAndCompare.avatars": true,

	// 指定是否压缩（平铺）_搜索和比较_ 视图中不必要的文件嵌套。仅在 `gitlens.views.searchAndCompare.files.layout` 设置为 `tree` 或 `auto` 时适用
	"gitlens.views.searchAndCompare.files.compact": true,

	// 指定 _搜索和比较_ 视图如何显示文件图标
	//  - status: 将文件的状态显示为图标
	//  - type: 将文件的类型（主题图标）显示为图标
	"gitlens.views.searchAndCompare.files.icon": "type",

	// 指定 _搜索和比较_ 视图如何显示文件
	//  - auto: 根据 `gitlens.views.searchAndCompare.files.threshold` 值和每个嵌套级别的文件数量，自动切换文件的显示形式（`tree` 或 `list`）
	//  - list: 以列表形式显示文件
	//  - tree: 以树形式显示文件
	"gitlens.views.searchAndCompare.files.layout": "auto",

	// Specifies whether to open the changes (diff) when clicking a file in the _Search & Compare_ view. When disabled, opens the working file at the first changed line instead
	"gitlens.views.searchAndCompare.files.openDiffOnClick": true,

	// 指定在 _搜索和比较_ 视图中，根据一个嵌套级别中的文件数量，何时在以 `tree` 或 `list` 形式显示文件之间切换。仅在 `gitlens.views.searchAndCompare.files.layout` 设置为 `auto` 时适用
	"gitlens.views.searchAndCompare.files.threshold": 5,

	// 指定是否在 _搜索和比较_ 视图中查询与提交关联的拉取请求。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.searchAndCompare.pullRequests.enabled": true,

	// 指定是否在 _搜索和比较_ 视图中显示与提交关联的拉取请求（如有）。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.searchAndCompare.pullRequests.showForCommits": true,

	// 云补丁视图（预览）
	// 指定是否在 _云补丁_ 视图中显示头像图片而不是提交（或状态）图标
	"gitlens.views.drafts.avatars": true,

	// 指定是否压缩（平铺）_云补丁_ 视图中不必要的文件嵌套。仅在 `gitlens.views.drafts.files.layout` 设置为 `tree` 或 `auto` 时适用
	"gitlens.views.drafts.files.compact": true,

	// 指定 _云补丁_ 视图如何显示文件图标
	//  - status: 将文件的状态显示为图标
	//  - type: 将文件的类型（主题图标）显示为图标
	"gitlens.views.drafts.files.icon": "type",

	// 指定 _云补丁_ 视图如何显示文件
	//  - auto: 根据 `gitlens.views.drafts.files.threshold` 值和每个嵌套级别的文件数量，自动切换文件的显示形式（`tree` 或 `list`）
	//  - list: 以列表形式显示文件
	//  - tree: 以树形式显示文件
	"gitlens.views.drafts.files.layout": "auto",

	// 指定在 _云补丁_ 视图中，根据一个嵌套级别中的文件数量，何时在以 `tree` 或 `list` 形式显示文件之间切换。仅在 `gitlens.views.drafts.files.layout` 设置为 `auto` 时适用
	"gitlens.views.drafts.files.threshold": 5,

	// 补丁详细信息视图（预览）
	// 指定是否在 _补丁详细信息_ 视图中显示头像图片而不是提交（或状态）图标
	"gitlens.views.patchDetails.avatars": true,

	// 指定是否压缩（平铺）_补丁详细信息_ 视图中不必要的文件嵌套。仅在 `gitlens.views.patchDetails.files.layout` 设置为 `tree` 或 `auto` 时适用
	"gitlens.views.patchDetails.files.compact": true,

	// 指定 _补丁详细信息_ 视图如何显示文件图标
	//  - status: 将文件的状态显示为图标
	//  - type: 将文件的类型（主题图标）显示为图标
	"gitlens.views.patchDetails.files.icon": "type",

	// 指定 _补丁详细信息_ 视图如何显示文件
	//  - auto: 根据 `gitlens.views.patchDetails.files.threshold` 值和每个嵌套级别的文件数量，自动切换文件的显示形式（`tree` 或 `list`）
	//  - list: 以列表形式显示文件
	//  - tree: 以树形式显示文件
	"gitlens.views.patchDetails.files.layout": "auto",

	// 指定在 _补丁详细信息_ 视图中，根据一个嵌套级别中的文件数量，何时在以 `tree` 或 `list` 形式显示文件之间切换。仅在 `gitlens.views.patchDetails.files.layout` 设置为 `auto` 时适用
	"gitlens.views.patchDetails.files.threshold": 5,

	// 云工作区视图（预览）
	// 指定是否在 _云工作区_ 视图中显示头像图片而不是提交（或状态）图标
	"gitlens.views.workspaces.avatars": true,

	// 指定是否压缩（平铺）_云工作区_ 视图中不必要的分支和标签嵌套。仅在 `gitlens.views.workspaces.branches.layout` 设置为 `tree` 时适用
	"gitlens.views.workspaces.branches.compact": true,

	// 指定 _云工作区_ 视图如何显示分支和标签
	//  - list: 以列表形式显示分支和标签
	//  - tree: 当名称包含斜杠 `/` 时，以树形式显示分支和标签
	"gitlens.views.workspaces.branches.layout": "tree",

	// 指定是否在 _云工作区_ 视图中的每个分支下方显示该分支与用户选择的引用（分支、标签等）的比较
	//  - false: 隐藏分支比较
	//  - branch: 将分支与用户选择的引用进行比较
	"gitlens.views.workspaces.branches.showBranchComparison": "branch",

	// 指定是否在 _云工作区_ 视图的 _提交_ 和 _分支_ 部分中显示贮藏
	"gitlens.views.workspaces.branches.showStashes": false,

	// 指定是否以紧凑的显示密度显示 _云工作区_ 视图
	"gitlens.views.workspaces.compact": false,

	// 指定是否压缩（平铺）_云工作区_ 视图中不必要的文件嵌套。仅在 `gitlens.views.workspaces.files.layout` 设置为 `tree` 或 `auto` 时适用
	"gitlens.views.workspaces.files.compact": true,

	// 指定 _云工作区_ 视图如何显示文件图标
	//  - status: 将文件的状态显示为图标
	//  - type: 将文件的类型（主题图标）显示为图标
	"gitlens.views.workspaces.files.icon": "type",

	// 指定 _云工作区_ 视图如何显示文件
	//  - auto: 根据 `gitlens.views.workspaces.files.threshold` 值和每个嵌套级别的文件数量，自动切换文件的显示形式（`tree` 或 `list`）
	//  - list: 以列表形式显示文件
	//  - tree: 以树形式显示文件
	"gitlens.views.workspaces.files.layout": "auto",

	// 指定在 _云工作区_ 视图中，根据一个嵌套级别中的文件数量，何时在以 `tree` 或 `list` 形式显示文件之间切换。仅在 `gitlens.views.workspaces.files.layout` 设置为 `auto` 时适用
	"gitlens.views.workspaces.files.threshold": 5,

	// 指定是否在 _云工作区_ 视图中包含每个仓库的工作树文件状态
	"gitlens.views.workspaces.includeWorkingTree": false,

	// 指定是否在 _云工作区_ 视图中查询与分支和提交关联的拉取请求。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.workspaces.pullRequests.enabled": true,

	// 指定是否在 _云工作区_ 视图中显示与分支关联的拉取请求（如有）。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.workspaces.pullRequests.showForBranches": true,

	// 指定是否在 _云工作区_ 视图中显示与提交关联的拉取请求（如有）。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.workspaces.pullRequests.showForCommits": true,

	// 指定是否在 _云工作区_ 视图中显示当前分支或工作树与用户选择的引用（分支、标签等）的比较
	//  - false: 隐藏分支比较
	//  - branch: 将当前分支与用户选择的引用进行比较
	//  - working: 将工作树与用户选择的引用进行比较
	"gitlens.views.workspaces.showBranchComparison": "working",

	// 指定是否在 _云工作区_ 视图中显示每个仓库的分支
	"gitlens.views.workspaces.showBranches": true,

	// 指定是否在 _云工作区_ 视图中显示每个仓库的当前分支上的提交
	"gitlens.views.workspaces.showCommits": true,

	// 指定是否在 _云工作区_ 视图中显示每个仓库的贡献者
	"gitlens.views.workspaces.showContributors": true,

	// 指定是否在 _云工作区_ 视图中显示每个仓库的实验性传入活动
	"gitlens.views.workspaces.showIncomingActivity": false,

	// 指定是否在 _云工作区_ 视图中显示每个仓库的远程
	"gitlens.views.workspaces.showRemotes": true,

	// 指定是否在 _云工作区_ 视图中显示每个仓库的贮藏
	"gitlens.views.workspaces.showStashes": false,

	// 指定是否在 _云工作区_ 视图中显示每个仓库的标签
	"gitlens.views.workspaces.showTags": true,

	// 指定是否在 _云工作区_ 视图中显示每个仓库当前分支的上游状态
	"gitlens.views.workspaces.showUpstreamStatus": true,

	// 指定是否在 _云工作区_ 视图中显示每个仓库的工作树
	"gitlens.views.workspaces.showWorktrees": true,

	// 指定 _云工作区_ 视图如何显示工作树
	//  - name: 显示工作树名称
	//  - path: 显示工作树路径
	//  - relativePath: 显示工作树相对路径
	"gitlens.views.workspaces.worktrees.viewAs": "name",

	// 交互式变基编辑器
	// 指定 _交互式变基编辑器_ 的布局密度
	//  - compact: 间距极小的紧凑布局
	//  - comfortable: 行间距更大的舒适布局
	"gitlens.rebaseEditor.density": "comfortable",

	// 指定变基暂停时自动重新打开 _交互式变基编辑器_ 时使用的编辑器组
	//  - auto: 当已存在多窗格布局时，在提交信息编辑器旁打开编辑器；否则在活动编辑器组中打开
	//  - beside: 始终在活动编辑器旁边打开编辑器，必要时创建新的编辑器组
	"gitlens.rebaseEditor.openBehavior": "auto",

	// 指定检测到暂停的变基时是否自动打开 _交互式变基编辑器_（或在冲突暂停且可访问时打开 _提交图_）
	//  - false: 从不自动打开
	//  - auto: 仅在暂停的变基由 GitLens 启动（变基命令、提交图、自动变基或执行变基的拉取）或通过 GitLens 操作（例如继续）时才自动打开
	//  - interactive: 仅在检测到交互式变基时自动打开
	//  - true: 检测到任何暂停的变基时自动打开
	"gitlens.rebaseEditor.openOnPausedRebase": "auto",

	// 指定 Git 提交在 _交互式变基编辑器_ 中的显示方式
	//  - asc: 最早提交优先显示
	//  - desc: 最新提交优先显示
	"gitlens.rebaseEditor.ordering": "desc",

	// 指定在 `gitlens.rebaseEditor.revealLocation` 位置自动显示提交的时机
	//  - onDoubleClick: 双击行时自动显示提交
	//  - onSelection: 选择更改或双击行时自动显示提交
	"gitlens.rebaseEditor.revealBehavior": "onDoubleClick",

	// 指定显示提交和引用的位置
	//  - graph: 在 _提交图_ 中显示提交
	//  - inspect: 在 _检查器_ 视图中显示提交
	"gitlens.rebaseEditor.revealLocation": "graph",

	// Git 命令面板
	// 指定适用时是否在快速选择菜单中显示头像图像
	"gitlens.gitCommands.avatars": true,

	// 指定是否在失去焦点时关闭 _Git 命令面板_（否则，按 `ESC` 关闭）
	"gitlens.gitCommands.closeOnFocusOut": true,

	// 指定是匹配全部还是任一提交信息搜索模式
	"gitlens.gitCommands.search.matchAll": false,

	// 指定匹配提交搜索模式时是否区分大小写
	"gitlens.gitCommands.search.matchCase": false,

	// 指定是否使用正则表达式匹配提交搜索模式
	"gitlens.gitCommands.search.matchRegex": true,

	// 指定是直接在快速选择菜单中显示提交搜索结果、在侧边栏中显示，还是根据上下文决定
	"gitlens.gitCommands.search.showResultsInSideBar": null,

	// 已弃用。此设置已重命名为 `gitlens.gitCommands.search.showResultsInSideBar`
	// 
	"gitlens.gitCommands.search.showResultsInView": null,

	// 指定哪些 Git 命令（以及何时）将跳过确认步骤，格式为：`git-command-name:(menu|command)`
	//  - branch-create:command: Skips branch create confirmations when run from a command, e.g. a view action
	//  - branch-create:menu: Skips branch create confirmations when run from the Git Command Palette
	//  - co-authors:command: Skips co-author confirmations when run from a command, e.g. a view action
	//  - co-authors:menu: Skips co-author confirmations when run from the Git Command Palette
	//  - fetch:command: Skips fetch confirmations when run from a command, e.g. a view action
	//  - fetch:menu: Skips fetch confirmations when run from the Git Command Palette
	//  - pull:command: Skips pull confirmations when run from a command, e.g. a view action
	//  - pull:menu: Skips pull confirmations when run from the Git Command Palette
	//  - push:command: Skips push confirmations when run from a command, e.g. a view action
	//  - push:menu: Skips push confirmations when run from the Git Command Palette
	//  - stash-apply:command: Skips stash apply confirmations when run from a command, e.g. a view action
	//  - stash-apply:menu: Skips stash apply confirmations when run from the Git Command Palette
	//  - stash-pop:command: Skips stash pop confirmations when run from a command, e.g. a view action
	//  - stash-pop:menu: Skips stash pop confirmations when run from the Git Command Palette
	//  - stash-push:command: Skips stash push confirmations when run from a command, e.g. a view action
	//  - stash-push:menu: Skips stash push confirmations when run from the Git Command Palette
	//  - switch:command: Skips switch confirmations when run from a command, e.g. a view action
	//  - switch:menu: Skips switch confirmations when run from the Git Command Palette
	//  - tag-create:command: Skips tag create confirmations when run from a command, e.g. a view action
	//  - tag-create:menu: Skips tag create confirmations when run from the Git Command Palette
	//  - tag-push:command: Skips tag push confirmations when run from a command, e.g. a view action
	//  - tag-push:menu: Skips tag push confirmations when run from the Git Command Palette
	"gitlens.gitCommands.skipConfirmations": [
		"fetch:command",
		"stash-push:command"
	],

	// 指定 _Git 命令面板_ 中 Git 命令的排序方式
	//  - name: 按名称排序命令
	//  - usage: 按上次使用日期排序命令
	"gitlens.gitCommands.sortBy": "usage",

	// 集成
	// 指定提交信息中指向外部资源的自动链接。使用 `<num>` 作为引用编号的变量
	"gitlens.autolinks": null,

	// 指定是否启用与任何受支持的远程服务的丰富集成
	"gitlens.integrations.enabled": true,

	// 指定使用 Visual Studio Live Share 时是否允许来宾访问 GitLens 功能
	"gitlens.liveshare.allowGuestAccess": true,

	// 指定是否启用与 Visual Studio Live Share 的集成
	"gitlens.liveshare.enabled": true,

	// 指定合作伙伴集成的配置
	"gitlens.partners": null,

	// 指定要与 Git 远程匹配的自定义远程服务，用于检测内置远程服务的自定义域，或为自定义远程服务提供支持
	"gitlens.remotes": null,

	// 终端
	// 指定是否启用 GitKraken CLI 的实验性 insiders 版本。未设置时，会在 GitLens 的预发布和调试构建中自动启用
	"gitlens.gitkraken.cli.insiders.enabled": null,

	// 指定用于开发的本地 GitKraken CLI 二进制文件路径。在开发模式下设置后，CLI 的自动安装和自动更新将被禁用。_仅在开发模式下运行时适用。_
	"gitlens.gitkraken.cli.localPath": null,

	// 指定是否自动安装并启用 GitKraken MCP。这仅适用于 VS Code 1.101 及更高版本。
	"gitlens.gitkraken.mcp.autoEnabled": true,

	// 指定 GitLens 打开其创建的终端的位置
	//  - panel: 在终端面板中打开
	//  - editor: 作为编辑器标签页打开
	"gitlens.openInTerminalLocation": "panel",

	// 指定在 GitLens 终端命令中是否将 VS Code 用作 Git 的 `core.editor`
	"gitlens.terminal.overrideGitEditor": true,

	// 指定是否启用终端链接 &mdash; 集成终端中的自动链接，可快速跳转到提交、分支、标签等的更多详细信息
	"gitlens.terminalLinks.enabled": true,

	// 已弃用。请改用 `gitlens.terminalLinks.showIn`
	// 指定在集成终端中点击提交链接时是否显示 _提交详细信息_ 视图
	"gitlens.terminalLinks.showDetailsView": true,

	// 指定在集成终端中点击提交、分支、标签或引用的链接时打开的位置
	//  - graph: 在提交图中显示该提交、分支、标签或引用（范围会打开一个比较）
	//  - inspect: 在提交详细信息视图中显示该提交、分支、标签或引用（其尖端提交）（范围会打开一个比较）
	//  - quickpick: 在快速选择菜单中显示该提交、分支、标签或引用（范围会打开提交日志）
	"gitlens.terminalLinks.showIn": "graph",

	// AI（预览）
	// 指定当终端和代理的 VS Code 扩展都能打开过去的代理会话时，在哪里恢复。标明目标的标签和菜单项不受影响
	//  - null: 首次在任一位置都可恢复会话时询问使用哪一个，并可选择记住（默认）
	//  - terminal: 始终在新的集成终端中恢复
	//  - extension: 当代理的 VS Code 扩展可以打开会话时在其中恢复，否则在终端中恢复
	"gitlens.agents.resumeTarget": null,

	// 指定在自动变基期间自动应用冲突解决所需的最低 AI 置信度（0–1）；低于此值时变基将暂停并交给冲突解决面板供你审查
	"gitlens.ai.autoRebase.confidenceThreshold": 0.8,

	// 指定用于访问 Azure OpenAI 模型的自定义 URL。Azure URL 应采用以下格式：https://{your-resource-name}.openai.azure.com/openai/deployments/{deployment-id}/chat/completions?api-version={api-version}
	"gitlens.ai.azure.url": null,

	// 当路由为 `agent` 时，用于 Start Work / Start PR Review 的默认代理。以不透明 id 形式存储（例如 `ide-chat`、`claude-extension`、`cli:claude-cli`）。当持久化的代理不再可用时，回退到代理选择器。
	"gitlens.ai.defaultAgent": null,

	// 指定是否启用 GitLens 的 AI 功能
	"gitlens.ai.enabled": true,

	// 指定在生成提交信息、解释更改等时从 AI 提示中排除文件所用的 glob 模式。与 `files.exclude` 类似，使用 glob 模式作为键，`true` 表示排除，`false` 表示包含。
	"gitlens.ai.exclude.files": {
		"**/pnpm-lock.yaml": true,
		"**/package-lock.json": true,
		"**/yarn.lock": true,
		"**/Cargo.lock": true,
		"**/Gemfile.lock": true,
		"**/composer.lock": true,
		"**/Pipfile.lock": true,
		"**/poetry.lock": true,
		"**/go.sum": true,
		"**/*.min.js": true,
		"**/*.min.css": true,
		"**/*.map": true,
		"**/dist/**": true,
		"**/out/**": true,
		"**/build/**": true,
		"**/node_modules/**": true
	},

	// 指定在生成更改摘要时提供给 AI 提供方的自定义指令
	"gitlens.ai.explainChanges.customInstructions": null,

	// 指定在根据一组更改生成变更日志时提供给 AI 提供方的自定义指令
	"gitlens.ai.generateChangelog.customInstructions": null,

	// 指定在生成提交信息时提供给 AI 提供方的自定义指令
	"gitlens.ai.generateCommitMessage.customInstructions": null,

	// 指定在生成提交时提供给 AI 提供方的自定义指令
	"gitlens.ai.generateCommits.customInstructions": null,

	// 指定在生成云补丁标题和描述时提供给 AI 提供方的自定义指令
	"gitlens.ai.generateCreateCloudPatch.customInstructions": null,

	// 指定在生成拉取请求标题和描述时提供给 AI 提供方的自定义指令
	"gitlens.ai.generateCreatePullRequest.customInstructions": null,

	// 指定在生成贮藏信息时提供给 AI 提供方的自定义指令
	"gitlens.ai.generateStashMessage.customInstructions": null,

	// 指定用于 GitLens AI 功能的 GitKraken AI 提供的模型，格式为 `provider:model`
	"gitlens.ai.gitkraken.model": null,

	// 指定显示提示过大警告的阈值（以 token 为单位）
	"gitlens.ai.largePromptWarningThreshold": 120000,

	// 指定用于 GitLens AI 功能的 AI 提供方和模型。应格式化为 `provider:model`（例如 `openai:gpt-5.5` 或 `anthropic:claude-sonnet-5`）、用于 GitKraken AI 提供的模型的 `gitkraken`，或用于 VS Code 扩展 API（例如 Copilot）所提供模型的 `vscode`
	"gitlens.ai.model": null,

	// 指定 AI 模型的 temperature，即输出随机性的度量。值越高随机性越大（例如更具创造性），值越低则更具确定性
	"gitlens.ai.modelOptions.temperature": 0.7,

	// 指定用于访问的 Ollama URL
	"gitlens.ai.ollama.url": null,

	// 指定用于访问 OpenAI 模型的自定义 URL。
	"gitlens.ai.openai.url": null,

	// 指定用于访问 OpenAI 兼容模型的自定义 URL。
	"gitlens.ai.openaicompatible.url": null,

	// 提供在代理中打开选项时 Start Work / Start PR Review 的默认路由：`ask` 显示是手动执行还是使用代理的选择器；`manual` 跳过选择并手动继续；`agent` 跳过选择并打开代理选择器（如果设置了持久化的 `gitlens.ai.defaultAgent`，则使用该代理）。
	//  - ask: 每次询问（默认）
	//  - manual: 始终手动继续
	//  - agent: 始终在代理中打开
	//  - kepler: Always open in Kepler, when Kepler supports the item
	"gitlens.ai.openInAgent": "ask",

	// 指定在解决合并或变基冲突时提供给 AI 提供方的自定义指令。适用于 AI 解决的每个冲突——无论是 _提交图_ 的 **Resolve** 面板中，还是自动变基期间。在 **Resolve** 面板中针对单次运行给出的指导优先于此设置。
	"gitlens.ai.resolveConflicts.customInstructions": null,

	// 指定在审查一组更改时提供给 AI 提供方的自定义指令
	"gitlens.ai.reviewChanges.customInstructions": null,

	// 指定用于 GitLens AI 功能的 VS Code 提供的模型，格式为 `provider:model`
	"gitlens.ai.vscode.model": null,

	// 时间线
	// 控制在滚动到列表结尾时，日程表视图是否将加载下一页的项目。
	"timeline.pageOnScroll": true,

	// 默认情况下以及在加载更多项目时在日程表视图中显示的项目数。如果设置为 "null"，则将根据日程表视图的可见区域自动选择一个页面大小。
	"timeline.pageSize": 50,

	// 日期和时间
	// 指定默认的绝对日期格式。有关支持的格式，请参阅 [Moment.js 文档](https://momentjs.com/docs/#/displaying/format/)
	"gitlens.defaultDateFormat": null,

	// 指定用于日期格式的区域设置（[BCP 47 语言标记](https://en.wikipedia.org/wiki/IETF_language_tag#List_of_major_primary_language_subtags)），默认为 VS Code 的区域设置。使用 `system` 跟随当前系统区域设置，或选择特定区域设置，例如 `en-US` — 美式英语、`en-GB` — 英式英语、`de-DE` — 德语、`ja-JP` = 日语等。
	"gitlens.defaultDateLocale": null,

	// 指定默认的短绝对日期格式。有关支持的格式，请参阅 [Moment.js 文档](https://momentjs.com/docs/#/displaying/format/)
	"gitlens.defaultDateShortFormat": null,

	// 指定提交日期应使用编写日期还是提交日期
	//  - authored: 使用更改被编写（即最初撰写）时的日期
	//  - committed: 使用更改被提交时的日期
	"gitlens.defaultDateSource": "authored",

	// 指定默认的日期显示方式
	//  - relative: 例如 1 天前
	//  - absolute: 例如 July 25th, 2018 7:18pm
	"gitlens.defaultDateStyle": "relative",

	// 指定默认的时间格式。有关支持的格式，请参阅 [Moment.js 文档](https://momentjs.com/docs/#/displaying/format/)
	"gitlens.defaultTimeFormat": null,

	// 排序
	// 指定分支在快速选择菜单和视图中的排序方式
	//  - date:desc: 按最近的提交日期降序排列分支
	//  - date:asc: 按最近的提交日期升序排列分支
	//  - name:asc: 按名称升序排列分支
	//  - name:desc: 按名称降序排列分支
	"gitlens.sortBranchesBy": "date:desc",

	// 指定贡献者在快速选择菜单和视图中的排序方式
	//  - count:desc: 按提交数量降序排列贡献者
	//  - count:asc: 按提交数量升序排列贡献者
	//  - date:desc: 按最近的提交日期降序排列贡献者
	//  - date:asc: 按最近的提交日期升序排列贡献者
	//  - name:asc: 按名称升序排列贡献者
	//  - name:desc: 按名称降序排列贡献者
	"gitlens.sortContributorsBy": "count:desc",

	// 指定仓库在快速选择菜单和视图中的排序方式
	//  - discovered: 按发现或工作区顺序排列仓库
	//  - lastFetched:desc: 按上次提取日期降序排列仓库
	//  - lastFetched:asc: 按上次提取日期升序排列仓库
	//  - name:asc: 按名称升序排列仓库
	//  - name:desc: 按名称降序排列仓库
	"gitlens.sortRepositoriesBy": "discovered",

	// 指定标签在快速选择菜单和视图中的排序方式
	//  - date:desc: 按日期降序排列标签
	//  - date:asc: 按日期升序排列标签
	//  - name:asc: 按名称升序排列标签
	//  - name:desc: 按名称降序排列标签
	"gitlens.sortTagsBy": "date:desc",

	// 指定 _提交图_ 的工作树更改（WIP）详细信息中工作（未提交）更改的排序方式
	//  - stage: 按暂存状态排列工作树更改——先已暂存，再混合，后未暂存——每个暂存状态内按 `scm.defaultViewSortKey` 设置排序
	//  - flat: 按 `scm.defaultViewSortKey` 设置排列工作树更改
	"gitlens.sortWorkingChangesBy": "stage",

	// 指定工作树在快速选择菜单和视图中的排序方式
	//  - date:desc: 按最近的提交日期降序排列工作树
	//  - date:asc: 按最近的提交日期升序排列工作树
	//  - name:asc: 按名称升序排列工作树
	//  - name:desc: 按名称降序排列工作树
	"gitlens.sortWorktreesBy": "date:desc",

	// 菜单和工具栏
	// 指定哪些命令将添加到哪些菜单
	"gitlens.menus": {
		"editor": {
			"blame": true,
			"clipboard": true,
			"compare": true,
			"history": true,
			"remote": true
		},
		"editorGroup": {
			"blame": true,
			"compare": true
		},
		"editorGutter": {
			"compare": true,
			"remote": true,
			"share": true
		},
		"editorTab": {
			"clipboard": true,
			"compare": true,
			"history": true,
			"remote": true
		},
		"explorer": {
			"clipboard": true,
			"compare": true,
			"history": true,
			"remote": true
		},
		"ghpr": {
			"worktree": true
		},
		"scm": {
			"graph": true,
			"visualHistory": true
		},
		"scmRepositoryInline": {
			"generateCommitMessage": true,
			"graph": true,
			"stash": true
		},
		"scmRepository": {
			"authors": true,
			"generateCommitMessage": true,
			"graph": true,
			"patch": true,
			"visualHistory": true
		},
		"scmGroupInline": {
			"stash": true
		},
		"scmGroup": {
			"compare": true,
			"openClose": true,
			"patch": true,
			"stash": true
		},
		"scmItemInline": {
			"stash": false
		},
		"scmItem": {
			"clipboard": true,
			"compare": true,
			"history": true,
			"patch": true,
			"remote": true,
			"share": true,
			"stash": true
		}
	},

	// 键盘快捷键
	// 指定用于 GitLens 快捷键的键位映射
	//  - alternate: 添加一组以 `Alt` 开头（macOS 上为 ⌥）的备用快捷键
	//  - chorded: 添加一组以 `Ctrl+Shift+G` 开头（macOS 上为 `⌥⌘G`）的组合快捷键
	//  - none: 不添加任何快捷键
	"gitlens.keymap": "chorded",

	// 提交签名
	// 指定是否启用从 GitLens 内部生成签名密钥的功能
	"gitlens.signing.enableKeyGeneration": true,

	// 指定是否在提交图和其他视图中的提交上显示签名验证徽章
	"gitlens.signing.showSignatureBadges": true,

	// 模式
	// 指定活动的 GitLens 模式（如有）
	"gitlens.mode.active": "",

	// 指定状态栏中活动 GitLens 模式的对齐方式
	//  - left: 左对齐
	//  - right: 右对齐
	"gitlens.mode.statusBar.alignment": "right",

	// 指定是否在状态栏中提供活动的 GitLens 模式
	"gitlens.mode.statusBar.enabled": true,

	// 指定用户定义的 GitLens 模式
	"gitlens.modes": {
		"zen": {
			"name": "Zen",
			"statusBarItemName": "Zen",
			"description": "for a zen-like experience, disables many visual features",
			"codeLens": false,
			"currentLine": false,
			"hovers": false,
			"statusBar": false
		},
		"review": {
			"name": "Review",
			"statusBarItemName": "Reviewing",
			"description": "for reviewing code, enables many visual features",
			"codeLens": true,
			"currentLine": true,
			"hovers": true
		}
	},

	// GitKraken
	// 指定用户在 GitLens 中活动的 GitKraken 组织 ID
	"gitlens.gitkraken.activeOrganizationId": "",

	// 高级
	// 指定缩略提交 SHA 的长度
	"gitlens.advanced.abbreviatedShaLength": 7,

	// 指定将完整还是缩略的提交 SHA 复制到剪贴板。缩略为 `gitlens.advanced.abbreviatedShaLength` 指定的长度。
	"gitlens.advanced.abbreviateShaOnCopy": false,

	// 指定传递给 `git blame` 命令的附加参数
	"gitlens.advanced.blame.customArguments": null,

	// 指定是否（按工作区）缓存 GitLens 所使用的 Git 可执行文件路径
	"gitlens.advanced.caching.gitPath": true,

	// 指定提交的显示顺序。未指定时，提交将按时间倒序显示
	//  - null: 按时间倒序显示提交
	//  - date: 按提交时间戳的时间倒序显示提交
	//  - author-date: 按作者时间戳的时间倒序显示提交
	//  - topo: 按提交时间戳的时间倒序显示提交，但避免混合多条历史记录
	"gitlens.advanced.commitOrdering": null,

	// 指定是否延迟加载提交的文件详细信息，直到其显示时才加载。延迟可使大型历史记录打开得更快，但每次显示提交的文件时都会增加一次 Git 调用。使用 `null` 让 GitLens 仅在加载文件详细信息较慢的仓库中延迟（需要 `gitlens.gitOptimizations.enabled`）
	"gitlens.advanced.commits.delayLoadingFileDetails": null,

	// 指定比较文件时使用的可选外部差异工具。必须是已配置的 [Git difftool](https://git-scm.com/docs/git-config#Documentation/git-config.txt-difftool)。
	"gitlens.advanced.externalDiffTool": null,

	// 指定比较目录时使用的可选外部差异工具。必须是已配置的 [Git difftool](https://git-scm.com/docs/git-config#Documentation/git-config.txt-difftool)。
	"gitlens.advanced.externalDirectoryDiffTool": null,

	// 指定可并发运行的后台 Git 进程的最大数量。如果在大型仓库中遇到系统变慢，请减小此值
	"gitlens.advanced.git.maxConcurrentProcesses": 20,

	// 指定 Git 命令的超时时间（秒）。使用 0 可禁用超时。某些长时间运行的操作（如合并、变基和还原）始终禁用超时
	"gitlens.advanced.git.timeout": 60,

	// 指定列表中显示的最大条目数。使用 0 表示不设上限
	"gitlens.advanced.maxListItems": 200,

	// 指定搜索结果显示的最大条目数。使用 0 表示不设上限
	"gitlens.advanced.maxSearchItems": 200,

	// 指定应抑制哪些消息
	"gitlens.advanced.messages": {
		"suppressBitbucketPRCommitLinksAppNotInstalledWarning": false,
		"suppressCommitHasNoPreviousCommitWarning": false,
		"suppressCommitNotFoundWarning": false,
		"suppressCreatePullRequestPrompt": false,
		"suppressDebugLoggingWarning": false,
		"suppressFileNotUnderSourceControlWarning": false,
		"suppressGitDisabledWarning": false,
		"suppressGitMissingWarning": false,
		"suppressGitVersionWarning": false,
		"suppressLineUncommittedWarning": false,
		"suppressNoRepositoryWarning": false,
		"suppressRebaseSwitchToTextWarning": false,
		"suppressIntegrationDisconnectedTooManyFailedRequestsWarning": false,
		"suppressIntegrationRequestFailed500Warning": false,
		"suppressIntegrationRequestTimedOutWarning": false,
		"suppressBlameInvalidIgnoreRevsFileWarning": false,
		"suppressBlameInvalidIgnoreRevsFileBadRevisionWarning": false
	},

	// 指定是否在失去焦点时关闭快速选择菜单（否则，按 `ESC` 关闭）
	"gitlens.advanced.quickPick.closeOnFocusOut": true,

	// 指定 GitLens 是否应自动扫描工作区文件夹以发现 Git 仓库。禁用后，GitLens 完全依赖 VS Code 内置的 SCM 来获知仓库的打开和关闭。
	"gitlens.advanced.repositorySearch.enabled": true,

	// 指定搜索仓库时向下遍历的文件夹层数。默认为 `git.repositoryScanMaxDepth`
	"gitlens.advanced.repositorySearchDepth": null,

	// 指定在为 Git 操作确定文件路径时是否解析符号链接
	"gitlens.advanced.resolveSymlinks": false,

	// 指定删除与新增的文件对被视为重命名所需的相似度（百分比）
	"gitlens.advanced.similarityThreshold": null,

	// 指定是否跳过引导体验，例如欢迎视图和演练。对于容器或沙箱等临时环境很有用
	"gitlens.advanced.skipOnboarding": false,

	// 指定追溯操作期间比较修订时是否忽略空白
	"gitlens.blame.ignoreWhitespace": false,

	// 指定调试模式
	"gitlens.debug": false,

	// 指定是否使用环境值或指定值覆盖默认的深层链接方案（vscode://）
	"gitlens.deepLinks.schemeOverride": false,

	// 指定打开文件时是否尝试检测嵌套仓库
	"gitlens.detectNestedRepositories": false,

	// 指定当 VS Code 处于打开状态时，GitLens 是否会在后台自动应用安全的、仓库本地的 Git 性能优化（松散对象打包、增量重打包和 commit-graph）。这与 Git 在 `git gc`/`git maintenance` 期间执行的常规工作相同：打包和重打包会重新组织仓库中已有的对象而不改变历史，而 commit-graph 是一个纯加速缓存，可随时删除。更具侵入性的优化（untracked cache、FSMonitor、系统计划维护、`feature.manyFiles`）绝不会自动应用
	"gitlens.gitOptimizations.enabled": true,

	// 指定是否允许 GitLens 发送产品使用情况遥测数据。
	// 
	// _**注意：** 要让 GitLens 发送任何遥测数据，必须同时启用此设置和 VS Code 遥测。任一被禁用则不会发送任何遥测数据。_
	"gitlens.telemetry.enabled": true,

	// 默认语言配置替代
	// 配置要为 ansible, azure-pipelines, css, dockerfile, dockercompose, html, json, jsonc, less, postcss, scss, stylus, vue, yaml 替代的设置。
	"[ansible][azure-pipelines][css][dockerfile][dockercompose][html][json][jsonc][less][postcss][scss][stylus][vue][yaml]":  {
		"gitlens.codeLens.scopes": [
				"document"
		]
	},

	// 配置要为 chatagent 替代的设置。
	"[chatagent]":  {
		"editor.insertSpaces": true,
		"editor.tabSize": 2,
		"editor.autoIndent": "advanced",
		"editor.unicodeHighlight.ambiguousCharacters": false,
		"editor.unicodeHighlight.invisibleCharacters": false,
		"diffEditor.ignoreTrimWhitespace": false,
		"editor.wordWrap": "on",
		"editor.quickSuggestions": {
				"comments": "off",
				"strings": "on",
				"other": "on"
		},
		"editor.wordBasedSuggestions": "off"
	},

	// 配置要为 clojure 替代的设置。
	"[clojure]":  {
		"diffEditor.ignoreTrimWhitespace": false
	},

	// 配置要为 coffeescript 替代的设置。
	"[coffeescript]":  {
		"diffEditor.ignoreTrimWhitespace": false,
		"editor.defaultColorDecorators": "never"
	},

	// 配置要为 csharp 替代的设置。
	"[csharp]":  {
		"editor.maxTokenizationLineLength": 2500
	},

	// 配置要为 css 替代的设置。
	"[css]":  {
		"editor.suggest.insertMode": "replace"
	},

	// 配置要为 dockercompose 替代的设置。
	"[dockercompose]":  {
		"editor.insertSpaces": true,
		"editor.tabSize": 2,
		"editor.autoIndent": "advanced"
	},

	// 配置要为 dockerfile 替代的设置。
	"[dockerfile]":  {
		"editor.quickSuggestions": {
				"strings": true
		}
	},

	// 配置要为 fsharp 替代的设置。
	"[fsharp]":  {
		"diffEditor.ignoreTrimWhitespace": false
	},

	// 配置要为 go 替代的设置。
	"[go]":  {
		"editor.insertSpaces": false
	},

	// 配置要为 handlebars 替代的设置。
	"[handlebars]":  {
		"editor.suggest.insertMode": "replace"
	},

	// 配置要为 html 替代的设置。
	"[html]":  {
		"editor.suggest.insertMode": "replace"
	},

	// 配置要为 instructions 替代的设置。
	"[instructions]":  {
		"editor.insertSpaces": true,
		"editor.tabSize": 2,
		"editor.autoIndent": "advanced",
		"editor.unicodeHighlight.ambiguousCharacters": false,
		"editor.unicodeHighlight.invisibleCharacters": false,
		"diffEditor.ignoreTrimWhitespace": false,
		"editor.wordWrap": "on",
		"editor.quickSuggestions": {
				"comments": "off",
				"strings": "on",
				"other": "on"
		},
		"editor.wordBasedSuggestions": "off"
	},

	// 配置要为 jade 替代的设置。
	"[jade]":  {
		"diffEditor.ignoreTrimWhitespace": false
	},

	// 配置要为 javascript 替代的设置。
	"[javascript]":  {
		"editor.maxTokenizationLineLength": 2500
	},

	// 配置要为 json 替代的设置。
	"[json]":  {
		"editor.quickSuggestions": {
				"strings": true
		},
		"editor.suggest.insertMode": "replace"
	},

	// 配置要为 jsonc 替代的设置。
	"[jsonc]":  {
		"editor.quickSuggestions": {
				"strings": true
		},
		"editor.suggest.insertMode": "replace"
	},

	// 配置要为 julia 替代的设置。
	"[julia]":  {
		"editor.defaultColorDecorators": "never"
	},

	// 配置要为 less 替代的设置。
	"[less]":  {
		"editor.suggest.insertMode": "replace"
	},

	// 配置要为 makefile 替代的设置。
	"[makefile]":  {
		"editor.insertSpaces": false
	},

	// 配置要为 markdown 替代的设置。
	"[markdown]":  {
		"editor.unicodeHighlight.ambiguousCharacters": false,
		"editor.unicodeHighlight.invisibleCharacters": false,
		"diffEditor.ignoreTrimWhitespace": false,
		"editor.wordWrap": "on",
		"editor.quickSuggestions": {
				"comments": "off",
				"strings": "off",
				"other": "off"
		}
	},

	// 配置要为 plaintext 替代的设置。
	"[plaintext]":  {
		"editor.unicodeHighlight.ambiguousCharacters": false,
		"editor.unicodeHighlight.invisibleCharacters": false
	},

	// 配置要为 prompt 替代的设置。
	"[prompt]":  {
		"editor.insertSpaces": true,
		"editor.tabSize": 2,
		"editor.autoIndent": "advanced",
		"editor.unicodeHighlight.ambiguousCharacters": false,
		"editor.unicodeHighlight.invisibleCharacters": false,
		"diffEditor.ignoreTrimWhitespace": false,
		"editor.wordWrap": "on",
		"editor.quickSuggestions": {
				"comments": "off",
				"strings": "on",
				"other": "on"
		},
		"editor.wordBasedSuggestions": "off"
	},

	// 配置要为 python 替代的设置。
	"[python]":  {
		"diffEditor.ignoreTrimWhitespace": false,
		"editor.defaultColorDecorators": "never",
		"gitlens.codeLens.symbolScopes": [
				"!Module"
		]
	},

	// 配置要为 ruby 替代的设置。
	"[ruby]":  {
		"editor.defaultColorDecorators": "never"
	},

	// 配置要为 scss 替代的设置。
	"[scss]":  {
		"editor.suggest.insertMode": "replace"
	},

	// 配置要为 search-result 替代的设置。
	"[search-result]":  {
		"editor.lineNumbers": "off"
	},

	// 配置要为 shellscript 替代的设置。
	"[shellscript]":  {
		"files.eol": "\n",
		"editor.defaultColorDecorators": "never"
	},

	// 配置要为 skill 替代的设置。
	"[skill]":  {
		"editor.insertSpaces": true,
		"editor.tabSize": 2,
		"editor.autoIndent": "advanced",
		"editor.unicodeHighlight.ambiguousCharacters": false,
		"editor.unicodeHighlight.invisibleCharacters": false,
		"diffEditor.ignoreTrimWhitespace": false,
		"editor.wordWrap": "on",
		"editor.quickSuggestions": {
				"comments": "off",
				"strings": "on",
				"other": "on"
		},
		"editor.wordBasedSuggestions": "off"
	},

	// 配置要为 snippets 替代的设置。
	"[snippets]":  {
		"editor.quickSuggestions": {
				"strings": true
		},
		"editor.suggest.insertMode": "replace"
	},

	// 配置要为 xaml 替代的设置。
	"[xaml]":  {
		"editor.wordBasedSuggestions": "off"
	},

	// 配置要为 yaml 替代的设置。
	"[yaml]":  {
		"editor.insertSpaces": true,
		"editor.tabSize": 2,
		"editor.autoIndent": "advanced",
		"diffEditor.ignoreTrimWhitespace": false,
		"editor.defaultColorDecorators": "never",
		"editor.quickSuggestions": {
				"strings": "on"
		}
	},

	// 启用/禁用重命名之前预览更改的功能
	"editor.rename.enablePreview": true,

	// 从当前所选颜色主题重写编辑器语义标记颜色和样式。
	"editor.semanticTokenColorCustomizations": {},

	// 替代当前所选颜色主题中的编辑器语法颜色和字形。
	"editor.tokenColorCustomizations": {},

	// 控制选择文本时是否显示内联聊天提示。
	//  - off: 未显示任何提示。
	//  - editor: 在光标位置的编辑器中显示提示。
	"inlineChat.affordance": "off",

	// 控制聊天编辑会话中的文件是否使用“在聊天中提问”而不是“内联聊天”。
	"inlineChat.askInChat": true,

	// 控制是否在编辑器中为诊断显示“修复”操作。
	"inlineChat.fixDiagnostics": true,

	// 从笔记本中的内联聊天小组件启用类似智能体的行为。
	"inlineChat.notebookAgent": false,

	// 聊天智能体主机
	// When enabled, new editor and panel chat sessions default to the Agent Host Copilot SDK instead of the local harness.
	"chat.defaultToCopilotHarness": false,

	// When enabled, shows the VS Code local chat harness in the chat picker. This setting is ignored in virtual workspaces, where the local chat harness is always available.
	"chat.editor.localAgent.enabled": true,

	// When enabled, uses the Agent Host Copilot SDK whenever the local harness would otherwise be selected for a new editor chat session. Claude and Codex selections are unaffected.
	"chat.editor.preferCopilotHarness": false,

	// Override the Agents window support of an extension. Set an extension to `true` to enable it even when it would otherwise be disabled, or to `false` to disable it even when it is supported by default. This does not affect editor windows. Reload the Agents window to apply changes.
	"extensions.supportAgentsWindow": {},

	// 聊天智能体主机启动程序
	// Controls per-session limits, over a sliding one-hour window, on sessions and chats created and messages sent, and the depth of recursive session spawning, by Agent Host session tools. Confirmation requirements and input validation are unchanged.
	//  - on: Enforce the limits.
	//  - off: Do not enforce the limits.
	"chat.agentHost.agentOrchestrationLimits": "on",

	// When enabled, captures AHP transport messages once: in the window for local and remote connections, or on the host for Mission Control connections. Enabled by default only in Insiders. Each logging process stops capture after writing 500 MiB across all connections, including reconnects. Existing per-connection rotation still applies. Restart the window or host process to reset its budget. Mission Control host capture follows the host's owning window setting, including live changes.
	"chat.agentHost.ahpJsonlLoggingEnabled": false,

	// When enabled, extension-provided BYOK ('bring your own key') models can run in agent-host sessions. Changes are synchronized to the running agent host and do not require a restart.
	"chat.agentHost.byokModels.enabled": true,

	// When enabled, the agent host registers the Claude provider, subject to the Claude SDK being reachable. The agent host process must be restarted for changes to take effect.
	"chat.agentHost.claudeAgent.enabled": true,

	// When enabled, the agent host registers the Codex provider (subject to the Codex SDK being reachable). Enabling takes effect without restarting the agent host.
	"chat.agentHost.codexAgent.enabled": true,

	// When enabled, local Copilot agent sessions on macOS and Windows offer GitHub's Computer Use plugin, which can operate desktop applications. The plugin is downloaded on first use. Turn it on with `/computer on` in a Copilot chat, or when the agent asks. Each application still requires your approval. Changes take effect after a restart.
	"chat.agentHost.computerUse.enabled": false,

	// Controls whether the Agent Host automatically discovers and associates a pull request for the currently checked-out branch. When disabled, only pull requests recorded by the agent as artifacts or explicitly selected or created through session actions are considered.
	"chat.agentHost.experimental.autoAttachPullRequests": false,

	// When enabled, agents receive guidance for using rich links to issues, pull requests, commits, sessions, and chats, plus running task markers, when creating or editing Markdown plan documents.
	"chat.agentHost.experimental.markdownPlanRichLinks": false,

	// When enabled and tool search is available, agent-host sessions offer routing tools for configured MCP servers and Connectors, using server names and cached MCP tool metadata to discover relevant servers. Selecting a routing tool can request authentication and waits for the server's current tools. Connector-owned servers do not show proactive sign-in hints when this setting is enabled. Other servers without routing tools retain proactive sign-in hints. Newly created sessions pick up changes to this setting.
	"chat.agentHost.experimental.mcpToolRouting": false,

	// When enabled, agents prepare their session for a new turn, such as starting the runtime session, while the turn-start checkpoint is captured instead of after it. This can shorten the time to the first response, especially on the first turn of a session.
	"chat.agentHost.experimental.overlapProviderPreparation": true,

	// When enabled, new Agent Host Copilot chats start their runtime and MCP servers before the first message is sent, so connectors are ready sooner. Changes apply to new chats.
	"chat.agentHost.experimental.prewarmSessions": true,

	// Controls how new sessions and chats get an automatic title. Changes apply to new sessions; existing sessions and their chats retain their strategy.
	//  - utility: A utility model generates titles immediately.
	//  - activeAgent: The active agent names new sessions and chats using rename tools.
	//  - agentReview: Seed titles immediately and refine them in the background if the first response turn completes successfully. On later turns, remind the active agent that it may rename a chat when the generated title is inaccurate or no longer reflects the user's goal.
	"chat.agentHost.experimental.titleGeneration": "utility",

	// When enabled, agent-host sessions include the GitHub MCP server.
	"chat.agentHost.githubMcpServer.enabled": true,

	// Enables moving chats between Agent Host sessions and into new sessions.
	"chat.agentHost.moveChats.enabled": false,

	// Enables chats in one Agent Host session to use different agents.
	"chat.agentHost.multipleChatProviders.enabled": false,

	// 启用后，将提示和响应内容包含在 OTel 跨度属性中。仅可在用户设置中配置。设置 `OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT`。隐私敏感: 请勿在将跨度发送到共享接收器的环境中启用。
	"chat.agentHost.otel.captureContent": false,

	// 启用后，智能体主机将每个发出的 OTel 跨度持久化到本地 SQLite 数据库。仅可在用户设置中配置。可通过 `Export Agent Host Traces Database` 命令查看跨度。与外部导出器兼容: 跨度写入 SQLite *并*转发到用户配置的接收器。
	"chat.agentHost.otel.dbSpanExporter.enabled": false,

	// When enabled, the agent host emits OpenTelemetry traces from the Copilot SDK. Configurable in user settings only. Either configure `chat.agentHost.otel.otlpEndpoint` to ship traces to an external collector or enable `chat.agentHost.otel.dbSpanExporter.enabled` to capture them locally.
	"chat.agentHost.otel.enabled": false,

	// 开启 `chat.agentHost.otel.enabled` 时，Copilot SDK 使用的导出程序后端。仅可在用户设置中配置。`otlp-grpc` 会在 CLI 运行时以透明方式降级为 `otlp-http`。
	"chat.agentHost.otel.exporterType": "otlp-http",

	// 导出程序类型为 `otlp-http` 或 `otlp-grpc` 时的 OTLP 终结点 URL。仅可在用户设置中配置。在智能体主机进程内设置 `OTEL_EXPORTER_OTLP_ENDPOINT`。
	"chat.agentHost.otel.otlpEndpoint": "",

	// 导出程序类型为 `file` 时跨度 JSON 行的输出路径。仅可在用户设置中配置。设置 `COPILOT_OTEL_FILE_EXPORTER_PATH`。
	"chat.agentHost.otel.outfile": "",

	// When enabled, Copilot sessions automatically discover and use the operating system's proxy configuration when no proxy environment variable is set.
	"chat.agentHost.systemProxy.enabled": true,

	// Controls whether enabled Agent Merge sessions address unresolved review threads, changes-requested reviews, and new pull request comments from repository maintainers or the Copilot pull request reviewer.
	"chat.agentMerge.addressReviews": true,

	// Enables the experimental Agent Merge controller and its commands. Agent Merge can monitor an agent session's pull request, ask the agent to address selected blockers, and optionally merge the pull request when it is ready.
	"chat.agentMerge.enabled": false,

	// Controls whether enabled Agent Merge sessions ask the agent to fix failed required CI checks.
	"chat.agentMerge.fixCI": true,

	// Controls the native merge method used by Agent Merge.
	//  - auto: Uses the first repository-compatible method in this order: squash, merge commit, rebase.
	//  - squash: Uses squash merge when the repository permits it.
	//  - merge: Uses a merge commit when the repository permits it.
	//  - rebase: Uses rebase merge when the repository permits it.
	"chat.agentMerge.mergeMethod": "auto",

	// Controls whether the Agent Host automatically merges or enqueues pull requests for enabled Agent Merge sessions after all selected maintenance work is complete.
	//  - always: Merges the pull request whenever it is ready, including after Agent Merge has fixed CI failures or addressed review feedback.
	//  - ifUnchanged: Merges the pull request only while Agent Merge has not changed it. Once a repair turn lands a commit, automatic merging turns itself off for that session so the changes can be reviewed.
	//  - never: Never merges the pull request automatically.
	"chat.agentMerge.mergePullRequest": "never",

	// Controls whether review-thread replies posted by Agent Merge include an automated-reply attribution note.
	"chat.agentMerge.replyAttribution": true,

	// Controls whether enabled Agent Merge sessions ask the agent to update branches that are behind or resolve merge conflicts.
	"chat.agentMerge.resolveConflicts": true,

	// Enables live state, actions, and opt-in Autopilot for recorded artifacts, including extension integrations. While enabled, Agent Merge is unavailable regardless of `chat.agentMerge.enabled`. Switching stops the previous system's automation without clearing saved choices or history. Previously enabled rules can resume when switching back. This does not enable new Autopilot rules or change ordinary artifact recording (`chat.artifactTools.enabled`).
	"chat.artifactIntegrations.enabled": false,

	// Check names that do not need to pass before a draft pull request counts as ready for review: before **Automatically Mark Ready** runs for a pull request artifact, and before Agent Merge offers **Mark Ready**. Matching is case-sensitive; `*` matches any text, and other characters are literal. These checks remain visible, are still repaired when required, and must still pass for automatic merging. This setting does not enable automation.
	"chat.artifactIntegrations.githubPullRequests.autoMarkReadyIgnoredChecks": [],

	// When enabled, agents can record artifacts — pull requests, issues, commits, websites, files and other resources — which are surfaced above the chat input.
	"chat.artifactTools.enabled": true,

	// Controls whether Agent Host Copilot sessions can open Canvases with interactive content in the Agents Window and the Editor Window. Sessions on remote agent hosts also require `workbench.browser.enableRemoteProxy`, so canvas pages load through the agent host's network. Newly created sessions pick up changes to this setting.
	"chat.canvases.enabled": true,

	// When enabled, the first turn of a new Copilot agent host chat includes a bounded file-name snapshot of its working directories, so the agent can orient itself without listing the workspace first. File contents are never included.
	"chat.experimental.workspaceSnapshot": true,

	// After a session with a merged pull request is automatically marked Done, wait this many additional days, then permanently delete the session. Eligible retained worktrees are safely removed first. Set to 0 to disable permanent deletion.
	"chat.agentSessions.autoDeleteMarkedAsDoneMergedSessionsAfterDays": 0,

	// After a session with a merged pull request has been inactive for this many days, mark it as Done. Eligible worktrees are safely removed. Set to 0 to disable automatic marking.
	"chat.agentSessions.autoMarkAsDoneMergedSessionsAfterDays": 0,

	// Controls whether the current prompt is pinned to the top of the chat transcript while scrolling.
	"chat.stickyScroll.enabled": true,

	// Controls whether the Agent picker appears in Add Context for chat inputs in the editor and Agents windows when the default agent is selected. While a non-default agent is selected, the picker appears in its usual position.
	"sessions.chat.experimental.agentsPickerInAttachContextMenu": true,

	// Multi Diff Editor
	// Controls whether newly created multi diff editors support a list of the changed files alongside the diffs. Reload the window to apply this change to existing editors.
	"multiDiffEditor.experimental.fileList": false,

	// Controls the experimental variant of the multi diff editor.
	//  - cards: Use the compact card-based variant.
	//  - noCards: Use the compact variant without cards.
	"multiDiffEditor.experimental.variant": "noCards",

	// Controls how the prompt timeline is displayed next to the chat transcript in the Agents window.
	//  - off: Do not show the prompt timeline.
	//  - ruler: Show an overview ruler beside the transcript scrollbar that fans into prompt pills on engagement.
	//  - gutter: Show a minimal handle in the transcript's left gutter that opens a list of prompts on hover.
	"sessions.chatTimeline.display": "gutter",

	// 聊天
	// 应用编辑时，在代码块药丸形状中显示进度动画。如果禁用，则改为显示进度百分比。
	"chat.agent.codeBlockProgress": true,

	// Controls whether completed chat responses collapse intermediate work while keeping the final response visible.
	"chat.agent.collapseCompletedResponses": true,

	// 启用后，可以从聊天中激活智能体模式，并且可以使用智能体上下文中带有副作用的工具。
	"chat.agent.enabled": true,

	// 使用智能体时每轮次允许的最大请求数。达到限制后，将要求确认以继续。
	"chat.agent.maxRequests": 50,

	// 启用后，智能体工具(提取工具、集成浏览器)的网络访问将根据 `chat.agent.sandbox.network.allowedDomains` 和 `chat.agent.sandbox.network.deniedDomains` 进行限制。启用 `chat.agent.sandbox.enabled` 时，域筛选也会应用于这些工具。
	"chat.agent.networkFilter": false,

	// Allowed domains for network access by agent tools (fetch tool, integrated browser) when `chat.agent.networkFilter` is enabled. In Copilot Agent Host sessions with sandboxing (`chat.agent.sandbox.enabled`) enabled, also restricts the integrated browser when outbound network access (`chat.agent.sandbox.network.allowNetwork`) is allowed; an empty allow list adds no sandbox restriction. This list does not enable outbound access. Supports wildcards like `*.example.com`. Outside sandboxing, when both allowed and denied lists are empty, all domains are blocked. Denied domains (see `chat.agent.sandbox.network.deniedDomains`) take precedence.
	// 
	// Changes may not take full effect until VS Code is restarted.
	"chat.agent.sandbox.network.allowedDomains": [],

	// Denied domains for network access by agent tools (fetch tool, integrated browser) when `chat.agent.networkFilter` is enabled. Also applies to the integrated browser in sandboxed Copilot Agent Host sessions (`chat.agent.sandbox.enabled`); allowing outbound network access (`chat.agent.sandbox.network.allowNetwork`) does not bypass this list. Takes precedence over `chat.agent.sandbox.network.allowedDomains`. Supports wildcards like `*.example.com`.
	// 
	// Changes may not take full effect until VS Code is restarted.
	"chat.agent.sandbox.network.deniedDomains": [],

	// This setting will be deprecated in a future release. Use `chat.persistentProgress` and `chat.persistentProgressVerbosity` to control thinking and progress presentation instead.
	// Controls how tool calls are displayed in relation to thinking sections.
	//  - off: Tool calls are shown separately, not collapsed into thinking.
	//  - withThinking: Tool calls are collapsed into thinking sections when thinking is present.
	//  - always: Tool calls are always collapsed, even without thinking.
	"chat.agent.thinking.collapsedTools": "always",

	// Generate a summary only when a live thinking section finishes with its header in view. A single extracted reasoning heading is used directly without a model request; multiple headings are used as summary input. Opening a chat, returning to it, scrolling or expanding existing sections never generates titles. Sections that finish off-screen or in background chats keep their existing title or Finished thinking.
	"chat.agent.thinking.generateTitles": true,

	// This setting will be deprecated in a future release. Use `chat.persistentProgress` and `chat.persistentProgressVerbosity` to control thinking and progress presentation instead.
	// Customize the loading messages shown during agent thinking and progress indicators. Use `"mode": "replace"` to use only your phrases, or `"mode": "append"` to add them to the defaults.
	"chat.agent.thinking.phrases": {
		"mode": "append",
		"phrases": []
	},

	// This setting will be deprecated in a future release. Use `chat.persistentProgress` and `chat.persistentProgressVerbosity` to control thinking and progress presentation instead.
	// When enabled, terminal tool calls are displayed inside the thinking dropdown with a simplified view.
	"chat.agent.thinking.terminalTools": true,

	// This setting will be deprecated in a future release. Use `chat.persistentProgress` and `chat.persistentProgressVerbosity` to control thinking and progress presentation instead.
	// Controls how thinking is rendered. Read-only chats always use the collapsed preview style.
	//  - collapsed: Thinking parts will be collapsed by default.
	//  - collapsedPreview: Thinking parts will be expanded first, then collapse once we reach a part that is not thinking.
	//  - fixedScrolling: Show thinking in a fixed-height streaming panel that auto-scrolls; click header to expand to full height.
	"chat.agent.thinkingStyle": "fixedScrolling",

	// Specify location(s) of custom agent files (`*.agent.md`). [Learn More](https://aka.ms/vscode-ghcp-custom-chat-modes).
	// 
	// Relative paths are resolved from the root folder(s) of your workspace.
	// 
	// Locations configured here are only observed by the Local agent harness. Other harnesses running in VS Code receive agents from all additional locations configured here, in addition to their built-in locations. To use agents with independent agent harnesses, such as Copilot CLI, review the [Migrations tab](command:aiCustomization.openManagementEditor?%255B%257B%2522migration%2522%253Atrue%257D%255D "Open the Migrations Tab") in the Agent Customizations editor to migrate them to supported locations.
	"chat.agentFilesLocations": {
		".github/agents": true,
		".claude/agents": true,
		"~/.copilot/agents": true
	},

	// 为智能体主机会话启用智能体调试日志记录: 在智能体调试面板中显示其调试事件。立即生效；仅捕获启用此设置期间运行的会话。
	"chat.agentHost.agentDebugLog.enabled": false,

	// 每个智能体主机会话在内存中为智能体调试面板保留的最大调试事件数。超过此限制的较旧事件会从内存缓冲区中丢弃，这也会降低面板概述中显示的总数(例如令牌使用量)。
	"chat.agentHost.agentDebugLog.maxEventsInMemory": 10000,

	// When enabled, local Copilot Agent Host sessions opt into the Copilot runtime's execution subagent. The runtime's experiment assignments may override this default. When the runtime implementation is available, the extension-native execution tool is excluded from that session. This is independent of `github.copilot.chat.executionSubagent.enabled`, which controls the extension-native implementation. Changing this setting restarts the Copilot runtime after active turns finish.
	"chat.agentHost.copilot.executionSubagent.enabled": false,

	// Default model ID for the Copilot runtime's execution subagent. Empty inherits the parent session model. The runtime's experiment assignments may override this default. This does not affect the extension-native execution subagent's model. An unavailable model disables the runtime execution subagent. Changing this setting restarts the Copilot runtime after active turns finish.
	"chat.agentHost.copilot.executionSubagent.model": "gpt-5.6-luna",

	// Controls whether Copilot Agent Host sessions, such as those in the Agents window, add a `Co-authored-by: Copilot` trailer to the commits they create. Takes effect when a session starts or resumes.
	"chat.agentHost.copilot.includeCoAuthoredBy": true,

	// Per-model capability overrides for Copilot SDK agent sessions, keyed by model id (`*` matches every model; a specific entry wins field-by-field), intended for evaluating models against an existing model's profile. Declare an aliased `family` (for example `claude-opus-4.8`) to route the model to that family's tuned system prompt and tool profile without changing the model id sent to the runtime — so a preview model can be evaluated against a known prompt while still running on its own endpoint — a `reasoningEffort` to pin its effort level, `availableTools`/`excludedTools` to filter its tool set, or `modelCapabilities` to override individual capability limits (e.g. vision support, context window size) passed through to the SDK. All overrides apply when a session launches or resumes. On a mid-session model change, only the new model's `reasoningEffort` is applied; the session keeps its launch-time family, tool filters, and model capabilities. Only affects Copilot agent sessions.
	// 
	// **Note**: This is an advanced setting for experimentation.
	"chat.agentHost.copilot.modelCapabilityOverrides": {},

	// Minimum number of tools before MCP and external tools are deferred behind tool search. Set to 0 to always defer external tools. Only effective when tool search is enabled.
	"chat.agentHost.copilot.toolSearch.deferThreshold": 1,

	// When enabled, Copilot SDK sessions defer MCP and non-core VS Code tools behind a tool-search tool so the model discovers them on demand instead of loading every tool definition up front.
	"chat.agentHost.copilot.toolSearch.enabled": true,

	// Controls the log level for the Copilot SDK runtime used by the local agent host. Changing this setting restarts the Copilot SDK client; active sessions are reloaded when next used.
	//  - info: Log informational messages. Running VS Code with trace logging still enables all Copilot SDK runtime diagnostics.
	//  - trace: Log all Copilot SDK runtime diagnostics.
	"chat.agentHost.copilotSdk.logLevel": "info",

	// 启用后，Copilot SDK 会话使用智能体主机终端工具替代，而非 SDK 的默认终端行为。
	"chat.agentHost.customTerminalTool.enabled": false,

	// The default folder for archives and folders created by the Developer: Export Agent Host Debug Logs command. When empty or unavailable, the default file-dialog location is used.
	"chat.agentHost.debugLogs.defaultExportLocation": "",

	// 启用此选项后，运行 Claude Opus 4.8 模型的 Copilot SDK 会话会在默认系统消息之上应用针对 Opus 4.8 调优的系统提示部分覆盖。
	"chat.agentHost.opus48Prompt.enabled": false,

	// When enabled, Copilot SDK sessions load your shell profile (`~/.bashrc` on macOS and Linux, PowerShell profiles on Windows) and activate the Python environment selected for the workspace before each shell command. Python activation requires the Python Environments extension with `python-envs.terminal.autoActivationType` set to `shellStartup`. Local windows only.
	"chat.agentHost.shellTool.initScript.enabled": false,

	// 控制“智能体状态”指示器在标题栏命令中心中的显示方式。设置为 `hidden` 时，不显示指示器。其他值显示指示器，并自动启用 `window.commandCenter`。未读和正在进行会话指示器要求启用 `chat.viewSessions.enabled`。
	//  - hidden: 智能体状态指示器从标题栏隐藏。
	//  - badge: 将智能体状态显示为命令中心旁边的徽章。
	//  - compact: 将命令中心搜索框替换为压缩智能体状态指示器和统一聊天小组件。
	"chat.agentsControl.enabled": "compact",

	// 控制是否启用智能体会话投影模式以在重点工作区中查看智能体会话。
	"chat.agentSessionProjection.enabled": false,

	// Controls whether legacy extension host Copilot CLI chat sessions are migrated in place to the Agent host when opened, so their history becomes editable. When disabled, legacy sessions open as before.
	// 
	// Changing this setting requires a restart to take effect.
	"chat.agentSessions.migrateLegacyCopilotCli": true,

	// Controls whether opening an agent session, from the sessions list or a session link, shows it in an editor instead of the Chat view. Like opening a file, an editor that already shows the session is revealed, and a session shown in the Chat view moves into an editor.
	"chat.agentSessions.openInEditor": false,

	// Controls which external agent sessions, created outside VS Code's Agent Host, are shown.
	//  - none: Do not show external sessions.
	//  - recent: Show up to the 2 most recent external sessions updated in the last 7 days. At startup, external sessions older than the second-most-recently updated local session are hidden.
	//  - last24Hours: Show external sessions updated in the last 24 hours.
	//  - last7Days: Show external sessions updated in the last 7 days.
	//  - last30Days: Show external sessions updated in the last 30 days.
	"chat.agentSessions.showExternal": "last7Days",

	// Agents Window invitation delays are now controlled independently for each scenario.
	// Controls the delay, in seconds, after the latest user message before offering to continue an in-progress session in the Agents Window. Requires `chat.agentsHandoffTip.mode` to be `default` or `custom`.
	"chat.agentsHandoffTip.delaySeconds": 5,

	// Use chat.agentsWindowBanner.enabled instead.
	// 控制聊天输入位置上方显示的提示，以在智能体窗口中继续符合条件的智能体会话。
	//  - hidden: 永不显示转接提示。
	//  - default: 显示包含默认说明的转接提示。
	//  - custom: 显示包含备用说明的转接提示。
	"chat.agentsHandoffTip.mode": "hidden",

	// Specify location(s) of agent skills (`SKILL.md`) that can be used in Chat Sessions. [Learn More](https://aka.ms/vscode-agent-skills).
	// 
	// Each path should contain skill subfolders with SKILL.md files (e.g., add `my-skills` if you have `my-skills/skillA/SKILL.md`). Relative paths are resolved from the root folder(s) of your workspace.
	// 
	// Locations configured here are only observed by the Local agent harness. Other harnesses running in VS Code receive skills from all additional locations configured here, in addition to their built-in locations. To use skills with independent agent harnesses, such as Copilot CLI, review the [Migrations tab](command:aiCustomization.openManagementEditor?%255B%257B%2522migration%2522%253Atrue%257D%255D "Open the Migrations Tab") in the Agent Customizations editor to migrate them to supported locations.
	"chat.agentSkillsLocations": {
		".agents/skills": true,
		".github/skills": true,
		".claude/skills": true,
		"~/.agents/skills": true,
		"~/.copilot/skills": true,
		"~/.claude/skills": true
	},

	// Use chat.agentsWindowBanner.enabled instead.
	// Show an invitation to work in parallel in the Agents Window when starting a new Agent Host chat while another Agent Host session is running.
	"chat.agentsParallelWorkBanner.enabled": false,

	// Preview one Agents Window invitation per window reload, ignoring experiment enablement, previous dismissals, frequency limits, and Agents Window usage. Activity requirements and delays still apply. Previews do not update invitation history or experiment telemetry.
	"chat.agentsWindowBanner.developerMode": false,

	// Show occasional invitations to continue or manage running Agent Host chats in the Agents Window. Invitations are hidden for users who have created at least three sessions in the Agents Window and created their latest session within the past 30 days.
	"chat.agentsWindowBanner.enabled": false,

	// Open the invited chat when using an Agents Window invitation. When disabled, show the New Session view instead. When `onboarding.enabled` is enabled, highlight the invited session in the sessions list, followed by the New Session button if this setting is enabled.
	"chat.agentsWindowBanner.revealCurrentSession": true,

	// 控制生成工件视图在聊天中是否可用。
	"chat.artifacts.enabled": false,

	// 按文件路径模式从写入的文件中提取工件的规则。将 glob 模式映射到组配置。
	"chat.artifacts.rules.byFilePath": {
		"**/*plan*.md": {
			"groupName": "Plans"
		}
	},

	// 通过内存文件路径模式从内存工具调用中提取工件的规则。将 glob 模式映射到组配置。
	"chat.artifacts.rules.byMemoryFilePath": {
		"**/*plan*.md": {
			"groupName": "Plans"
		}
	},

	// 按 MIME 类型从工具结果中提取工件的规则。将 MIME 类型模式(例如 "image/*")映射到组配置。
	"chat.artifacts.rules.byMimeType": {
		"image/*": {
			"groupName": "Screenshots",
			"onlyShowGroup": true
		}
	},

	// 启用**高级 Autopilot**，这是一个单开关功能，可启用所有高级 Autopilot 行为，让智能体代为处理更多循环。目前，每次 Autopilot 轮次后，一个小型快速模型会评估原始请求是否已完成；如果没有，Autopilot 会根据该评估继续工作，并将其作为下一轮的指导，而不是依赖智能体自行发出完成信号。
	"chat.autopilot.advanced.enabled": false,

	// 告知智能体用户当前不在并让其自行判断，自动跳过问题轮播。这是一个高级设置，可能会因不完整上下文而导致意外选择或操作。
	"chat.autoReply": false,

	// Controls whether the Agents Window shows a tip about using `/btw` to ask side questions.
	"chat.btwTip.enabled": false,

	// 当所选主智能体模型是自带密钥(BYOK)模型时，控制内置实用工具流使用的默认模型。当所选主智能体模型由 GitHub Copilot 提供时，此设置无效。在 `chat.utilityModel` 或 `chat.utilitySmallModel` 中配置的特定模型具有更高优先级。
	//  - none: 不使用默认实用工具模型。
	//  - mainAgent: 使用所选 BYOK 主智能体模型。
	//  - copilot: 使用默认的 GitHub Copilot 实用工具模型。
	"chat.byokUtilityModelDefault": "copilot",

	// 在聊天中启用检查点。使用检查点可以将聊天还原到以前的状态。
	"chat.checkpoints.enabled": true,

	// 控制是否显示聊天检查点文件更改。
	"chat.checkpoints.showFileChanges": false,

	// Controls whether a live model promo is shown on the Copilot icon when Chat is closed. When explicitly set, this overrides the experiment without an experiment lookup. Otherwise, eligible promos use the experiment treatment.
	//  - none: Do not show a promo on the Copilot icon when Chat is closed.
	//  - copilotIconPopup: Show a promo tooltip when hovering or clicking the Copilot status icon while Chat is closed. Viewing the offer clears its indicator; the offer remains available for the current window session. Choosing Try dismisses the offer and its chat banner.
	"chat.closedPromoNotification": "none",

	// 在聊天输入中显示上下文窗口使用情况指示器。
	"chat.contextUsage.enabled": true,

	// When enabled, Copilot Agent Host sessions using a supported Claude model can call the provider-native Advisor tool. Changing this setting restarts the Copilot SDK client after active turns finish.
	"chat.copilot.claudeAdvisor.enabled": false,

	// When enabled, Copilot Agent Host sessions take Auto's tiers from the Copilot service, and those tiers decide how Auto is presented. When they include a Fusion tier the account can run, Auto is presented as Copilot Fusion, with HydraFusion and HydraFusion Max among its tiers. When they include none, Auto is offered with the service's tiers. When the service provides no tiers, Auto, HydraFusion, and HydraFusion Max are offered as separate models. When disabled, Auto and HydraFusion are offered as separate models, with HydraFusion controlled by `chat.copilot.hydraFusion.enabled`. Changing this setting restarts the Copilot runtime after active turns finish.
	"chat.copilot.dynamicAutoTiers.enabled": true,

	// When enabled, local Copilot Agent Host sessions can use the runtime's built-in Explore agent, independently of `chat.copilot.searchSubagent.enabled`. Applies to sessions when they launch or resume. Does not disable custom agents named Explore.
	"chat.copilot.exploreAgent.enabled": true,

	// When enabled, makes the HydraFusion model available to local Copilot Agent Host sessions. Changing this setting restarts the local Copilot runtime.
	//  - true: Make HydraFusion available.
	//  - false: Do not make HydraFusion available.
	//  - v2: Make HydraFusion v2 available, which plans with per-step reasoning effort and a wider set of models.
	//  - multiRoot: Make HydraFusion v2 available and ask the service to keep reusing the previous turn's root model when it fits the next turn's workflow, which improves prompt cache reuse. Also applies to HydraFusion tiers that Auto offers.
	"chat.copilot.hydraFusion.enabled": "multiRoot",

	// Use `chat.copilot.imageGeneration.model` instead.
	// 
	"chat.copilot.imageGeneration.enabled": false,

	// Selects the model Copilot uses to generate and edit images, or turns image generation off. Each model lists its rates. Account access and tool permissions still apply, and choosing **Off** prevents future image tool calls.
	//  - off: Agents cannot generate or edit images.
	//  - gpt-image-2.5-flare: Generate and edit images with **GPT Image 2.5 Flare** when it is available to your account. Prompts and selected images are sent to Flare.
	// 
	// **Preview rates (AI credits per 1 million tokens):**
	// - **Text tokens:** 500 input / 0 output
	// - **Image tokens:** 800 input / 3,000 output
	// 
	// These charges are in addition to the conversation model. Rates may change; these are token rates, not per-image prices.
	"chat.copilot.imageGeneration.model": "gpt-image-2.5-flare",

	// Request a visible "Made with AI" label on images generated or edited by Copilot. Applies to new and existing Copilot sessions without enabling image generation. Labels are generated by the image model and are not guaranteed. Turning this off does not remove existing labels from input images.
	"chat.copilot.imageGeneration.watermark": false,

	// When enabled, offers on-device models to download and run on this device with llama.cpp. Offered only on devices with a GPU that has about 64 GB of memory or more. Changing this setting restarts the local Copilot runtime after active turns finish. Local models may not use the same safety filters as GitHub Copilot-provided models and may be more susceptible to malicious instructions, especially when actions are automatically approved.
	"chat.copilot.localModel.enabled": false,

	// Absolute path to a `llama-server` executable for on-device models. VS Code doesn't install llama.cpp: install a build that supports your model, then set this to its `llama-server`.
	"chat.copilot.localModel.llamaServerPath": "",

	// When enabled, Auto can route turns to the active on-device model, with cloud fallback. Takes effect immediately. Local models may not use the same safety filters as GitHub Copilot-provided models and may be more susceptible to malicious instructions, especially when actions are automatically approved.
	"chat.copilot.localModel.useInAuto": false,

	// When enabled, local Copilot Agent Host sessions can store and recall [Copilot Memory](https://docs.github.com/en/copilot/concepts/agents/copilot-memory). Your [Copilot Memory settings on GitHub](https://github.com/settings/copilot/memory) and organization policies still apply. Applies to sessions created or resumed after the setting changes.
	"chat.copilot.memory.enabled": true,

	// When enabled together with `chat.copilot.memory.enabled`, local Copilot Agent Host sessions store Copilot Memory in the repository's `.github/copilot-memories.jsonl` file instead of GitHub's cloud memory service. The file is part of the working tree, so commits made by the agent or the Agents window can include it. Requires a GitHub-hosted repository. **Note:** your Copilot Memory settings and organization policies on GitHub don't apply, and user-scoped memories are unavailable. Changing this setting restarts the Copilot SDK client after active turns finish.
	"chat.copilot.memory.local.enabled": false,

	// When enabled, local Copilot Agent Host sessions are offered the Copilot runtime's search subagent tool for codebase search. Applies to sessions when they launch or resume.
	"chat.copilot.searchSubagent.enabled": false,

	// CAPI model ID to use for the search subagent in local Copilot Agent Host sessions when `chat.copilot.searchSubagent.enabled` is enabled. Empty uses the runtime default. An unavailable model makes the search tool unavailable. Changing this setting restarts the Copilot SDK client after active turns finish.
	"chat.copilot.searchSubagent.model": "",

	// Maximum number of characters available for skill descriptions in the Copilot SDK system message.
	"chat.copilot.skillCharBudget": 30000,

	// When enabled, Copilot SDK sessions order the system prompt by how often each section changes, so sessions with the same tools and workspace can reuse each other's prompt cache. This moves per-session sections, such as the environment and session folder, to the end of the system prompt. Applies to new and resumed sessions.
	"chat.copilot.stabilityOrderedPrompt.enabled": false,

	// Controls whether integrated terminals include the `copilot` command that ships with VS Code. The command runs GitHub Copilot CLI and offers to install it when it's missing. A GitHub Copilot CLI that you installed yourself isn't affected.
	"chat.copilotCliCommand.enabled": true,

	// Controls when the introduction to the new Copilot experience is shown.
	//  - off: Do not show the Copilot harness introduction.
	//  - newSession: Show the introduction when a new Copilot harness session starts.
	//  - afterRequest: Show the introduction after the first request is submitted in a new Copilot harness session.
	"chat.copilotHarnessIntroduction.mode": "afterRequest",

	// Enables Copilot connectors in the unified marketplace and exposes connected connector MCP servers in Chat Customizations and Copilot agent sessions.
	"chat.customizations.copilotConnectors.enabled": true,

	// Controls whether the Chat Customizations editor offers to move agents, instructions, and skills from configured locations that are not supported by the active agent-host harness. When disabled, the migration card and sidebar shortcut are hidden.
	"chat.customizations.locationsMigration.enabled": false,

	// Shows Browse instead of Overview when a customization marketplace source is enabled. When disabled, marketplace discovery remains in the existing customization management pages.
	"chat.customizations.marketplace.enabled": true,

	// Enables the SDK-backed GitHub Feed for agent harnesses that provide marketplace search. Local does not provide this source. If Marketplace or this setting is disabled, or a strict marketplace policy is configured, the GitHub Feed is not queried.
	"chat.customizations.marketplace.sources.publicFeed.enabled": true,

	// Controls whether VS Code shows MCP server migration actions, hints, compatibility badges, and compatibility details. Migration moves eligible workspace MCP servers out of .vscode/mcp.json and into a .mcp.json file at the workspace root, where the active agent-host harness discovers them directly.
	"chat.customizations.mcpServerMigration.enabled": false,

	// Controls whether VS Code shows customization migration actions, hints, compatibility badges, and compatibility details for the active Agent Host harness.
	"chat.customizations.migration.enabled": true,

	// Controls whether the Chat Customizations editor offers to convert prompt files into skills for agent-host harnesses, which ignore prompt files. When disabled, the migration card and sidebar shortcut are hidden.
	"chat.customizations.promptMigration.enabled": true,

	// 控制“聊天自定义”编辑器是否为 Markdown 自定义文件(智能体、技能、指令、提示)显示结构化预览。禁用时，编辑器将始终在嵌入式代码编辑器中打开原始 Markdown。
	"chat.customizations.structuredPreview.enabled": false,

	// Controls whether the Chat Customizations editor offers to move agents and instructions stored in user data to the active agent-host harness, which ignores the user data location. When disabled, the migration card and sidebar shortcut are hidden.
	"chat.customizations.userDataMigration.enabled": false,

	// Controls the default configuration for new agent sessions (such as Copilot). You can still change the mode and approval behavior per session, and each session remembers what was used.
	"chat.defaultConfiguration": {
		"mode": "interactive",
		"approvals": "manual"
	},

	// 新聊天对话的默认模型。使用“自动”让 Copilot 选择模型，使用模型系列名称(例如 "opus" 或 "gemini")以使用该系列中最新可用的模型，或使用完整模型 ID。你仍然可以在对话中切换模型；每个新对话都从此模型开始。
	"chat.defaultModel": "",

	// 为 panel 聊天启用聊天参与者自动删除功能。
	"chat.detectParticipant.enabled": true,

	// 禁用和隐藏 GitHub Copilot 提供的内置 AI 功能，包括聊天和内联建议。
	"chat.disableAIFeatures": false,

	// 自动接受聊天所做更改的延迟时间。值以秒为单位，`0` 表示禁用，最大为 `100` 秒。
	"chat.editing.autoAcceptDelay": 0,

	// 是否在删除请求及其关联的编辑之前显示确认消息。
	"chat.editing.confirmEditRequestRemoval": true,

	// 是否在重试请求及其关联的编辑之前显示确认消息。
	"chat.editing.confirmEditRequestRetry": true,

	// 控制是否显示“聊天”面板中的“解释”按钮和 SCM 视图中的“解释更改”上下文菜单。这是一项实验性功能。
	"chat.editing.explainChanges.enabled": false,

	// 控制在聊天响应的已更改文件列表中选择文件时，是在显示聊天所做更改的差异编辑器中打开文件，还是在常规编辑器中打开。按住 `kbstyle(Alt)` 再选择文件，会以相反的方式打开它。
	"chat.editing.openChangedFileInDiffEditor": true,

	// 控制编辑器在保留或撤消聊天编辑后是否自动显示下一个更改。
	"chat.editing.revealNextChangeOnResolve": true,

	// When enabled, Codex sessions opened from the regular workbench (sidebar chat) run inside the agent host process using the Codex App Server instead of the OpenAI extension. Only one Codex implementation surfaces per window. Requires `chat.agentHost.codexAgent.enabled`.
	"chat.editor.codex.preferAgentHost": true,

	// 控制聊天代码块中的字体系列。
	"chat.editor.fontFamily": "default",

	// 控制聊天代码块中的字号(以像素为单位)。
	"chat.editor.fontSize": 14,

	// 控制聊天代码块中的字体粗细。
	"chat.editor.fontWeight": "default",

	// 聊天代码块中的行高(以像素为单位)。使用 0 可根据字号计算行高。
	"chat.editor.lineHeight": 0,

	// 控制行是否应整合在聊天代码块中。
	"chat.editor.wordWrap": "off",

	// Show Agent Host session changes as a working set above the chat input instead of the Changes pill in the editor window. Use its context menu to enable or disable Keep and Undo in both the working set and the editor, or choose Show Pill to turn this setting off. View All Edits opens all changed files in a diff editor. Hosts without a session changeset keep the Changes pill. Local and other chat harnesses are unaffected.
	"chat.editor.workingSet.enabled": true,

	// 将 [glob 模式](https://aka.ms/vscode-glob-patterns)配置为编辑器以打开聊天中的文件(例如 `"*.md": "vscode.markdown.preview.editor"`)。
	"chat.editorAssociations": {},

	// 启用在聊天中编辑请求。借助此操作，可以更改请求内容并将其重新提交到模型。
	"chat.editRequests": "inline",

	// 控制在将请求委派给另一个会话后，聊天面板是否自动关闭。
	"chat.exitAfterDelegation": false,

	// 启用后，自动指令收集(.instructions.md、智能体指令、自定义项索引)将由 GitHub Copilot 对话助手扩展而不是核心工作台执行。
	"chat.experimental.collectInstructionsInExtension": false,

	// 此设置已弃用。请改用“chat.detectParticipant.enabled”。
	// 为 panel 聊天启用聊天参与者自动删除功能。
	"chat.experimental.detectParticipant.enabled": null,

	// 控制增量渲染的动画样式。
	//  - none: 无动画。内容立即显示。
	//  - fade: 简单的不透明度从 0 淡入到 1。
	//  - rise: 内容向上升起并淡入。
	//  - blur: 内容从模糊状态淡入。
	//  - scale: 内容从略小尺寸放大显示。
	//  - slide: 内容从左侧滑入。
	//  - reveal: 内容从上到下显示，带有柔和渐变边缘。
	"chat.experimental.incrementalRendering.animationStyle": "fade",

	// 控制增量渲染过程中内容在渲染前的缓冲方式。缓冲级别越低，渲染越快，但可能显示不完整句子或未成型的 Markdown。
	//  - off: 令牌到达时立即渲染内容。
	//  - word: 逐字显示内容。
	//  - paragraph: 缓冲内容至段落分隔处再进行渲染。
	"chat.experimental.incrementalRendering.buffering": "word",

	// 启用聊天响应流式传输时的增量渲染，并可选择块级动画。
	"chat.experimental.incrementalRendering.enabled": false,

	// Copy the prompt and attachments from a new chat when explicitly opening the new-session view in the Agents Window. Existing drafts in the Agents Window are preserved.
	"chat.experimental.openInAgentsWindow.transferDraft": true,

	// Controls whether supported links in chat are rendered as rich links with live metadata. Enabling this may make authenticated requests to services such as GitHub.
	"chat.experimental.richLinks.enabled": false,

	// Controls the wording and icons used by actions that archive and unarchive chat sessions, as well as the label of the archived sessions section.
	//  - archive: Use Archive, Archive All, Unarchive, and Unarchive All.
	//  - done: Use Mark as Done, Mark All as Done, Restore, and Restore All.
	"chat.experimental.sessionArchiveActionWording": "done",

	// Enable state indicators around chat editor sessions that are in progress, need attention, or have an unvisited completion. Customize the borders with `chat.sessionStateIndicator.inProgressBorder`, `chat.sessionStateIndicator.needsInputBorder`, and `chat.sessionStateIndicator.unvisitedBorder` in `workbench.colorCustomizations`.
	"chat.experimental.sessionStateIndicator.enabled": false,

	// Controls whether chat requests use experimental tree-based sticky scroll instead of the sticky prompt header.
	"chat.experimental.stickyScroll.enabled": true,

	// Controls whether a stronger skill adherence prompt is used that encourages the model to immediately invoke skills when relevant rather than just announcing them. This setting is only used by the Local agent harness.
	"chat.experimental.useSkillAdherencePrompt": false,

	// Shows mode and permissions in a combined picker with expandable permission choices for Copilot Agent Host sessions.
	"chat.experimentalModePermissionsPicker": true,

	// 如果为 true，将针对扩展启用特定于会话窗口的行为。
	"chat.experimentalSessionsWindowOverride": false,

	// 从可用提供程序中选择要用于“浏览”子智能体的默认语言模型。
	//  - : 使用供应商的默认模型
	"chat.exploreAgent.defaultModel": "",

	// 使用由第三方扩展提供的工具启用。
	"chat.extensionTools.enabled": true,

	// 启用统一 GitHub Copilot 扩展。启用后，所有 GitHub Copilot 功能均通过 GitHub Copilot 聊天助手扩展提供。禁用时，GitHub Copilot 和 GitHub Copilot 聊天助手扩展独立运行。
	"chat.extensionUnification.enabled": true,

	// 控制聊天消息中的字体系列。
	"chat.fontFamily": "default",

	// 控制聊天消息中的字号(以像素为单位)。
	"chat.fontSize": 13,

	// 控制是否在智能体会话视图中显示增长通知以鼓励新用户试用 Copilot。
	"chat.growthNotification.enabled": false,

	// Show a one-time feedback survey after switching from Copilot to Local.
	"chat.harnessSwitchFeedbackSurvey.enabled": true,

	// Specify paths to hook configuration files that define custom shell commands to execute at strategic points in an agent's workflow. [Learn More](https://aka.ms/vscode-chat-hooks).
	// 
	// Relative paths are resolved from the root folder(s) of your workspace. Supports Copilot hooks (`*.json`) and Claude Code hooks (`settings.json`, `settings.local.json`).
	// 
	// This setting is only used by the Local agent harness.
	"chat.hookFilesLocations": {
		".github/hooks": true,
		".claude/settings.local.json": true,
		".claude/settings.json": true,
		"~/.copilot/hooks": true,
		"~/.claude/settings.json": true
	},

	// 允许自动将活动编辑器用作指定聊天位置的聊天上下文。
	"chat.implicitContext.enabled": {
		"panel": "always"
	},

	// When enabled, the active editor is automatically forwarded as context, even when it would otherwise only be suggested. Selections and explicitly attached files are always included regardless of this setting.
	// 
	// Note: this setting currently only applies to Agent Host sessions (such as Copilot).
	"chat.implicitContext.includeActiveEditor": true,

	// 控制是否显示新的隐式上下文流。在“询问和编辑”模式下，上下文将自动包含在内。使用智能体时，将以附件的形式建议上下文。选择内容始终作为上下文包含在内。
	"chat.implicitContext.suggestedContext": true,

	// Controls whether instructions with a matching 'applyTo' attribute are automatically included in chat requests. This setting is only used by the Local agent harness.
	"chat.includeApplyingInstructions": true,

	// Controls whether referenced instructions are automatically included in chat requests. This setting is only used by the Local agent harness.
	"chat.includeReferencedInstructions": false,

	// Controls whether context attached to the chat input, such as files, folders, images, symbols, tools, and pull requests, is shown as pills inline with the prompt text at the position where it was added, instead of above the input. Each inline attachment behaves like a single character: move the cursor across it, select it, or delete it like text. Sent requests show the same pills inline. The prompt sent to the model mentions each pill by its attachment's name and location, and attaches each attachment once, however often it is mentioned.
	"chat.inlineAttachments.enabled": false,

	// Controls whether editor inline chat is backed by the Agent Host instead of the extension host. Applied on startup.
	"chat.inlineChat.agentHost.enabled": false,

	// 控制在聊天消息中显示文件和符号引用的方式。
	//  - box: 将文件和符号引用显示为带图标的方框小组件。
	//  - link: 将文件和符号引用显示为不带图标的简单蓝色链接。
	"chat.inlineReferences.style": "box",

	// Specify location(s) of instructions files (`*.instructions.md`) that can be attached in Chat sessions. [Learn More](https://aka.ms/vscode-ghcp-custom-instructions).
	// 
	// Relative paths are resolved from the root folder(s) of your workspace.
	// 
	// Locations configured here are only observed by the Local agent harness. Other harnesses running in VS Code receive instructions from all additional locations configured here, in addition to their built-in locations. To use instructions with independent agent harnesses, such as Copilot CLI, review the [Migrations tab](command:aiCustomization.openManagementEditor?%255B%257B%2522migration%2522%253Atrue%257D%255D "Open the Migrations Tab") in the Agent Customizations editor to migrate them to supported locations.
	"chat.instructionsFilesLocations": {
		".github/instructions": true,
		".claude/rules": true,
		"~/.copilot/instructions": true,
		"~/.claude/rules": true
	},

	// 使用 KaTeX 在聊天答复中启用数学渲染。
	"chat.math.enabled": true,

	// 控制对已安装的模型上下文协议服务器的访问。
	//  - none: 无法访问 MCP 服务器。
	//  - registry: Allows access to MCP servers listed in the registry that VS Code is connected to.
	//  - all: 允许访问任何已安装的 MCP 服务器。
	"chat.mcp.access": "all",

	// 控制 MCP 服务器是否可以为工具调用提供自定义 UI。
	"chat.mcp.apps.enabled": true,

	// 为 AI 辅助的 MCP 服务器安装启用 NuGet 包。对于 .NET 包(NuGet.org)，用于按中央注册表中的名称安装 MCP 服务器。
	"chat.mcp.assisted.nuget.enabled": false,

	// 控制在提交聊天消息时是否应自动启动 MCP 服务器。
	//  - never: 绝不要自动启动 MCP 服务器。
	//  - onlyNew: 仅自动启动从未运行过的新 MCP 服务器。
	//  - newAndOutdated: 自动启动尚未运行的新的和过时的 MCP 服务器。
	"chat.mcp.autostart": "newAndOutdated",

	// 控制发现多个同名 MCP 服务器时的行为。"disable" 禁用低优先级重复项。"suffix" 追加数字后缀以区分。
	//  - disable: 禁用名称重复的低优先级服务器。
	//  - suffix: 为名称重复的服务器追加数字后缀。
	"chat.mcp.collisionBehavior": "disable",

	// 配置从各种其他应用程序的配置中发现模型上下文协议服务器。
	"chat.mcp.discovery.enabled": {
		"claude-desktop": false,
		"copilot": true,
		"windsurf": false,
		"cursor-global": false,
		"cursor-workspace": false
	},

	// 为模型上下文协议(MCP)服务器启用默认商城。
	"chat.mcp.gallery.enabled": false,

	// 配置向 MCP 服务器公开哪些模型以进行采样(在后台发出模型请求)。可以在“MCP: 列出服务器”命令下以图形方式编辑此设置。
	"chat.mcp.serverSampling": {},

	// Offer the workspace root `.mcp.json` file when adding MCP servers manually. When `.vscode/mcp.json` exists, choose which file to add to. Marketplace installations continue to use `.vscode/mcp.json`. Existing `.mcp.json` files can be opened and read independently of this setting.
	"chat.mcp.workspaceRootConfig.enabled": true,

	// When enabled, sign-in dialogs offer "Continue with Microsoft". Signing in with Microsoft exchanges your Microsoft account for the GitHub access your organization has linked to it. The resulting GitHub sign-in lasts for the current window session only and is not saved.
	//  - auto: Offer "Continue with Microsoft" only when a Microsoft work or school account on this device is linked to a GitHub account. This is checked silently in the background: Microsoft may record a sign-in, and the GitHub access used for the check is revoked when possible.
	//  - always: Always offer "Continue with Microsoft", without checking for a linked account.
	//  - never: Never offer "Continue with Microsoft", and never check for a linked account.
	"chat.microsoftAuthentication.enabled": "auto",

	// This setting and the Local agent harness will be removed in a future release. Chat modes are now called custom agents and are located in `.github/agents`. Review the [Migrations tab](command:aiCustomization.openManagementEditor?%255B%257B%2522migration%2522%253Atrue%257D%255D "Open the Migrations Tab") in the Agent Customizations editor to move them into supported locations.
	// Specify location(s) of custom chat mode files (`*.chatmode.md`). [Learn More](https://aka.ms/vscode-ghcp-custom-chat-modes).
	// 
	// Relative paths are resolved from the root folder(s) of your workspace.
	// 
	// This setting is only used by the Local agent harness.
	"chat.modeFilesLocations": {
		".github/chatmodes": true
	},

	// 新聊天会话的默认模式。若为空，则使用聊天视图的默认模式。
	"chat.newSession.defaultMode": "",

	// 控制在确认或问题需要输入时，聊天会话是否应向用户呈现操作系统通知。这包括窗口徽章和通知横幅。
	//  - off: 从不显示用于确认的操作系统通知。
	//  - windowNotFocused: 当未聚焦窗口时，显示操作系统通知以进行确认。
	//  - always: 始终显示用于确认的操作系统通知，即使窗口处于焦点。
	"chat.notifyWindowOnConfirmation": "windowNotFocused",

	// 控制在接收到响应时，聊天会话是否应向用户呈现操作系统通知。这包括窗口徽章和通知横幅。
	//  - off: 从不显示用于响应的操作系统通知。
	//  - windowNotFocused: 当未聚焦窗口时，显示操作系统通知以进行响应。
	//  - always: 始终显示响应的操作系统通知，即使窗口处于焦点。
	"chat.notifyWindowOnResponseReceived": "windowNotFocused",

	// The number of characters a paste must exceed before it is added to the chat input as an attachment instead of being inserted inline. A paste must also span several lines, so a long single-line paste is always inserted inline. Set this to a very large number to always paste inline.
	"chat.pasteAsAttachmentThreshold": 10000,

	// Controls the default permissions picker mode for new local chat sessions. You can still change the permission mode per session, and each session remembers the permission mode that was used. If enterprise policy disables auto approval, new sessions use Default Permissions.
	//  - default: Start new chat sessions with Default Permissions.
	//  - autoApprove: 以绕过审批模式启动新聊天会话。
	//  - autopilot: 以 Autopilot 模式启动新聊天会话。
	"chat.permissions.default": "default",

	// Keep a working progress indicator at the bottom until the response finishes, with a colored or monochrome Draw animation, or without an icon. The indicator reports running subagents and background commands from the current or earlier requests, even while the main response progresses. The default is Draw in all versions of VS Code. Experiments can override the default; an explicit setting takes precedence. Tool calls follow `chat.persistentProgressVerbosity`. Except in Conversation mode, reasoning is separated into collapsible previews that break the tool chain. Standalone tools retain their icons. Completed responses still follow `chat.agent.collapseCompletedResponses`. This replaces inner working progress; terminal activity animations and rich subagent pills are unchanged. Changes apply immediately; reduced motion keeps the indicator visible without animation.
	//  - off: Keep the original thinking, tool, and working progress rendering without a persistent indicator or VS Code logo.
	//  - draw: Tie the VS Code mark with fast parabolic ribbon motion, hold it, then unravel it before a brief rest.
	//  - drawMonochrome: Use the Draw animation with the same grayscale treatment as the VS Code icon in the Agents window. High contrast themes retain their contrast color.
	//  - drawMonochromeNoIcon: Keep the same persistent progress text and tool rendering as Draw (Monochrome), but hide the VS Code icon.
	"chat.persistentProgress": "draw",

	// Control tool call details when `chat.persistentProgress` is enabled. Compact is the default and collapses tool groups in place when thinking or response text resumes, or the response finishes. When Agent Host activity data is available, headers summarize up to three activity groups, prioritizing edits and commands, without language model requests. Remaining activity is counted as other steps. Failed, skipped, denied, and unfinished tool invocations remain explicit, including in the other-steps count. Completed shell invocations count as commands without tracking later background process status. Groups with no recognized activity or outcome use a step count. Expand a summary to inspect all its tool calls. Conversation collapses reasoning and tool calls between response text into one section that starts collapsed, names the current tool call, or the heading of the current reasoning summary (Thinking when the reasoning has no heading), while it runs, and shows a generated summary or Finished thinking once it finishes. Has no effect when persistent progress is Off. Changes apply immediately.
	//  - verbose: Keep tool calls in expanded, headerless chains without an internal scrolling limit.
	//  - compact: Preview tool calls while they run, then collapse each group to a single expandable summary row when the response moves on.
	//  - conversation: Collapse reasoning and tool calls together into a single section that names the current tool call or reasoning heading while it runs, then shows a generated summary or Finished thinking once it finishes.
	"chat.persistentProgressVerbosity": "compact",

	// 从可用提供程序中选择要用于“计划”智能体的默认语言模型。
	//  - : 使用供应商的默认模型
	"chat.planAgent.defaultModel": "",

	// 要发现的插件目录。每个键都是直接指向插件文件夹的路径，值为 `true` 表示启用，`false` 表示禁用。路径可以是绝对路径、相对于工作区根目录的路径，或以 `~/` 开头的用户主目录路径。
	"chat.pluginLocations": {},

	// 在聊天中启用智能体插件集成。
	"chat.plugins.enabled": true,

	// 控制启用或禁用哪些[智能体插件](https://aka.ms/vscode-agent-plugins)。键为 `<plugin>@<marketplace>` 形式的插件 ID (其中市场在 `chat.plugins.marketplaces` 中定义)；值用于启用(`true`)或禁用(`false`)插件。与 `chat.pluginLocations` 中的路径键条目一起被发现。通过策略设置时，条目是累加的: 映射到 `true` 的插件在用户自己的插件之外被启用，只有映射到 `false` 的插件被阻止加载。
	"chat.plugins.enabledPlugins": {},

	// 要查询的插件市场。条目可以是 GitHub 速记(`owner/repo` 或 `owner/repo#ref`)、直接 Git 存储库 URI (`https://...git`、`ssh://...git` 或 `git@host:path.git`，可以选择为每项附加后缀 `#ref`)，也可以是本地存储库 URI (`file:///...`)。等效的 GitHub 速记和 URI 条目会被去重。
	"chat.plugins.marketplaces": [
		"github/awesome-copilot#marketplace"
	],

	// Show an animated gradient border around the chat input while the agent is working or thinking, instead of pinning persistent progress above the input when scrolling. When disabled, the indicator remains visible while scrolling if `chat.persistentProgress` is enabled. The border animation has no effect when reduced motion is enabled.
	"chat.progressBorder.enabled": false,

	// This setting and the Local agent harness will be removed in a future release. Review the [Migrations tab](command:aiCustomization.openManagementEditor?%255B%257B%2522migration%2522%253Atrue%257D%255D "Open the Migrations Tab") in the Agent Customizations editor to convert prompt files into skills.
	// Specify location(s) of reusable prompt files (`*.prompt.md`) that can be run in Chat sessions. [Learn More](https://aka.ms/vscode-ghcp-prompt-snippets).
	// 
	// Relative paths are resolved from the root folder(s) of your workspace.
	// 
	// This setting is only used by the Local agent harness.
	"chat.promptFilesLocations": {
		".github/prompts": true
	},

	// 配置要在聊天欢迎视图中推荐的提示文件。每个键都是提示文件名，值可以是 `true`，以表示始终推荐，`false` 则表示从不推荐，也可以是 [when 子句](https://aka.ms/vscode-when-clause)表达式，如 `resourceExtname == .js` or `resourceLangId == markdown`。
	"chat.promptFilesRecommendations": {},

	// 控制请求进行时队列按钮的默认操作。
	//  - queue: 将消息排入队列，待当前请求完成后发送。
	//  - steer: 通过立即发送消息引导当前请求，发出信号让当前请求让步。
	"chat.requestQueuing.defaultAction": "steer",

	// 控制重新启动后是否在面板中恢复上一次会话。
	"chat.restoreLastPanelSession": false,

	// Controls whether all dirty editors except untitled editors are saved before sending a chat message.
	"chat.saveBeforeSend": true,

	// 启用会话同步到 GitHub.com。启用后，Copilot 会话数据将同步到你的 GitHub 帐户，实现跨设备访问并提供更丰富的见解。还需要启用 `github.copilot.chat.localIndex.enabled`。
	"chat.sessionSync.enabled": false,

	// 要从会话同步中排除的存储库模式。使用准确的 `owner/repo` 名称或通配符模式，如 `my-org/*`。匹配存储库的会话仅存储在本地。
	"chat.sessionSync.excludeRepositories": [],

	// 控制子代理是否可以调用其他子代理。启用后，嵌套层级最多为 5 级。
	"chat.subagents.allowInvocationsFromSubagents": false,

	// Controls whether AI credit usage is shown next to the duration for subagents.
	"chat.subagents.showCreditUsage": false,

	// Controls whether Terminal Chat is backed by the Agent Host instead of the extension host. Applied on startup.
	"chat.terminal.agentHost.enabled": false,

	// 控制提示是否显示在聊天中的用户消息上方。新提示会频繁添加，这有助于你及时了解最新功能。
	"chat.tips.enabled": true,

	// 控制是否在标题栏中显示“在智能体窗口中打开”按钮。
	"chat.titleBar.openInAgentsWindow.enabled": true,

	// Controls whether hovering or focusing the Open in Agents Window button in the title bar shows a hover card that explains the Agents window, and which graphic the card shows. Applies to users who have created fewer than two sessions in the Agents window; other users always see a simple tooltip.
	//  - none: Show a simple tooltip, and grow the button to show its label.
	//  - manyWindowsToOne: Show a hover card with a graphic of editor windows for several projects becoming one Agents window, and keep the button an icon.
	//  - windowComparison: Show a hover card with a graphic of the editor window and the Agents window side by side, and keep the button an icon.
	"chat.titleBar.openInAgentsWindow.richHover": "none",

	// 控制退出登录时是否在标题栏显示 Copilot 登录按钮。禁用时，登录入口将回退到状态栏。
	"chat.titleBar.signIn.enabled": true,

	// When enabled, terminal tool failures are automatically expanded in the chat UI to show error details.
	"chat.tools.autoExpandFailures": true,

	// 对工具输出(例如 `git diff`、`ls -l` 或 `npm install`)进行后处理，以在发送给模型前减少令牌使用量。
	"chat.tools.compressOutput.enabled": false,

	// 启用后，多个工具确认会批量显示在输入框上方的轮播中。
	"chat.tools.confirmationCarousel.enabled": true,

	// 控制是否自动批准智能体所做的编辑。默认设置是批准所有编辑，但对某些文件所做的可能会导致立即产生意外副作用的编辑除外，例如 `**/.vscode/*.json`。
	// 
	// 设置为 `true` 会自动批准对匹配文件的编辑，设置为 `false` 则始终需要显式批准。匹配给定文件的最后一个模式决定是否自动批准编辑。
	"chat.tools.edits.autoApprove": {
		"**/*": true,
		"**/.git/**": false,
		"**/{package.json,server.xml,build.rs,web.config,.gitattributes,.env,Cargo.toml}": false,
		"**/{.npmrc,.yarnrc,.yarnrc.yml,.pnpmfile.js,.pnpmfile.cjs,.pnpmfile.mjs,pnpm-workspace.yaml}": false,
		"**/*.{code-workspace,csproj,fsproj,vbproj,vcxproj,proj,targets,props,gradle,gradle.kts}": false,
		"**/gradle.properties": false,
		"**/ruby_lsp/*/addon": false,
		"**/*.lock": false,
		"**/*-lock.{yaml,json}": false,
		"**/.mcp.json": false,
		"**/.npmrc": false,
		"**/.vscode/*.json": false,
		"**/.github/agents/**": false,
		"**/.github/hooks/**": false,
		"**/.claude/agents/**": false,
		"**/.claude/settings.json": false,
		"**/.claude/settings.local.json": false,
		"**/.codex/agents/**": false,
		"**/.codex/config.toml": false,
		"**/.codex/hooks.json": false
	},

	// 控制哪些工具有资格获得自动批准。设置为 `false` 的工具将始终提出确认，且从不提供自动批准选项。默认行为(或将工具设置为 `true`)可能使工具提供自动批准选项。
	"chat.tools.eligibleForAutoApproval": {},

	// Global auto approve also known as "YOLO mode" disables manual approval completely for _all tools in all workspaces_, allowing the agent to act fully autonomously. This is extremely dangerous and is *never* recommended, even containerized environments like [Codespaces](https://github.com/features/codespaces) and [Dev Containers](https://marketplace.visualstudio.com/items?itemName=ms-vscode-remote.remote-containers) have user keys forwarded into the container that could be compromised.
	// 
	// **This feature disables [critical security protections](https://code.visualstudio.com/docs/agents/run/security) and makes it much easier for an attacker to compromise the machine.**
	// 
	// Note: This setting only controls tool approval and does not prevent the agent from asking questions. To automatically answer agent questions, use the [`chat.autoReply`](command:workbench.action.openSettings?%5B%22chat.autoReply%22%5D) setting.
	"chat.tools.global.autoApprove": false,

	// 启用此选项后，工具确认会显示由 LLM 生成的风险等级(安全/警告/仔细审查)及简短说明。
	"chat.tools.riskAssessment.enabled": true,

	// 用于生成工具风险评估的语言模型 ID。应为小型、快速的模型。
	"chat.tools.riskAssessment.model": "copilot-utility-small",

	// Controls whether terminal output in chat reflows to fit the available width. When disabled, previews use the terminal's column count, or 80 columns when no terminal is available, and scroll horizontally when needed. This does not resize the terminal running the command.
	"chat.tools.terminal.outputReflow": true,

	// 启用后，终端工具调用始终以简化视图显示在可折叠容器中。
	"chat.tools.terminal.simpleCollapsible": true,

	// 控制是否在聊天输入上方显示待办事项列表小组件。启用后，小组件显示智能体创建的待办事项，并随进度更新。
	"chat.tools.todos.showWidget": true,

	// 控制在聊天工具请求时哪些 URL 会得到自动批准。键是 URL 模式，值可以是 `true` 以表示批准请求和响应，可以是 `false` 以表示拒绝，还可以是包含 `approveRequest` 和 `approveResponse` 属性的对象，以用于进行细粒度控制。
	// 
	// 示例:
	// - `"https://example.com": true` - 批准对 example.com 的所有请求
	// - `"https://*.example.com": true` - 批准对 example.com 任意子域的所有请求
	// - `"https://example.com/api/*": { "approveRequest": true, "approveResponse": false }` - 批准对 example.com/api 路径的请求，但不批准响应
	"chat.tools.urls.autoApprove": {
		"https://code.visualstudio.com": true,
		"https://github.com/microsoft/vscode/wiki/*": true
	},

	// 控制在发出撤消请求时是否应还原聊天的输入。输入将使用已还原请求的文本填充。
	"chat.undoRequests.restoreInput": true,

	// 将命令中心搜索框替换为统一聊天和搜索小组件。
	"chat.unifiedAgentsBar.enabled": false,

	// 控制点击聊天响应上的点赞按钮时是否显示动画。
	//  - off: 未显示动画。
	//  - confetti: 在点赞按钮周围显示五彩纸屑爆炸动画。
	//  - floatingThumbs: 显示从按钮上升的浮动点赞图标。
	//  - pulseWave: 显示从按钮扩散的脉冲环。
	//  - radiantLines: 显示从按钮发出的光线。
	"chat.upvoteAnimation": "floatingThumbs",

	// Controls whether skills are provided as specialized capabilities to the chat requests. Skills are loaded from the folders configured in `chat.agentSkillsLocations`. The language model can load these skills on-demand if the `read` tool is available. Learn more about [Agent Skills](https://aka.ms/vscode-agent-skills). This setting is only used by the Local agent harness.
	"chat.useAgentSkills": true,

	// Controls whether instructions from `AGENTS.md` file found in a workspace roots are attached to all chat requests. This setting is only used by the Local agent harness.
	"chat.useAgentsMdFile": true,

	// Controls whether hooks from Claude configuration files can execute. When disabled, only Copilot-format hooks are used. Hooks are loaded from the files configured in `chat.hookFilesLocations`. This setting is only used by the Local agent harness.
	"chat.useClaudeHooks": false,

	// Controls whether instructions from `CLAUDE.md` file found in workspace roots, .claude and ~/.claude folder are attached to all chat requests. This setting is only used by the Local agent harness.
	"chat.useClaudeMdFile": true,

	// Controls whether to use chat customization files in parent repositories. This setting is only used by the Local agent harness.
	"chat.useCustomizationsInParentRepositories": false,

	// Controls whether chat hooks are executed at strategic points during an agent's workflow. Hooks are loaded from the files configured in `chat.hookFilesLocations`. This setting is only used by the Local agent harness.
	"chat.useHooks": true,

	// Controls whether instructions from nested `AGENTS.md` files found in the workspace are listed in all chat requests. The language model can load these skills on-demand if the `read` tool is available. This setting is only used by the Local agent harness.
	"chat.useNestedAgentsMdFiles": false,

	// 替代内置实用工具流使用的语言模型。留空以使用已配置的默认行为。
	//  - : 对实用工具模型使用默认行为
	"chat.utilityModel": "",

	// 替代内置小型/快速实用工具流使用的语言模型。建议使用快速且低成本的模型。留空以使用已配置的默认行为。
	//  - : 对实用工具模型使用默认行为
	"chat.utilitySmallModel": "",

	// Show request and completion timestamps. Hover over a completion timestamp to show the elapsed response time.
	"chat.verbose": true,

	// 当在聊天视图中打开的智能体会话正在进行时，在该视图上显示进度徽章。
	"chat.viewProgressBadge.enabled": false,

	// 当聊天为空时，显示聊天代理会话；如果聊天视图宽度足够，则显示在侧边。
	"chat.viewSessions.enabled": true,

	// 控制聊天代理会话视图在与聊天并排显示时的方向。
	//  - stacked: 除非已有聊天会话可见，否则聊天会话垂直堆叠显示在聊天输入框上方。
	//  - sideBySide: 如果有足够空间，则并排显示聊天会话；否则，除非已有聊天会话可见，否则堆叠显示在聊天输入框上方。
	"chat.viewSessions.orientation": "sideBySide",

	// Controls which graphic explains the Agents window above the Agents window button on the Welcome page.
	//  - none: Show no graphic.
	//  - windowComparison: Show the editor window and the Agents window side by side.
	//  - manyWindowsToOne: Show how editor windows for several projects become one Agents window.
	//  - auto: Show 'manyWindowsToOne' when more than one editor window is open, and 'windowComparison' otherwise.
	"chat.welcomePage.agentsWindowGraphic": "manyWindowsToOne",

	// Controls how the Agents window graphic, its captions and the Agents window button are set apart from the rest of the Welcome page. Applies only while a graphic is shown.
	//  - none: Don't set the section apart.
	//  - card: Show the section on a subtle surface, like the walkthrough tiles.
	//  - outline: Outline the section with a subtle border.
	//  - tint: Show the section on a surface tinted with the accent color.
	//  - band: Show the section on a subtle surface across the width of the page's content.
	//  - separator: Separate the section from the rest of the page with lines above and below it.
	"chat.welcomePage.agentsWindowSectionStyle": "outline",

	// Controls whether the Welcome page shows a GitHub sign-in button instead of the Agents window button when signed out.
	"chat.welcomePage.signIn.enabled": true,

	// Enables dictation across the product (chat input, editor, and terminal). When enabled on a supported platform, a microphone button appears in the chat input and the dictation shortcut becomes available; the on-device transcription model is downloaded on first use and runs locally.
	"dictation.enabled": true,

	// Experimental: when dictation ends, the final transcript is passed through a small language model to restore punctuation, capitalization, paragraphs, and lists. Requires Copilot to be enabled; the transcript is sent to the language model for cleanup. Falls back to the raw transcript when no model is available. Use [dictation instructions](command:workbench.action.chat.configureDictationInstructions) to customize terminology and formatting.
	"dictation.experimental.llmCleanup": true,

	// Controls the language model used for experimental dictation cleanup. `auto` follows the active experiment treatment.
	"dictation.experimental.llmCleanupModel": "auto",

	// The model used for dictation. On-device models download on first use and run locally through Microsoft Foundry Local; the cloud option streams audio to the Microsoft AI voice service.
	//  - nemotron-3.5-asr-streaming-0.6b: NVIDIA Nemotron 3.5 multilingual streaming RNN-T, run on-device through Microsoft Foundry Local. Works offline; no audio leaves the device. Automatic language selection follows the Voice Mode language setting; when that setting is Automatic, dictation uses the configured display language when supported, then the system or browser locale, with model detection as a fallback. Downloaded on first use and cached on disk.
	//  - mai: Cloud transcription through the same Microsoft AI voice service used by Voice Mode. Requires a network connection and GitHub sign-in; audio is streamed to the service.
	"dictation.model": "mai",

	// Controls whether the dictation microphone button is shown in the chat input. When hidden, dictation can still be started with its keyboard shortcut.
	"dictation.showButton": true,

	// Controls whether the transcript is shown while dictating. The final transcript is inserted when dictation ends.
	"dictation.showTranscript": true,

	// Override Auto's "Optimize for" preference for evals and debugging. Accepts `efficiency`, `balance`, or `intelligence` in both Copilot Chat and Copilot SDK sessions; `fast` is extension-only. Set to `null` to clear.
	"github.copilot.chat.autoModeTierOverride": null,

	// Choose the connection method used by Allow Remote Connections. Selecting a method in the Remote Connections menu updates this setting and enables sharing. Selecting Off disables sharing without changing the preferred method. Changing this setting directly turns sharing off.
	//  - devTunnel: Allow remote connections through a secure Dev Tunnel from VS Code or a browser.
	//  - githubEnvironment: Register this machine as a GitHub environment for remote agent access (preview). Remote clients receive trusted-owner access to sessions, tools, and workspace resources. Session actions are mirrored to GitHub for catalog and history storage. Conversation content is not end-to-end encrypted.
	"chat.agentHost.remoteConnections": "devTunnel",

	// Enable connecting to remote agent hosts.
	"chat.remoteAgentHostsEnabled": true,

	// WebSocket remote agent hosts that editor windows connect to while this workspace is open. Their agents become available in Chat, and their sessions are listed there. Editor windows don't connect to the hosts in `chat.remoteAgentHosts`; those belong to the Agents window. Only applies in trusted workspaces; connected hosts receive your GitHub credentials, so only list hosts you trust.
	"chat.workspaceRemoteAgentHosts": [],

	// Enable sharing this machine as a GitHub environment and discovering and connecting to your other shared machines through Mission Control.
	"chat.agentHost.githubEnvironments.enabled": true,

	// Root folder for repositories cloned by remote clients when this machine is shared as a GitHub environment. Repositories are cloned into `<root>/<owner>/<repository>`. Use an absolute path or a path starting with `~` for the local user's home folder. The folder is created if needed. When empty, falls back to `git.defaultCloneDirectory`, then the home folder. Changes apply to future clones and do not move existing repositories.
	"chat.agentHost.defaultCloneDirectory": "",

	// Use the OAuth token already available on this host for work started by a remote client through Mission Control, instead of the remote client's token. Remote clients must still authenticate as the same GitHub account. Requests use the host account's permissions and usage allowance. Changing this setting disconnects existing Mission Control clients.
	"chat.agentHost.experimentalMissionControl.useLocalCredentials": true,

	// Use GitHub Cloud for new Cloud sessions in the Agents Window instead of Copilot coding agent on GitHub Actions. Also enables discovering and opening GitHub Cloud sessions.
	"chat.agentHost.cloudSandbox.enabled": false,

	// Automatically connect to or wake a cloud sandbox environment in the background when opening or restoring its chat in the Agents Window. When disabled, connecting waits until you start composing or explicitly connect.
	"chat.agentHost.cloudSandbox.autoConnectOnOpen": true,

	// Prepare an eligible cloud environment while typing in a new Cloud chat in the editor or Agents Window. This can allocate cloud compute before you send a message.
	"chat.agentHost.cloudSandbox.earlyPreparation": true,

	// Try Mission Control push notifications to discover and refresh cloud sandbox sessions when enabled for your GitHub account. If unavailable, use normal polling without repeated connection attempts until the window reloads, the account changes, or this setting is toggled. When disabled, do not request feed credentials or open a feed connection; use normal polling only.
	"chat.agentHost.cloudSandbox.sessionFeed.enabled": true,

	// 语音模式
	// Allow Agent mode to speak brief semantic progress updates while it investigates, plans, edits, validates, or recovers from a problem.
	"agents.voice.agentProgress": true,

	// 在聊天视图中启用语音模式面板，用于语音驱动的编码对话。
	"agents.voice.enabled": false,

	// When enabled, voice mode automatically re-enters listening after the assistant finishes speaking, so you can hold a hands-free back-and-forth conversation. When disabled, you start and end each turn manually, and ending the turn sends it. Turns are not ended automatically on trailing silence or a stop phrase unless `agents.voice.turn.silenceMs` or `agents.voice.turn.stopPhrases` is explicitly configured.
	"agents.voice.handsFree": true,

	// The language used for speech recognition, dictation, and spoken responses. The selectable languages support native voice output. Automatic uses the configured display language for speech recognition and dictation when supported; otherwise, it follows the system or browser locale. English voice output is used when the detected language does not support native voice output. Changing this while voice mode is connected takes effect immediately.
	"agents.voice.language": "auto",

	// Show your speech as a live, word-by-word transcript while you are speaking. When disabled, your transcript appears only once you finish speaking. Requires `agents.voice.showTranscript` to be enabled to be visible.
	"agents.voice.liveTranscript": false,

	// Share a bounded briefing of tracked sessions and the active chat's recent conversation with OpenAI BYOK Voice Mode, so it can answer session status questions directly. This includes session titles, response summaries, pending prompt details, the selected model, and attachment names, but not attachment contents. Disable to restore input-only context. Changes take effect when Voice Mode reconnects.
	"agents.voice.sessionAwareness": true,

	// Controls whether the Voice Mode button is shown in the chat input. When hidden, Voice Mode can still be started with its keyboard shortcut.
	"agents.voice.showButton": true,

	// 语音模式处于活动状态时，在聊天输入区域显示语音脚本覆盖层。启用此功能可在 `agents.voice.speakResponses` 禁用时将响应作为文本阅读。
	"agents.voice.showTranscript": false,

	// 启用后，助手会朗读回复。禁用后，不会朗读回复；启用 `agents.voice.showTranscript` 可将其作为文本转录阅读。
	"agents.voice.speakResponses": true,

	// Trailing silence in milliseconds before the backend ends the turn automatically. Set to `-1` to disable ending the turn on silence, in which case the turn ends only via a stop phrase (`agents.voice.turn.stopPhrases`) or manually. When enabled, the backend clamps this to its supported range (currently 200-5000 ms) and is the source of truth. When hands-free mode (`agents.voice.handsFree`) is disabled, the turn is not ended on silence by default unless this setting is explicitly configured, so you keep manual control over when a turn is sent.
	"agents.voice.turn.silenceMs": 800,

	// Phrases that end the turn when spoken at the end of an utterance. Leave empty to disable ending the turn on a stop phrase, in which case the turn ends only on trailing silence (`agents.voice.turn.silenceMs`) or manually. The backend strips the matched phrase from the transcript before it reaches the agent. When hands-free mode (`agents.voice.handsFree`) is disabled, stop phrases do not end the turn by default unless this setting is explicitly configured, so you keep manual control over when a turn is sent.
	"agents.voice.turn.stopPhrases": [
		"send it"
	],

	// The OpenAI live model ID to use for Voice Mode with your configured API key. Add the key in Models Management. Voice Mode uses this model when client BYOK is allowed and the key has access to it; leave empty to use the hosted voice model, which requires a paid Copilot plan.
	"agents.voice.useBYOKVoiceModel": "",

	// The voice used when the assistant reads responses aloud. Changing this while voice mode is connected takes effect immediately. Use [Voice Mode instructions](command:workbench.action.chat.configureVoiceInstructions) to customize Voice Mode behavior and terminology.
	//  - harper_neutral: Harper.
	//  - birch_neutral: Birch.
	//  - junho_neutral: Junho.
	//  - oak_neutral: Oak.
	"agents.voice.voice": "birch_neutral",

	// 图像预览
	// 控制点击聊天中的图像附件是否打开图像预览查看器。
	"imageCarousel.chat.enabled": true,

	// 控制“在图像预览中打开”选项是否显示在“资源管理器”上下文菜单中。
	"imageCarousel.explorerContextMenu.enabled": true,

	// 控制是否自动保存作为重构一部分的文件
	"files.refactoring.autoSave": true,

	// 
	//  - legacy: 使用旧差异算法。
	//  - advanced: 使用高级差异算法。
	//  - advanced-external: 使用外部 `@vscode/diff` 包提供的高级差异算法(纯 JavaScript)。
	//  - advanced-wasm: 使用外部 `@vscode/diff` 包提供的高级差异算法(WebAssembly)。
	"mergeEditor.diffAlgorithm": "advanced",

	// Controls if deletions in base or one of the inputs should be indicated by a vertical bar.
	"mergeEditor.showDeletionMarkers": true,

	// Media Preview
	// Start playing videos on mute automatically.
	"mediaPreview.video.autoPlay": false,

	// Loop videos over again automatically.
	"mediaPreview.video.loop": false,

	// 远程
	// 启用后，将检测到新的正在运行的进程，并自动转发其侦听的端口。禁用此设置将不会阻止转发所有端口。即使禁用，扩展将仍然能够导致端口被转发，并且打开某些 URL 仍将导致端口被转发。另请参阅 `remote.autoForwardPortsSource`。
	"remote.autoForwardPorts": true,

	// 自动转发端口且 `remote.autoForwardPortsSource` 默认设置为 `process` 时将触发从 `process` 切换到 `hybrid` 的自动转发端口数。设置为 `0` 可禁用回退。如果尚未配置 `remote.autoForwardPortsFallback`，但配置了 `remote.autoForwardPortsSource`，`remote.autoForwardPortsFallback` 将被视为如同设置为 `0`。
	"remote.autoForwardPortsFallback": 20,

	// 设置当 `remote.autoForwardPorts` 为 true 时自动从其转发端口的源。当 `remote.autoForwardPorts` 为 false 时，`remote.autoForwardPortsSource` 将用于查找有关已转发的端口的信息。在 Windows 和 Mac 远程设备上，“process”和“hybrid”选项不起作用，系统将使用“output”。
	//  - process: 通过监视包含端口的已启动进程发现端口时，将自动转发该端口。
	//  - output: 通过读取终端和调试输出发现端口时，将自动转发该端口。并非所有使用端口的进程都将打印到集成终端或调试控制台，因此某些端口将丢失。根据输出转发的端口将不会被“取消转发”，除非重载或用户在“端口”视图中关闭该端口。
	//  - hybrid: 通过读取终端和调试输出发现端口时，端口将自动转发。并非所有使用端口的进程都将打印到集成终端或调试控制台，因此某些端口将丢失。通过监视侦听该端口的进程以终止，端口将为“未转发”。
	"remote.autoForwardPortsSource": "process",

	// 连接到远程时要安装的扩展列表(已在本地安装)。
	"remote.defaultExtensionsIfInstalledLocally": [
		"GitHub.copilot",
		"GitHub.copilot-chat",
		"GitHub.vscode-pull-request-github"
	],

	// 启用后，扩展将本地下载并安装在远程上。
	"remote.downloadExtensionsLocally": false,

	// 覆盖扩展的类型。"ui" 扩展在本地计算机上安装和运行，而 "workspace" 扩展则在远程计算机上运行。通过使用此设置重写扩展的默认类型，可指定是否应在本地或远程安装和启用该扩展。
	"remote.extensionKind": {
		"pub.name": [
			"ui"
		]
	},

	// 控制从终端和调试控制台打开具有端口的本地 URL 时是否转发它。
	"remote.forwardOnOpen": true,

	// 指定将用于端口转发的本地主机名。
	"remote.localPortHost": "localhost",

	// 对于未从设置 `remote.portsAttributes` 中获得属性的所有端口，设置其上应用的默认属性。例如: 
	// 
	// ```
	// {
	//   "onAutoForward": "ignore"
	// }
	// ```
	"remote.otherPortsAttributes": {},

	// 设置在转发特定端口号时应用的属性。例如:
	// 
	// ```
	// "3000": {
	//   "label": "Application"
	// },
	// "40000-55000": {
	//   "onAutoForward": "ignore"
	// },
	// ".+\\/server.js": {
	//  "onAutoForward": "openPreview"
	// }
	// ```
	"remote.portsAttributes": {
		"443": {
			"protocol": "https"
		},
		"8443": {
			"protocol": "https"
		}
	},

	// 还原您在工作区中转发的端口。
	"remote.restoreForwardedPorts": true,

	// 辅助功能
	// 在 keypress 上，关闭辅助视图，将焦点放在调用它的元素上。
	"accessibility.accessibleView.closeOnKeyPress": true,

	// 控制是否应在调试监视视图中公布变量更改。
	"accessibility.debugWatchVariableAnnouncements": true,

	// 控制在聊天代理对文件应用编辑后是否应打开文件。
	"accessibility.openChatEditedFiles": false,

	// 控制执行代码时是否应自动将焦点发送到 REPL。
	"accessibility.replEditor.autoFocusReplExecution": "input",

	// 控制是否将宣布来自本机 REPL 中执行的输出。
	"accessibility.replEditor.readLastExecutionOutput": true,

	// 是否应停用位置更改
	"accessibility.signalOptions.debouncePositionChanges": false,

	// 
	"accessibility.signalOptions.experimental.delays.errorAtPosition": {},

	// Delays for all signals besides error and warning at position
	"accessibility.signalOptions.experimental.delays.general": {},

	// 
	"accessibility.signalOptions.experimental.delays.warningAtPosition": {},

	// 声音音量百分比(0-100)。
	"accessibility.signalOptions.volume": 70,

	// 在显示包含聊天编辑更改的文件时播放声音/音频提示
	"accessibility.signals.chatEditModifiedFile": {
		"sound": "auto"
	},

	// 播放信号 - 声音(音频提示)和/或公告(警报) - 发出聊天请求时。
	"accessibility.signals.chatRequestSent": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 收到响应时播放声音/音频提示。
	"accessibility.signals.chatResponseReceived": {
		"sound": "auto"
	},

	// 当聊天中需要用户操作时，播放信号 - 声音(音频提示)和/或通知(警报)。
	"accessibility.signals.chatUserActionRequired": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 播放信号 - 声音(音频提示)和/或公告(警报) - 清除功能(例如，终端、调试控制台或输出通道)时。
	"accessibility.signals.clear": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 应用代码操作后播放声音/音频提示。
	"accessibility.signals.codeActionApplied": {
		"sound": "auto"
	},

	// 播放声音/音频提示 - 触发代码操作时。
	"accessibility.signals.codeActionTriggered": {
		"sound": "auto"
	},

	// Plays a joyful sound / audio cue when confetti is shown.
	"accessibility.signals.confetti": {
		"sound": "auto"
	},

	// 当焦点在可访问差异查看器模式下移动到删除行或下一个/上一个更改时播放声音/音频提示。
	"accessibility.signals.diffLineDeleted": {
		"sound": "auto"
	},

	// 当焦点在可访问差异查看器模式下移动到插入行或下一个/上一个更改时播放声音/音频提示。
	"accessibility.signals.diffLineInserted": {
		"sound": "auto"
	},

	// 当焦点在可访问差异查看器模式下移动到修改行或下一个/上一个更改时播放声音/音频提示。
	"accessibility.signals.diffLineModified": {
		"sound": "auto"
	},

	// 保存编辑后播放信号 - 声音(音频提示)和/或通知(警报)。
	"accessibility.signals.editsKept": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 撤消编辑后播放信号 - 声音(音频提示)和/或通知(警报)。
	"accessibility.signals.editsUndone": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 播放信号 -声音(音频提示)和/或公告(警报) - 设置文件或笔记本的格式时。
	"accessibility.signals.format": {
		"sound": "never",
		"announcement": "never"
	},

	// 播放信号 -声音(音频提示)和/或公告(警报) - 活动行出现断点时。
	"accessibility.signals.lineHasBreakpoint": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 播放信号 -声音(音频提示)和/或公告(警报) - 活动行出现错误时。
	"accessibility.signals.lineHasError": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 播放信号 - 声音(音频提示)和/或公告(警报) - 活动行包含可展开的折叠区域时。
	"accessibility.signals.lineHasFoldedArea": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 活动行包含内联建议时播放声音/音频提示。
	"accessibility.signals.lineHasInlineSuggestion": {
		"sound": "auto"
	},

	// 播放信号 -声音(音频提示)和/或公告(警报) - 活动行出现警告时。
	"accessibility.signals.lineHasWarning": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 当有下一个编辑建议时，播放信号音/音频提示和/或公告(警报)。
	"accessibility.signals.nextEditSuggestion": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 播放信号 -声音(音频提示)和/或公告(警报) - 尝试读取带有包含无内嵌提示的内嵌提示的行时。
	"accessibility.signals.noInlayHints": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 播放信号 -声音(音频提示)和/或公告(警报) - 成功完成笔记本单元格执行时。
	"accessibility.signals.notebookCellCompleted": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 播放信号 -声音(音频提示)和/或公告(警报) - 笔记本单元格执行失败时。
	"accessibility.signals.notebookCellFailed": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 播放信号 -声音(音频提示)和/或公告(警报) - 调试程序在断点处停止时。
	"accessibility.signals.onDebugBreak": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 播放信号 -声音(音频提示)和/或公告(警报) - 活动行出现警告时。
	"accessibility.signals.positionHasError": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 播放信号 -声音(音频提示)和/或公告(警报) - 活动行出现警告时。
	"accessibility.signals.positionHasWarning": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 播放信号 -声音(音频提示)和/或公告(警报) - 进度过程中发生循环时。
	"accessibility.signals.progress": {
		"sound": "auto",
		"announcement": "off"
	},

	// 播放信号 - 声音(音频提示)和/或公告(警报) - 保存文件时。
	"accessibility.signals.save": {
		"sound": "never",
		"announcement": "never"
	},

	// 播放信号 - 声音(音频提示)和/或公告(警报) - 完成任务时。
	"accessibility.signals.taskCompleted": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 播放信号 -声音(音频提示)和/或公告(警报) - 任务失败(非零退出代码)时。
	"accessibility.signals.taskFailed": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 播放信号 -声音(音频提示)和/或公告(警报) - 终端铃声响铃时。
	"accessibility.signals.terminalBell": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 播放信号 - 终端命令失败(非零退出代码)或在可访问视图中导航到具有此类退出代码的命令时。
	"accessibility.signals.terminalCommandFailed": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 当终端命令成功(零退出代码)或在可访问视图中导航到具有此类退出代码的命令时，播放信号 - 声音(音频提示)和/或公告(警报)。
	"accessibility.signals.terminalCommandSucceeded": {
		"sound": "auto",
		"announcement": "auto"
	},

	// 播放信号 -声音(音频提示)和/或公告(警报) - 终端快速修复可用时。
	"accessibility.signals.terminalQuickFix": {
		"sound": "auto",
		"announcement": "auto"
	},

	// Plays a signal - sound (audio cue) and/or announcement (alert) - when voice mode has started.
	"accessibility.signals.voiceModeStarted": {
		"sound": "on",
		"announcement": "auto"
	},

	// Plays a signal - sound (audio cue) and/or announcement (alert) - when voice mode has stopped.
	"accessibility.signals.voiceModeStopped": {
		"sound": "on",
		"announcement": "auto"
	},

	// 语音录制开始时播放声音/音频提示。
	"accessibility.signals.voiceRecordingStarted": {
		"sound": "on"
	},

	// 语音录制停止时播放声音/音频提示。
	"accessibility.signals.voiceRecordingStopped": {
		"sound": "on"
	},

	// 控制是否应在工作台中向链接添加下划线。
	"accessibility.underlineLinks": false,

	// 控制是否应在聊天请求进行过程中发出详细的进度公告，包括 <search term> 的搜索文本(具有 X 个结果)、创建的文件 <file_name> 或读取文件 <file path> 等信息。
	"accessibility.verboseChatProgressUpdates": true,

	// Provide information about how to access accessibility help when managing which extensions run in the Agents window.
	"accessibility.verbosity.agentsWindowExtensions": true,

	// Provide information about how to use Automations management views, including keyboard navigation and how to inspect scheduled runs.
	"accessibility.verbosity.automations": true,

	// Provide information about how to access element commenting accessibility help in the Integrated Browser.
	"accessibility.verbosity.browserElementCommenting": true,

	// Provide information about how to access chat pet achievements accessibility help when the Achievements modal is focused.
	"accessibility.verbosity.chatPetAchievements": true,

	// Provide information about how to access accessibility help when Blobby's jump game is focused.
	"accessibility.verbosity.chatPetJumpGame": true,

	// 提供有关如何导航和与聊天问题轮播交互的信息，包括在适用时如何聚焦终端。
	"accessibility.verbosity.chatQuestionCarousel": true,

	// 提供有关可在注释小组件或包含注释的文件中执行的操作的信息。
	"accessibility.verbosity.comments": true,

	// Provide information about how to access connection diagnostics accessibility help when the report is focused.
	"accessibility.verbosity.connectionDiagnostics": true,

	// Provide information about how to access accessibility help when discovering customizations.
	"accessibility.verbosity.customizationDiscovery": true,

	// Provide information about how to access accessibility help for the customization migration checklist.
	"accessibility.verbosity.customizationMigrations": true,

	// 提供有关在聚焦调试控制台或运行和调试 viewlet 时如何访问调试控制台辅助功能帮助对话框的信息。请注意，需要重新加载窗口才能使其生效。
	"accessibility.verbosity.debug": true,

	// 提供有关如何在聚焦差异编辑器时在其中导航更改的信息。
	"accessibility.verbosity.diffEditor": true,

	// 指示差异编辑器何时成为活动编辑器。
	"accessibility.verbosity.diffEditorActive": true,

	// 在空文本编辑器中提供有关相关操作的信息。
	"accessibility.verbosity.emptyEditorHint": true,

	// Provide information about how to use file search in the empty Files editor.
	"accessibility.verbosity.emptyFileEditorSearch": true,

	// 提供有关在以查找输入为焦点时如何访问查找辅助功能帮助菜单的信息。
	"accessibility.verbosity.find": true,

	// 提供有关如何在辅助视图中打开悬停的信息。
	"accessibility.verbosity.hover": true,

	// Provide information about how to navigate and act on prioritized notifications in the Inbox view.
	"accessibility.verbosity.inboxNotifications": true,

	// 提供有关如何访问内联编辑器聊天辅助功能帮助菜单的信息，并提供如何在聚焦输入时使用该功能的提示。
	"accessibility.verbosity.inlineChat": true,

	// 提供有关如何访问内联完成悬停和辅助视图的信息。
	"accessibility.verbosity.inlineCompletions": true,

	// 提供有关在行聚焦时如何在键盘绑定编辑器中更改键盘绑定以及如何导航到结果表的信息。
	"accessibility.verbosity.keybindingsEditor": true,

	// Provide information about how to access accessibility help when an MCP server configuration form is focused.
	"accessibility.verbosity.mcpServerConfiguration": true,

	// Provide information about how to navigate the changed files list in the multi diff editor when it is focused.
	"accessibility.verbosity.multiDiffEditorFileList": true,

	// Announce the welcome message when a new session composer is shown.
	"accessibility.verbosity.newSessionWelcome": true,

	// 提供有关在笔记本单元格聚焦时如何聚焦单元格容器或内部编辑器的信息。
	"accessibility.verbosity.notebook": true,

	// 提供有关如何在辅助视图中打开通知的信息。
	"accessibility.verbosity.notification": true,

	// 提供有关如何在聚焦聊天输入时访问聊天帮助菜单的信息。
	"accessibility.verbosity.panelChat": true,

	// Provide information about how to access release notes accessibility help when the release notes are focused.
	"accessibility.verbosity.releaseNotes": true,

	// Provide information about how to access accessibility help when managing remotes.
	"accessibility.verbosity.remotes": true,

	// 提供有关在 REPL 编辑器处于焦点状态下如何访问 REPL 编辑器辅助功能帮助菜单的信息。
	"accessibility.verbosity.replEditor": true,

	// Provide information about how to access canvas accessibility help when a canvas is focused.
	"accessibility.verbosity.sessionCanvas": true,

	// 提供信息说明在焦点位于“更改”视图时如何访问“更改”视图辅助功能帮助菜单。
	"accessibility.verbosity.sessionsChanges": true,

	// 提供有关在聊天输入框聚焦时如何访问智能体窗口辅助功能帮助菜单的信息。
	"accessibility.verbosity.sessionsChat": true,

	// Provide information about how to access accessibility help for the Get Started checklist in the Sessions view.
	"accessibility.verbosity.sessionsGetStarted": true,

	// Provide information about how to access accessibility help for the Undo notice in the sessions list.
	"accessibility.verbosity.sessionsListNotification": true,

	// Provide information about how to use the Manage Agent Session Storage editor when it is focused.
	"accessibility.verbosity.sessionWorktreeCleanup": true,

	// 提供有关在以输入为焦点时如何访问源代码管理辅助功能帮助菜单的信息。
	"accessibility.verbosity.sourceControl": true,

	// 提供有关如何导航问卷编辑器窗格并与其交互的信息。
	"accessibility.verbosity.survey": true,

	// 提供有关如何在聚焦终端时访问终端辅助功能帮助菜单的信息。
	"accessibility.verbosity.terminal": true,

	// 介绍如何在辅助视图中打开聊天终端输出。
	"accessibility.verbosity.terminalChatOutput": true,

	// 提供有关如何在辅助视图中打开演练的信息。
	"accessibility.verbosity.walkthrough": true,

	// 控制在屏幕阅读器模式下是否应针对屏幕阅读器优化 `window.title`。启用后，窗口标题会将 `activeEditorState` 追加到末尾。
	"accessibility.windowTitleOptimized": true,

	// 问题报告程序
	// Additional GitHub repositories offered in the issue reporter for VS Code and Agents Window reports, in owner/repo format. The default repository remains selected initially. GitHub manages repository access.
	"issueReporter.additionalRepositories": [],

	// 启用新版问题报告程序向导，而非经典问题报告程序。
	"issueReporter.wizard.enabled": true,

	// 为问题报告程序向导自动收集性能诊断信息时，遍历整个工作区，而非在默认 20,000 文件上限处停止。如果扫描拖慢向导初始呈现，请在超大型工作区中将此项设置为 false。
	"issueReporter.wizard.fullWorkspaceScan": true,

	// Where to open fresh reports when the new issue reporter is enabled. Existing reports keep their current location.
	//  - editor: Open new issue reports in an editor tab.
	//  - window: Open new issue reports in a separate window attached to the current workbench.
	"issueReporter.wizard.openLocation": "window",

	// 设置本机 UI 元素的颜色模式，例如本机对话框、菜单和标题栏。即使在浅色模式下配置 OS，也可以为窗口选择深色系统颜色主题。还可以配置为根据 `workbench.colorTheme` 设置自动调整。
	// 
	// 注意: 启用 `window.autoDetectColorScheme` 时会忽略此设置。
	//  - default: 本机小组件颜色与系统颜色匹配。
	//  - auto: 对浅色主题使用浅色本机小组件颜色，对深色主题使用深色本机小组件颜色。
	//  - light: 使用浅色本机小组件颜色。
	//  - dark: 使用深色本机小组件颜色。
	"window.systemColorTheme": "default",

	// 远程隧道访问注册名。如果未设置，则使用主机名。
	"remote.tunnels.access.hostNameOverride": "",

	// 启用远程隧道访问时，防止计算机进入休眠。
	"remote.tunnels.access.preventSleep": false,

	// Emmet
	// 不应展开 Emmet 缩写的语言数组。
	"emmet.excludeLanguages": [
		"markdown"
	],

	// 一组路径，其中每个路径都可以包含 Emmet syntaxProfiles 和/或代码片段。
	// 发生冲突时，后面路径的配置文件/代码段将重写以前的路径。
	// 有关详细信息和示例片段文件，请参见 https://code.visualstudio.com/docs/editor/emmet。
	"emmet.extensionsPath": [],

	// 在默认不受支持的语言中启用 Emmet 缩写。在此语言和 Emmet 支持的语言之间添加映射。
	//  例如: `{"vue-html": "html", "javascript": "javascriptreact"}`
	"emmet.includeLanguages": {},

	// 当设置为 `false` 时，将分析整个文件并确定当前位置能否展开 Emmet 缩写。当设置为 `true` 时，将仅在 CSS/SCSS/LESS 文件中分析当前位置周围的内容。
	"emmet.optimizeStylesheetParsing": true,

	// 用于修改 Emmet 某些操作和解析程序的行为的首选项。
	"emmet.preferences": {},

	// 将可能的 Emmet 缩写作为建议进行显示。当在样式表中或 emmet.showExpandedAbbreviation 设置为 `"never"` 时不适用。
	"emmet.showAbbreviationSuggestions": true,

	// 以建议的形式显示展开的 Emmet 缩写。
	// 选项 `"inMarkupAndStylesheetFilesOnly"` 适用于 html、haml、jade、slim、xml、xsl、css、scss、sass、less 和 stylus。
	// 无论 markup/css 如何，选项 `"always"` 都适用于文件的各个部分。
	"emmet.showExpandedAbbreviation": "always",

	// 若为 `true`，Emmet 建议将显示为代码片段。可以在 `editor.snippetSuggestions` 设置中排列其顺序。
	"emmet.showSuggestionsAsSnippets": false,

	// 为指定的语法定义配置文件或使用带有特定规则的配置文件。
	"emmet.syntaxProfiles": {},

	// 启用后，在按 Tab 时会展开 Emmet 缩写，即使未显示完成。禁用后，仍可通过按 TAB 接受显示的完成。
	"emmet.triggerExpansionOnTab": false,

	// 如果为 `true`，Emmet 将使用内联完成来建议扩展。如果要防止非内联完成项提供程序在此设置为 `true` 时频繁显示，请将 `other` 项的 `editor.quickSuggestions` 转换为 `inline` 或 `off`。
	"emmet.useInlineCompletions": false,

	// 用于 Emmet 代码片段的变量。
	"emmet.variables": {},

	// GitHub
	// 控制是否查询 GitHub 存储库的存储库规则
	"github.branchProtection": true,

	// 控制是否在 VS Code 中为 git 命令启用自动 GitHub 身份验证。
	"github.gitAuthentication": true,

	// 控制用于克隆 GitHub 仓库的协议
	"github.gitProtocol": "https",

	// 控制是否以各种悬停方式显示提交作者的 GitHub 虚拟形象 (，例如 Git 追溯、日程表、源代码管理图等 )
	"github.showAvatar": true,

	// GHE.com 和GitHub Enterprise服务器身份验证
	// 为 true 时，优先使用设备代码流进行身份验证，而非其他可用的流。这在 WSL 等环境中很有用，在这些环境中，本地服务器或 URL 处理程序流可能无法按预期工作。
	"github-authentication.preferDeviceCodeFlow": false,

	// 如果为 true，则将 Electron 的内置提取函数用于 HTTP 请求。如果为 false，则使用 Node.js 全局提取函数。此设置仅在 Electron 环境中运行时适用。**注意:** 此设置需要重启才能生效。
	"github-authentication.useElectronFetch": true,

	// Use `github-enterprise.uris` instead. This setting is used only when that setting is not configured.
	// GHE.com 或 GitHub Enterprise Server 实例的 URI。
	// 
	// 例子：
	// * GHE.com： 'https://octocat.ghe.com`
	// * GitHub Enterprise服务器：“https://github.octocat.com`
	// 
	// > **注意：** 这应将 _not_ 设置为 GitHub.com URI。如果你的帐户在 GitHub.com 上存在或是GitHub Enterprise托管用户，则无需任何其他配置，只需登录 GitHub 即可。
	"github-enterprise.uri": "",

	// The URIs of your GHE.com or GitHub Enterprise Server instances, such as `https://octocat.ghe.com` or `https://github.octocat.com`. Order does not select a default instance. When signing in, choose an instance if more than one is configured.
	// 
	// This setting takes precedence over `github-enterprise.uri`. An explicitly configured empty array disables enterprise instances, even if the deprecated setting is set.
	// 
	// GitHub.com accounts do not need this setting and use the GitHub authentication provider.
	"github-enterprise.uris": [],

	// Grunt
	// Grunt 任务检测的控制启用。Grunt 任务检测可能会导致执行任何打开的工作区中的文件。
	"grunt.autoDetect": "off",

	// Gulp
	// Gulp 任务检测的控制启用。Gulp 任务检测可能会导致执行任何打开的工作区中的文件。
	"gulp.autoDetect": "off",

	// .ipynb 支持
	// 用于在工作线程中序列化 Jupyter 笔记本的试验性功能。
	"ipynb.experimental.serialization": true,

	// 启用/禁用将图像粘贴到 ipynb 笔记本文件中的 Markdown 单元格中。粘贴的图像会作为附件插入到单元格。
	"ipynb.pasteImagesAsAttachments.enabled": true,

	// Jake
	// Jake 任务检测的控制启用。Jake 任务检测可能会导致执行任何打开的工作区中的文件。
	"jake.autoDetect": "off",

	// Markdown Math
	// 在内置 Markdown 预览中启用/禁用呈现数学。
	"markdown.math.enabled": true,

	// 自定义宏的集合。每个宏都是键值对，其中键是新的命令名称，值是宏的扩展。
	"markdown.math.macros": {},

	// 合并冲突
	// 是否在解决合并冲突后自动转到下一个合并冲突。
	"merge-conflict.autoNavigateNextConflict.enabled": false,

	// 为编辑器中的合并冲突区域创建 CodeLens。
	"merge-conflict.codeLens.enabled": true,

	// 为编辑器中的合并冲突区域创建提示小标。
	"merge-conflict.decorators.enabled": true,

	// 控件在比较合并冲突中的更改时应在何处打开差异视图。
	//  - Current: 在当前的编辑器组中打开差异视图。
	//  - Beside: 在当前编辑器组旁边打开差异视图。
	//  - Below: 在当前编辑器组下方打开差异视图。
	"merge-conflict.diffViewPosition": "Current",

	// Mermaid
	// 控制是否在 Mermaid 图表上显示 UI 控件。
	//  - never: 从不显示控件。
	//  - onHoverOrFocus: 悬停或聚焦图表时显示缩放控件。
	//  - always: 始终显示缩放控件。
	"markdown-mermaid.controls.show": "onHoverOrFocus",

	// 深色模式下的默认 Mermaid 主题。
	//  - vscode: 从当前 VS Code 颜色主题派生的 Mermaid 主题。
	//  - base: 内置 Mermaid 主题。唯一可以使用主题变量自定义的 Mermaid 主题。
	//  - forest: 使用绿色阴影的内置 Mermaid 主题。
	//  - dark: 适用于深色背景的内置 Mermaid 主题。
	//  - default: 默认内置 Mermaid 主题。适用于浅色背景。
	//  - neutral: 使用中性灰度调色板的内置 Mermaid 主题。适用于黑白打印。
	"markdown-mermaid.darkModeTheme": "vscode",

	// Markdown 中的默认语言。
	"markdown-mermaid.languages": [
		"mermaid"
	],

	// 浅色模式下的默认 Mermaid 主题。
	//  - vscode: 从当前 VS Code 颜色主题派生的 Mermaid 主题。
	//  - base: 内置 Mermaid 主题。唯一可以使用主题变量自定义的 Mermaid 主题。
	//  - forest: 使用绿色阴影的内置 Mermaid 主题。
	//  - dark: 适用于深色背景的内置 Mermaid 主题。
	//  - default: 默认内置 Mermaid 主题。适用于浅色背景。
	//  - neutral: 使用中性灰度调色板的内置 Mermaid 主题。适用于黑白打印。
	"markdown-mermaid.lightModeTheme": "vscode",

	// 图表最大高度。必须是带单位的 CSS 值，例如 `80vh` 或 `400px`。留空以尝试根据内容自动调整图表大小。
	"markdown-mermaid.maxHeight": "",

	// 用户文本图表允许的最大大小。
	"markdown-mermaid.maxTextSize": 50000,

	// 控制何时在 Mermaid 图表上启用基于鼠标的导航。
	//  - always: 始终在 Mermaid 图表上启用鼠标导航。
	//  - alt: 仅在按住 Alt (macOS 上为 Option)时启用鼠标导航。无需 Alt，捏合缩放等手势仍可使用。
	//  - never: 禁用鼠标导航。
	"markdown-mermaid.mouseNavigation.enabled": "alt",

	// 允许通过拖动下边缘垂直调整图表大小。
	"markdown-mermaid.resizable": true,

	// Microsoft Sovereign Cloud
	// 用于 Microsoft 主权云身份验证提供程序的主权云的自定义配置。使用此功能需要将`microsoft-sovereign-cloud.environment`设置为“custom”。
	"microsoft-sovereign-cloud.customEnvironment": {},

	// 用于身份验证的主权云。如果选择“custom”，则还必须设置`microsoft-sovereign-cloud.customEnvironment`。
	//  - ChinaCloud: Azure 中国
	//  - USGovernment: Azure 美国政府
	//  - custom: 自定义 Microsoft 主权云
	"microsoft-sovereign-cloud.environment": "",

	// Microsoft
	// 用于通过 Microsoft 帐户进行登录的身份验证实现。
	//  - msal: 使用 Microsoft 身份验证库(MSAL) 通过 Microsoft 帐户登录。
	//  - msal-no-broker: 使用 Microsoft 身份验证库，以借助浏览器利用 Microsoft 帐户进行登录。如果你在使用本机代理时遇到问题，此方法会非常有用。
	"microsoft-authentication.implementation": "msal",

	// JavaScript Debugger
	// 配置在 "#debug.node.autoAttach#" 处于启用状态时自动附加和调试的进程。无论此设置如何，都始终附加到启动的带有 "--inspect" 标志的节点进程。
	//  - always: 自动附加到终端中启动的每个 Node.js 进程。
	//  - smart: 运行不在 node_modules 文件夹中的脚本时自动附加。
	//  - onlyWithFlag: 仅在给定 "--inspect" 时自动附加。
	//  - disabled: 自动附加被禁用，且不在状态栏中显示。
	"debug.javascript.autoAttachFilter": "disabled",

	// 配置 glob 模式，以确定何时附加智能 `debug.javascript.autoAttachFilter` 模式。`$KNOWN_TOOLS$` 被替换为常见测试和代码运行器的名称的列表。[在 VS Code 文档中阅读更多内容](https://code.visualstudio.com/docs/nodejs/nodejs-debugging#_auto-attach-smart-patterns)。
	"debug.javascript.autoAttachSmartPattern": [
		"${workspaceFolder}/**",
		"!**/node_modules/**",
		"**/$KNOWN_TOOLS$/**"
	],

	// 调试远程 Web 应用时，配置是否自动将远程服务器通过隧道传输到本地计算机。
	"debug.javascript.automaticallyTunnelRemoteServer": true,

	// 在条件断点引发错误时是否停止。
	"debug.javascript.breakOnConditionalError": false,

	// 在 npm 脚本中应显示“运行”和“调试”代码的位置。 它可以在脚本部分的“全部”、脚本、脚本部分的“顶部”或“从不”上面。
	"debug.javascript.codelens.npmScripts": "top",

	// 调试时从调试终端内部单击链接使用的选项。可设置为"false"以禁用此行为。
	"debug.javascript.debugByLinkOptions": "on",

	// 用于启动配置的默认 "runtimeExecutable" (如果未指定)。这可用于配置 Node.js 或浏览器安装项的自定义路径。
	"debug.javascript.defaultRuntimeExecutable": {
		"pwa-node": "node"
	},

	// 为支持它的目标启用实验性网络视图。
	"debug.javascript.enableNetworkView": true,

	// 通过 `Debug: Attach to Node.js Process` 命令调试进程时使用的默认选项
	"debug.javascript.pickAndAttachOptions": {},

	// 当为 true (默认)时，js-debug 会在启动前使用源映射将非 `.js` 的 `program` 路径重新映射到其编译输出。设置为 false 可按原样执行 `program` 路径。
	"debug.javascript.resolveDebugEntrypoint": true,

	// 在调试器中加载资源(如源映射)时可使用的请求选项。例如，如果你的源映射需要身份验证或使用自签名证书，则可能需要配置此设置。选项用于创建使用 [`got`](https://github.com/sindresorhus/got) 库的请求。
	// 
	// 可通过传递 `{ "https": { "rejectUnauthorized": false } }` 来实现禁用证书验证的常见情况。
	"debug.javascript.resourceRequestOptions": {},

	// JavaScript 调试终端和 npm 脚本的默认启动选项。
	"debug.javascript.terminalOptions": {},

	// 配置是否会自动取消映射无法读取源文件的源映射文件。如果这是 false (默认)，系统会显示提示。
	"debug.javascript.unmapMissingSources": false,

	// Npm
	// 控制是否自动检测 npm 脚本。
	"npm.autoDetect": "on",

	// 从资源管理器上下文菜单中启用运行文件夹中包含的 NPM 脚本。
	"npm.enableRunFromFolder": false,

	// 配置应从自动脚本检测中排除的文件夹的 glob 模式。
	"npm.exclude": "",

	// 从 https://registry.npmjs.org 和 https://registry.bower.io 获取数据，以提供自动补全和 npm 依赖项上的悬停功能信息。
	"npm.fetchOnlinePackageInfo": true,

	// 用于安装依赖项的包管理器。
	//  - auto: 根据锁定文件和已安装的包管理器自动检测要使用的包管理器。
	//  - npm: 使用 npm 作为包管理器。
	//  - yarn: 使用 yarn 作为包管理器。
	//  - pnpm: 使用 pnpm 作为包管理器。
	//  - bun: 使用 bun 作为包管理器。
	"npm.packageManager": "auto",

	// 使用 `--silent` 选项运行 npm 命令。
	"npm.runSilent": false,

	// NPM 脚本资源管理器中使用的默认单击操作: `open` 或 `run`，默认值为 `open`。
	"npm.scriptExplorerAction": "open",

	// 正则表达式的数组，指示应从 NPM 脚本视图中排除哪些脚本。
	"npm.scriptExplorerExclude": [],

	// 使用脚本的 `Run` 和 `Debug` 命令显示悬停。
	"npm.scriptHover": true,

	// 用于运行脚本的脚本运行程序。
	//  - auto: 根据锁定文件和已安装的包管理器自动检测要使用的脚本运行器。
	//  - npm: 使用 npm 作为脚本运行程序。
	//  - yarn: 使用 Yarn 作为脚本运行程序。
	//  - pnpm: 使用 pnpm 作为脚本运行程序。
	//  - bun: 使用 bun 作为脚本运行程序。
	//  - node: 使用 Node.js 作为脚本运行程序。
	//  - vp: 将 Vite+ (vp) 用作脚本执行器。
	"npm.scriptRunner": "auto",

	// 引用搜索视图
	// 控制在选择代码信息指示器引用时是否调用“速览引用”或“查找引用”。
	//  - peek: 在速览编辑器中显示引用。
	//  - view: 在单独的视图中显示引用。
	"references.preferredLocation": "peek",

	// Simple Browser
	// 启用/禁用在简单浏览器中聚焦时显示的浮动指示器。
	"simpleBrowser.focusLockIndicator.enabled": true,

	// C# 开发工具包
	// 设置调试程序为调试控制台发送的消息的日志级别。[了解详细信息...](https://aka.ms/vscode/dotnet/debugConsoleVerbosity)
	//  - minimal: 在调试控制台中显示最少的详细信息。“C# 调试程序”输出窗口通道中提供了其他信息。
	//  - verbose: 在调试控制台中显示所有信息。
	"csharp.debug.debugConsoleVerbosity": "minimal",

	// 如果为 true，则保存文件将在热重载可用时将自动应用更改。
	"csharp.debug.hotReloadOnSave": true,

	// “.NET 热重载”的输出面板中日志记录的详细程度。从最小详细级别到最详细级别的顺序为: "minimal" < "detailed" < "diagnostic" (默认值: "minimal")
	//  - minimal: 仅显示最少信息。
	//  - detailed: 显示有关如何找到更改并将其应用于目标进程的详细信息。
	//  - diagnostic: 显示有关热重载操作的每个步骤的诊断信息。诊断意外行为时很有用。
	"csharp.debug.hotReloadVerbosity": "minimal",

	// [实验性] 在调试时启用 C# 热重载。
	"csharp.experimental.debug.hotReload": false,

	// This setting is always enabled and will be removed in a future release.
	// [已弃用] 此设置已始终启用，并将在未来版本中移除。
	"csharp.preview.improvedLaunchExperience": true,

	// 控制 dotnet 任务的自动检测。
	"dotnet.autoDetect": "on",

	// 启用/禁用扩展的功能，以自动跟踪编辑器中的当前活动项，并在文件资源管理器中突出显示它。
	"dotnet.automaticallySyncWithActiveItem": false,

	// [Experimental] 启用内置 .NET Copilot 技能，以帮助进行 ASP.NET Core Web API 开发、性能分析和测试运行。
	"dotnet.copilot.enableDotnetSkills": true,

	// 尝试使用不受支持的 DebugType (例如 full 或 pdbonly)调试项目时，抑制警告对话框。
	"dotnet.debug.suppressInvalidDebugTypeWarning": false,

	// [预览] 将项目系统初始化问题发布到“问题”窗口。
	"dotnet.enablePublishIssuesToProblems": true,

	// 控制扩展是否使用默认 Visual Studio Code 文件系统观察程序。如果存在 files.watcherExclude 设置，建议执行此操作。
	"dotnet.preferVisualStudioCodeFileSystemWatcher": false,

	// 控制语言服务缓存文件(.lscache)的存储位置。值为 True 时与项目一同存储。值为 False 时存储在临时目录(开发中)
	"dotnet.projectsystem.cacheInProjectFolder": false,

	// 支持读写语言服务缓存文件(.lscache)与项目，以改进 IntelliSense 性能(正在开发)
	"dotnet.projectsystem.enableLanguageServiceCache": true,

	// 在项目系统托管进程中启用内存分配优化(功能开发中)
	"dotnet.projectsystem.useNewMemoryOptimization": false,

	// 如未安装所需的 SDK，将禁止自动显示 C# 工作区需求视图。
	"dotnet.suppressSdkInstallView": true,

	// 在磁盘上测试二进制文件更改时禁用自动测试发现。这可以避免生成大型解决方案时出现文件锁定问题。
	"dotnet.testWindow.disableAutoDiscovery": false,

	// 触发测试发现刷新时禁用自动生成。如果设置了此选项，则在刷新前必须手动生成测试，以确保它们是最新的。
	"dotnet.testWindow.disableBuildOnRefresh": false,

	// 在运行测试之前禁用自动生成。如果设置了此选项，则在运行前必须手动生成测试，以确保它们是最新的。
	"dotnet.testWindow.disableBuildOnRun": false,

	// 启用直接从 C# 源文件发现测试。(实验性)
	"dotnet.testWindow.discoverTestsFromSource": false,

	// 替代测试发现操作的默认超时(以秒为单位)。
	"dotnet.testWindow.discoveryTimeoutInSec": 900,

	// 为 C# 测试启用轻型测试体验。(实验性)
	"dotnet.testWindow.enableNextTest": true,

	// 启用测试资源管理器显示测试结果的差异。
	"dotnet.testWindow.enableTestExplorerDiff": false,

	// 禁用对具有兼容目标框架的项目进行检查。这可能会导致测试行为不稳定或中断。自行承担使用风险。
	"dotnet.testWindow.skipTargetFrameworkCompatibilityCheck": false,

	// 使用旧版 dotnet 解析。这是一个临时选项，用于解决新逻辑的潜在问题。
	"dotnet.useLegacyDotnetResolution": false,

	// 在 Mac 计算机上使用临时签名的 SDK。此选项强制使用 C# 开发工具包扩展在较慢的兼容模式下工作，并且应仅在必要时启用环境。
	"dotnet.workingWithTestSignedSdk": false,

	// 包括所有 NuGet 包操作的预发布包版本。
	"nuget.includePrereleasePackageVersions": false,

	// .NET Install Tool
	// If you'd like to continue using a .NET path that is not meant to be used for an extension and may cause instability (please read above about the existingDotnetPath setting) then set this to true and restart.
	"dotnetAcquisitionExtension.allowInvalidPaths": false,

	// To improve performance, the results of checking .NET Installations may be cached. If you're facing issues with an install not being detected, try setting this to 0.5, or 0; or increasing the number to improve performance. Restart to change.
	"dotnetAcquisitionExtension.cacheTimeToLiveMultiplier": 1,

	// Enable AI-powered language model tools for .NET management (install, uninstall, list versions, etc.) in GitHub Copilot and agent mode. Set to false to hide all .NET tools from the LLM. Restart VS Code to apply changes.
	"dotnetAcquisitionExtension.enableLanguageModelTools": true,

	// Enable Preview Features for the Extension. Restart VS Code to apply changes.
	"dotnetAcquisitionExtension.enablePreviewFeatures": false,

	// Enable Telemetry for the .NET Install Tool. Restart VS Code to apply changes.
	"dotnetAcquisitionExtension.enableTelemetry": true,

	// The path to an existing .NET host executable for an extension's code to run under, not for your project to run under.
	// Restart VS Code to apply changes.
	// 
	// ⚠️ This is NOT the .NET Runtime that your project will use to run. Extensions such as `C#`, `C# DevKit`, and more have components written in .NET. This .NET PATH is the `dotnet.exe` that these extensions will use to run their code, not your code.
	// 
	// Using a path value in which .NET does not meet the requirements of a specific extension will cause that extension to fail.
	// 
	// 🚀 The version of .NET that is used for your project is determined by the .NET host, or dotnet.exe. The .NET host picks a runtime based on your project. To use a specific version of .NET for your project, install the .NET SDK using the `.NET Install Tool - Install SDK System-Wide` command, install .NET manually using [our instructions](https://dotnet.microsoft.com/download), or edit your PATH environment variable to point to a `dotnet.exe` that has an `/sdk/` folder with only one SDK.
	"dotnetAcquisitionExtension.existingDotnetPath": [],

	// Enable this to show more detailed output from our extension.
	"dotnetAcquisitionExtension.highVerbosity": false,

	// Timeout for installing .NET in seconds.
	"dotnetAcquisitionExtension.installTimeoutValue": 600,

	// URL to a proxy if you use one, such as: https://proxy:port
	"dotnetAcquisitionExtension.proxyUrl": "",

	// The amount of seconds to wait before trying to update the .NET Runtime for the day.
	"dotnetAcquisitionExtension.runtimeUpdateDelaySeconds": 300,

	// The path of a preexisting .NET Runtime for ALL VS Code extensions to use for their internal components. This does NOT control the SDK or runtime used by your projects. Restart VS Code to apply changes.
	"dotnetAcquisitionExtension.sharedExistingDotnetPath": "",

	// Show the command to reset extension data in the command palette. Restart VS Code and remove dependent extensions first.
	"dotnetAcquisitionExtension.showResetDataCommand": false,

	// Hide all messages in the output window from our extension. Error pop-ups from APIs that other extensions request we display will still appear.
	"dotnetAcquisitionExtension.suppressOutput": false,

	// WSL
	// 如果已设置，WSL 日志中的输出将显示调试信息。
	"remote.WSL.debug": false,

	// 如果设置，WSL 扩展将在后台下载最新的服务器内部版本。它会为过去 2 周内使用的所有 WSL 平台执行此操作。
	"remote.WSL.downloadInBackground": true,

	// 如果设置，WSL 扩展将不会使用脚本在 WSL 中启动服务器。这是一项实验性功能，允许在禁用互操作的发行版中运行。
	"remote.WSL.experimental.scriptLessStartup": false,

	// 如果已设置，则轮询会用于在 WSL1 中监视文件。轮询可能占用大量 CPU，但可修复 WSL1 问题，即在监视时无法重命名文件夹。此选项需要重启才能生效。
	"remote.WSL.fileWatcher.polling": false,

	// WSL1 发行版中使用的文件观察程序轮询间隔(以毫秒为单位)(如果已设置了 `remote.WSL.fileWatcher.polling`)。
	// 此选项需要重启才能生效。
	"remote.WSL.fileWatcher.pollingInterval": 5000,

	// Time in seconds to retry failed server connection probes before treating a cached WSL server as stale. Set to 0 to disable retries. Close all WSL windows and reopen them for changes to take effect.
	"remote.WSL.serverProbeRetryTimeout": 60,

	// 如果已设置，WSL 窗口将从它打开的 shell 中获取环境。
	"remote.WSL.useShellEnvironment": true,

	// 不再使用，“wsl.exe”现在始终用于将连接转发到 WSL。
	// 
	"remote.WSL1.connectionMethod": "",

	// 不再使用，“wsl.exe”现在始终用于将连接转发到 WSL。
	// 
	"remote.WSL2.connectionMethod": "",

}