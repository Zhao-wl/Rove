	//  - list: 以列表形式显示文件
	//  - tree: 以树形式显示文件
	"gitlens.views.remotes.files.layout": "auto",

	// 指定在 _远程_ 视图中，根据一个嵌套级别中的文件数量，何时在以 `tree` 或 `list` 形式显示文件之间切换。仅在 `gitlens.views.remotes.files.layout` 设置为 `auto` 时适用
	"gitlens.views.remotes.files.threshold": 5,

	// 指定是否在 _远程_ 视图中查询与每个分支和提交关联的拉取请求。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.remotes.pullRequests.enabled": true,

	// 指定是否在 _远程_ 视图中显示与每个分支关联的拉取请求（如有）。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.remotes.pullRequests.showForBranches": true,

	// 指定是否在 _远程_ 视图中显示与提交关联的拉取请求（如有）。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.remotes.pullRequests.showForCommits": true,

	// 指定是否在 _远程_ 视图中显示远程，否则将在 _仓库_ 视图中显示
	"gitlens.views.remotes.reveal": true,

	// 贮藏视图
	// 指定是否压缩（平铺）_贮藏_ 视图中不必要的文件嵌套。仅在 `gitlens.views.stashes.files.layout` 设置为 `tree` 或 `auto` 时适用
	"gitlens.views.stashes.files.compact": true,

	// 指定 _贮藏_ 视图如何显示文件图标
