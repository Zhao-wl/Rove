	"gitlens.views.tags.files.layout": "auto",

	// 指定在 _标签_ 视图中，根据一个嵌套级别中的文件数量，何时在以 `tree` 或 `list` 形式显示文件之间切换。仅在 `gitlens.views.tags.files.layout` 设置为 `auto` 时适用
	"gitlens.views.tags.files.threshold": 5,

	// 指定是否在 _标签_ 视图中显示标签，否则将在 _仓库_ 视图中显示
	"gitlens.views.tags.reveal": true,

