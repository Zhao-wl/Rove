	//  - relativePath: 显示工作树相对路径
	"gitlens.views.worktrees.worktrees.viewAs": "name",

	// 指定创建新工作树的默认路径
	"gitlens.worktrees.defaultLocation": null,

	// 指定创建工作树后如何以及何时打开它。在“创建工作树”对话框中选择 _创建后_ 选项将更新此设置。
	//  - newWindow: 始终在新窗口中打开新工作树
	//  - currentWindow: 始终在当前窗口中打开新工作树
	//  - addToWorkspace: 始终将新工作树添加到当前工作区
	//  - none: 从不打开新工作树
	//  - onlyWhenEmpty: 仅当未打开任何文件夹时才在当前窗口中打开新工作树，否则在新窗口中打开。在“创建工作树”对话框中选择“创建后”选项时，将使用该选项替换此设置。
	"gitlens.worktrees.openAfterCreate": "newWindow",

	// 指定创建新工作树时是否提示输入路径
	"gitlens.worktrees.promptForLocation": true,

