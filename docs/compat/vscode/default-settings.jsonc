	//  - dialog-info: $(dialog-info)
	//  - dialog-close: $(dialog-close)
	//  - tree-item-expanded: $(tree-item-expanded)
	//  - tree-filter-on-type-on: $(tree-filter-on-type-on)
	//  - tree-filter-on-type-off: $(tree-filter-on-type-off)
	//  - tree-filter-clear: $(tree-filter-clear)
	//  - tree-item-loading: $(tree-item-loading)
	//  - menu-selection: $(menu-selection)
	//  - menu-submenu: $(menu-submenu)
	//  - menubar-more: $(menubar-more)
	//  - scrollbar-button-left: $(scrollbar-button-left)
	//  - scrollbar-button-right: $(scrollbar-button-right)
	//  - scrollbar-button-up: $(scrollbar-button-up)
	//  - scrollbar-button-down: $(scrollbar-button-down)
	//  - toolbar-more: $(toolbar-more)
	//  - quick-input-back: $(quick-input-back)
	//  - drop-down-button: $(drop-down-button)
	//  - symbol-customcolor: $(symbol-customcolor)
	//  - export: $(export)
	//  - workspace-unspecified: $(workspace-unspecified)
	//  - newline: $(newline)
	//  - thumbsdown-filled: $(thumbsdown-filled)
	//  - thumbsup-filled: $(thumbsup-filled)
	//  - lightbulb-sparkle-autofix: $(lightbulb-sparkle-autofix)
	//  - debug-breakpoint-pending: $(debug-breakpoint-pending)
	//  - compare: $(compare)
	//  - git-branch-checkout: $(git-branch-checkout)
	"terminal.integrated.tabs.defaultIcon": "terminal",

	// 控制显示在标题右侧的终端说明。根据上下文替换变量:
	// - `${cwd}`: 终端的当前工作目录。
	// - `${cwdFolder}`: 终端的当前工作目录，当值与初始工作目录不同时，显示在多根工作区或单个根工作区中。在 Windows 上，仅当启用 shell 集成时才会显示此内容。
	// - `${workspaceFolder}`: 在其中启动终端的工作区。
	// - `${workspaceFolderName}`: 在其中启动终端的工作区的 `name`。
	// - `${local}`: 指示远程工作区中的本地终端。
	// - `${process}`: 终端流程的名称。
	// - `${progress}`: 由 `OSC 9;4` 序列报告的进度状态。
	// - `${separator}`: 仅在由带有值或静态文本的变量括住时才显示的条件分隔符 (` - `)。
	// - `${sequence}`: 进程提供给终端的名称。
	// - `${task}`: 指示此终端与任务关联。
	// - `${shellType}`: 检测到的 shell 类型。
	// - `${shellCommand}`: 根据 shell 集成正在执行的命令。这也要求检测到的命令行具有高可信度，这在某些提示框架中可能不起作用。
	// - `${shellPromptInput}`: shell 的完整提示输入(根据 shell 集成)。
	"terminal.integrated.tabs.description": "${task}${separator}${local}${separator}${cwdFolder}",

	// 控制终端选项卡状态是否支持动画(例如正在进行的任务)。
	"terminal.integrated.tabs.enableAnimation": true,

	// 控制终端选项卡是否以列表的形式显示在终端的一侧。如果禁用此功能，将改为显示下拉列表。
	"terminal.integrated.tabs.enabled": true,

	// 控制是在双击时将焦点放在某个选项卡上还是单击。
	//  - singleClick: 双击终端选项卡时聚焦终端
	//  - doubleClick: 双击终端选项卡时聚焦终端
	"terminal.integrated.tabs.focusMode": "doubleClick",

	// 控制在特定条件下是否将隐藏终端选项卡视图。
	//  - never: 从不隐藏终端选项卡视图
	//  - singleTerminal: 仅打开一个终端时隐藏终端选项卡视图
	//  - singleGroup: 仅打开一个终端组时隐藏终端选项卡视图
	"terminal.integrated.tabs.hideCondition": "singleTerminal",

	// 控制终端选项卡的位置，该位置位于实际终端的左侧或右侧。
	//  - left: 在终端的左侧显示终端选项卡视图
	//  - right: 在终端的右侧显示终端选项卡视图
	"terminal.integrated.tabs.location": "right",

	// `terminal.integrated.tabs.title` 和 `terminal.integrated.tabs.description` 使用的分隔符。
	"terminal.integrated.tabs.separator": " - ",

	// 控制是否在“新建终端”按钮旁边显示“终端拆分”和“终止”按钮。
	//  - always: 始终显示操作
	//  - singleTerminal: 当终端是唯一打开的终端时显示操作
	//  - singleTerminalOrNarrow: 在终端是唯一打开的终端或选项卡视图处于窄而无文本状态时显示活动终端
	//  - never: 从不显示操作
	"terminal.integrated.tabs.showActions": "singleTerminalOrNarrow",

	// 在视图中显示活动的终端信息，当选项卡中的标题不可见时，此功能尤其有用。
	//  - always: 始终显示活动终端
	//  - singleTerminal: 当仅有一个终端打开时显示活动终端
	//  - singleTerminalOrNarrow: 仅当终端已打开或选项卡视图处于窄而无文本状态时显示活动终端
	//  - never: 从不显示活动终端
	"terminal.integrated.tabs.showActiveTerminal": "singleTerminalOrNarrow",

	// 控制终端标题。根据上下文替换变量:
	// - `${cwd}`: 终端的当前工作目录。
	// - `${cwdFolder}`: 终端的当前工作目录，当值与初始工作目录不同时，显示在多根工作区或单个根工作区中。在 Windows 上，仅当启用 shell 集成时才会显示此内容。
	// - `${workspaceFolder}`: 在其中启动终端的工作区。
	// - `${workspaceFolderName}`: 在其中启动终端的工作区的 `name`。
	// - `${local}`: 指示远程工作区中的本地终端。
	// - `${process}`: 终端流程的名称。
	// - `${progress}`: 由 `OSC 9;4` 序列报告的进度状态。
	// - `${separator}`: 仅在由带有值或静态文本的变量括住时才显示的条件分隔符 (` - `)。
	// - `${sequence}`: 进程提供给终端的名称。
	// - `${task}`: 指示此终端与任务关联。
	// - `${shellType}`: 检测到的 shell 类型。
	// - `${shellCommand}`: 根据 shell 集成正在执行的命令。这也要求检测到的命令行具有高可信度，这在某些提示框架中可能不起作用。
	// - `${shellPromptInput}`: shell 的完整提示输入(根据 shell 集成)。
	"terminal.integrated.tabs.title": "${process}",

	// 制表位中的单元格数。
	"terminal.integrated.tabStopWidth": 8,

	// 控制是否在终端中启用文本闪烁。
	"terminal.integrated.textBlinking": false,

	// 控制在终端中计算字符宽度时要使用的 unicode 版本。如果遇到未占用正确空格或退格量的表情符号或其他宽字符，或删除量太大或太小，则可能希望尝试调整此设置。
	//  - 6: unicode 的版本 6。此版本较旧，因此在较旧的系统中效果更好。
	//  - 11: unicode 的版本 11。此版本可在使用新式版本 unicode 的新式系统上提供更好的支持。
	"terminal.integrated.unicodeVersion": "11",

	// 控制是否在终端下拉列表中显示 WSL 发行版
	"terminal.integrated.useWslProfiles": true,

	// Whether to make the window that shows a terminal the owner of its console window, so dialogs that console applications open, like sign-in prompts, appear in front of VS Code instead of behind it. Requires `terminal.integrated.windowsUseConptyDll`.
	"terminal.integrated.windowsReparentConsoleWindow": true,

	// 是否使用 VS Code 附带的 conpty.dll (v1.25.260303002)，而不是与 Windows 捆绑的文件。
	"terminal.integrated.windowsUseConptyDll": true,

	// 一个包含所有字符的字符串，在双击选择单词和回退“word”链接检测时，会被视为单词分隔符。由于这用于链接检测，包括在检测链接时使用“:”之类的字符，将会忽略“file:10:5”等链接的行和列部分。
	"terminal.integrated.wordSeparators": " ()[]{}',\"`─‘’“”|",

	// 任务
	// 启用自动任务 - 请注意，任务将不会在不受信任的工作区中运行。
	//  - on: 始终
	//  - off: 从不
	"task.allowAutomaticTasks": "off",

	// 控制为所有任务提供程序扩展启用"提供任务"。如果"任务: 运行任务"命令速度较慢，则禁用任务提供程序的自动检测可能会提供帮助。单个扩展还可以提供禁用自动检测的设置。
	"task.autoDetect": "on",

	// 控制在任务已完成且窗口未聚焦的情况下，距离显示 OS 通知的最短任务运行时间(毫秒)。设置为 -1 可禁用通知。设置为 0 则始终显示通知。这包括窗口徽章和通知横幅。
	"task.notifyWindowOnTaskCompletion": 60000,

	// 配置在运行任务时是否显示问题匹配器提示。设置为"true"从不提示，或使用任务类型的字典仅关闭特定任务类型的提示。
	"task.problemMatchers.neverPrompt": false,

	// 控制是否显示在“运行任务”等任务快速选取中具有详细信息的任务的详细信息。
	"task.quickOpen.detail": true,

	// 控制任务快速打开对话框中跟踪的最近项目数。
	"task.quickOpen.history": 30,

	// 使 Tasks: Run Task 命令使用速度较慢的“全部显示”行为，而不是使用任务按提供程序进行分组的速度更快的双层选取器。
	"task.quickOpen.showAll": false,

	// 控制当只有一个任务要选取时是否跳过任务快速选取。
	"task.quickOpen.skip": false,

	// 在窗口重新加载时，重新连接到具有问题匹配器的任务。
	"task.reconnection": true,

	// 在运行任务前保存所有未保存的编辑器。
	//  - always: 运行前始终保存所有编辑器。
	//  - never: 运行前绝不保存编辑器。
	//  - prompt: 提示在运行前是否保存编辑器。
	"task.saveBeforeRun": "always",

	// 配置当提供程序速度较慢时是否显示警告
	"task.slowProviderWarning": true,

	// 为任务启用详细日志记录。
	"task.verboseLogging": false,

	// 视图
	// 指定是否在可能时尝试将已打开的工作树折叠为视图中的单个（通用）仓库
	"gitlens.views.collapseWorktreesWhenPossible": true,

	// 已弃用。请改用 `gitlens.views.formats.commits.description`
	// 
	"gitlens.views.commitDescriptionFormat": null,

	// 已弃用。请改用 `gitlens.views.formats.files.description`
	// 
	"gitlens.views.commitFileDescriptionFormat": null,

	// 已弃用。请改用 `gitlens.views.formats.files.label`
	// 
	"gitlens.views.commitFileFormat": null,

	// 已弃用。请改用 `gitlens.views.formats.commits.label`
	// 
	"gitlens.views.commitFormat": null,

	// 指定视图列表中默认显示的项目数量。使用 0 表示不限制
	"gitlens.views.defaultItemLimit": 10,

	// 指定视图中提交的描述格式。请参阅 GitLens 文档中的 [_提交令牌_](https://github.com/gitkraken/vscode-gitlens/wiki/Custom-Formatting#commit-tokens)
	"gitlens.views.formats.commits.description": "${author, }${agoOrDate}",

	// 指定视图中提交的格式。请参阅 GitLens 文档中的 [_提交令牌_](https://github.com/gitkraken/vscode-gitlens/wiki/Custom-Formatting#commit-tokens)
	"gitlens.views.formats.commits.label": "${❰ tips|11? ❱➤  }${message}",

	// 指定视图中提交的工具提示格式（markdown 格式）。请参阅 GitLens 文档中的 [_提交令牌_](https://github.com/eamodio/vscode-gitlens/wiki/Custom-Formatting#commit-tokens)
	"gitlens.views.formats.commits.tooltip": "${avatar} &nbsp;__${author}__${signature} &nbsp;$(history) ${agoAndDateBothSources} \\\n${link}${' via  'pullRequest}${'&nbsp;&nbsp;'changesDetail} ${message}${\n\n---\n\nfootnotes}\n\n${tips}",

	// 指定视图中“文件”提交的工具提示格式（markdown 格式）。请参阅 GitLens 文档中的 [_提交令牌_](https://github.com/eamodio/vscode-gitlens/wiki/Custom-Formatting#commit-tokens)
	"gitlens.views.formats.commits.tooltipWithStatus": "${avatar} &nbsp;__${author}__${signature} &nbsp;$(history) ${agoAndDateBothSources} \\\n${link}${' via  'pullRequest}&nbsp;&nbsp;•&nbsp;&nbsp;{{slot-status}} ${message}${\n\n---\n\nfootnotes}\n\n${tips}",

	// 指定视图中文件的描述格式。请参阅 GitLens 文档中的 [_文件令牌_](https://github.com/gitkraken/vscode-gitlens/wiki/Custom-Formatting#file-tokens)
	"gitlens.views.formats.files.description": "${directory}${  ←  originalPath}",

	// 指定视图中文件的格式。请参阅 GitLens 文档中的 [_文件令牌_](https://github.com/gitkraken/vscode-gitlens/wiki/Custom-Formatting#file-tokens)
	"gitlens.views.formats.files.label": "${working  }${file}",

	// 指定视图中贮藏的描述格式。请参阅 GitLens 文档中的 [_提交令牌_](https://github.com/gitkraken/vscode-gitlens/wiki/Custom-Formatting#commit-tokens)
	"gitlens.views.formats.stashes.description": "${stashOnRef, }${agoOrDate}",

	// 指定视图中贮藏的格式。请参阅 GitLens 文档中的 [_提交令牌_](https://github.com/gitkraken/vscode-gitlens/wiki/Custom-Formatting#commit-tokens)
	"gitlens.views.formats.stashes.label": "${message}",

	// 指定视图中贮藏的工具提示格式（markdown 格式）。请参阅 GitLens 文档中的 [_提交令牌_](https://github.com/eamodio/vscode-gitlens/wiki/Custom-Formatting#commit-tokens)
	"gitlens.views.formats.stashes.tooltip": "${link}${' on `'stashOnRef`}${'\\\n&nbsp;&nbsp;'changesDetail} \\\n &nbsp;$(history) ${agoAndDate} ${message}${\n\n---\n\nfootnotes}",

	// 指定是否允许在视图中选择多个项目
	"gitlens.views.multiselect": true,

	// 指定是在多差异编辑器（单个标签页）中打开多个更改，还是在单独的差异编辑器（多个标签页）中打开
	"gitlens.views.openChangesInMultiDiffEditor": true,

	// 指定对视图列表进行分页时每页显示的项目数量。使用 0 表示不限制
	"gitlens.views.pageItemLimit": 40,

	// 指定打开 _GitLens_ 视图时默认显示的视图
	//  - commits: 提交视图
	//  - branches: 工作树视图
	//  - remotes: 分支视图
	//  - stashes: 远程视图
	//  - tags: 贮藏视图
	//  - worktrees: 标签视图
	//  - contributors: 贡献者视图
	//  - repositories: 仓库视图
	//  - searchAndCompare: 文件历史视图
	//  - launchpad: Launchpad 视图
	//  - fileHistory: 搜索和比较视图
	"gitlens.views.scm.grouped.default": "commits",

	// 指定在组合到源代码管理侧边栏上的 _GitLens_ 视图中时，哪些视图将被隐藏
	"gitlens.views.scm.grouped.hiddenViews": {
		"commits": false,
		"worktrees": false,
		"branches": false,
		"remotes": false,
		"stashes": false,
		"tags": false,
		"contributors": false,
		"repositories": true,
		"fileHistory": false,
		"launchpad": false,
		"searchAndCompare": false
	},

	// 指定哪些视图将组合到源代码管理侧边栏上的 _GitLens_ 视图中
	"gitlens.views.scm.grouped.views": {
		"commits": true,
		"worktrees": true,
		"branches": true,
		"remotes": true,
		"stashes": true,
		"tags": true,
		"contributors": true,
		"repositories": true,
		"fileHistory": false,
		"launchpad": false,
		"searchAndCompare": false
	},

	// 指定是否在视图的比较结果中显示 _贡献者_ 部分
	"gitlens.views.showComparisonContributors": true,

	// 指定是否在视图的 _贡献者_ 部分中显示贡献者统计信息。计算可能需要一些时间，具体取决于仓库大小
	"gitlens.views.showContributorsStatistics": false,

	// 指定是否始终在视图顶部显示当前分支
	"gitlens.views.showCurrentBranchOnTop": true,

	// 指定是否在视图中的修订（提交）历史记录上显示相对日期标记（_少于一周前_、_超过一周前_、_超过一个月前_ 等）
	"gitlens.views.showRelativeDateMarkers": true,

	// 已弃用。请改用 `gitlens.views.formats.stashes.description`
	// 
	"gitlens.views.stashDescriptionFormat": null,

	// 已弃用。请改用 `gitlens.views.formats.files.description`
	// 
	"gitlens.views.stashFileDescriptionFormat": null,

	// 已弃用。请改用 `gitlens.views.formats.files.label`
	// 
	"gitlens.views.stashFileFormat": null,

	// 已弃用。请改用 `gitlens.views.formats.stashes.label`
	// 
	"gitlens.views.stashFormat": null,

	// 已弃用。请改用 `gitlens.views.formats.files.description`
	// 
	"gitlens.views.statusFileDescriptionFormat": null,

	// 已弃用。请改用 `gitlens.views.formats.files.label`
	// 
	"gitlens.views.statusFileFormat": null,

	// 外部终端
	// 在终端中从资源管理器打开文件时，确定将启动哪种类型的终端
	//  - integrated: 显示集成终端操作。
	//  - external: 显示外部终端操作。
	//  - both: 同时显示集成和外部终端操作。
	"terminal.explorerKind": "integrated",

	// 自定义要在 Linux 上运行的终端。
	"terminal.external.linuxExec": "xterm",

	// 定义在 macOS 上运行的终端应用程序。
	"terminal.external.osxExec": "Terminal.app",

	// 自定义要在 Windows 上运行的终端。
	"terminal.external.windowsExec": "C:\\windows\\System32\\cmd.exe",

	// 当从终端中从“源代码管理存储库”视图中打开文件时，确定将启动哪种类型的终端
	//  - integrated: 显示集成终端操作。
	//  - external: 显示外部终端操作。
	//  - both: 同时显示集成和外部终端操作。
	"terminal.sourceControlRepositoriesKind": "integrated",

	// 应用程序
	// 启用时，将自动分析慢速呈现器。
	"application.experimental.rendererProfiling": false,

	// 终端建议提供程序
	// 控制在键入时自动显示哪些建议。建议提供程序默认启用。
	"terminal.integrated.suggest.providers": {
		"lsp": false
	},

	// 在文件和文件夹上显示错误和警告。被关闭时由 `problems.visibility` 覆盖。
	"problems.decorations.enabled": true,

	// 导航路径
	// 启用/禁用导航路径。
	"breadcrumbs.enabled": true,

	// 控制是否及如何在“导航路径”视图中显示文件路径。
	//  - on: 在导航路径视图中显示文件路径。
	//  - off: 不在导航路径视图中显示文件路径。
	//  - last: 在导航路径视图中仅显示文件路径的最后一个元素。
	"breadcrumbs.filePath": "on",

	// 使用图标渲染面包屑导航项。
	"breadcrumbs.icons": true,

	// 启用后，痕迹导航栏将显示“数组”符号。
	"breadcrumbs.showArrays": true,

	// 启用后，痕迹导航栏将显示“布尔”符号。
	"breadcrumbs.showBooleans": true,

	// 启用后，痕迹导航栏显示“类”符号。
	"breadcrumbs.showClasses": true,

	// 启用后，痕迹导航栏将显示“常量”符号。
	"breadcrumbs.showConstants": true,

	// 启用后，痕迹符将显示“构造函数”符号。
	"breadcrumbs.showConstructors": true,

	// 控制痕迹导航栏是否显示下拉列表，以便在可打开当前文件的编辑器(例如，文本编辑器和自定义编辑器)之间切换。仅当有更专用的编辑器可用时，才会显示下拉列表。
	"breadcrumbs.showEditorType": true,

	// 启用后，痕迹导航栏将显示 "enumMember" 符号。
	"breadcrumbs.showEnumMembers": true,

	// 启用后，痕迹导航栏将显示“枚举”符号。
	"breadcrumbs.showEnums": true,

	// 启用后，痕迹导航栏将显示“事件”符号。
	"breadcrumbs.showEvents": true,

	// 启用后，痕迹导航栏将显示“字段”符号。
	"breadcrumbs.showFields": true,

	// 启用后，痕迹导航栏将显示“文件”符号。
	"breadcrumbs.showFiles": true,

	// 启用后，痕迹导航栏将显示“函数”符号。
	"breadcrumbs.showFunctions": true,

	// 启用后，痕迹导航栏将显示“接口”符号。
	"breadcrumbs.showInterfaces": true,

	// Controls whether breadcrumbs are shown for untitled files.
	"breadcrumbs.showInUntitledFiles": false,

	// 启用后，痕迹导航栏将显示“键”符号。
	"breadcrumbs.showKeys": true,

	// 启用后，痕迹导航栏将显示“方法”符号。
	"breadcrumbs.showMethods": true,

	// 启用后，痕迹导航栏将显示“模块”符号。
	"breadcrumbs.showModules": true,

	// 启用后，痕迹导航栏将显示“命名空间”符号。
	"breadcrumbs.showNamespaces": true,

	// 启用后，痕迹导航栏将显示 "null" 符号。
	"breadcrumbs.showNull": true,

	// 启用后，痕迹导航栏将显示“数字”符号。
	"breadcrumbs.showNumbers": true,

	// 启用后，痕迹导航栏将显示“对象”符号。
	"breadcrumbs.showObjects": true,

	// 启用后，痕迹导航栏将显示“运算符”符号。
	"breadcrumbs.showOperators": true,

	// 启用后，痕迹导航栏将显示“包”符号。
	"breadcrumbs.showPackages": true,

	// 启用后，痕迹导航栏将显示“属性”符号。
	"breadcrumbs.showProperties": true,

	// 启用后，痕迹导航栏将显示“字符串”符号。
	"breadcrumbs.showStrings": true,

	// 启用后，痕迹导航栏将显示“结构”符号。
	"breadcrumbs.showStructs": true,

	// 启用后，痕迹导航栏将显示 "typeParameter" 符号。
	"breadcrumbs.showTypeParameters": true,

	// 启用后，痕迹导航栏将显示“变量”符号。
	"breadcrumbs.showVariables": true,

	// 控制是否及如何在“导航路径”视图中显示符号。
	//  - on: 在“导航路径”视图中显示所有符号。
	//  - off: 不在导航路径视图中显示符号。
	//  - last: 在导航路径视图中仅显示当前符号。
	"breadcrumbs.symbolPath": "on",

	// 复制痕迹导航符号路径时使用的分隔符。
	"breadcrumbs.symbolPathSeparator": ".",

	// 控制“导航路径”大纲视图中符号的排序方式。
	//  - position: 以文件位置顺序显示符号大纲。
	//  - name: 以字母顺序显示符号大纲。
	//  - type: 以符号类型顺序显示符号大纲。
	"breadcrumbs.symbolSortOrder": "position",

	// 问题
	// 在打开文件时，控制是否在“问题”视图中对其进行定位。
	"problems.autoReveal": true,

	// 控制“问题”视图的默认视图模式。
	"problems.defaultViewMode": "tree",

	// 启用后，状态栏中将显示当前问题。
	"problems.showCurrentInStatus": false,

	// 控制问题导航的顺序。
	//  - severity: 导航按严重性排序的问题
	//  - position: 导航按位置排序的问题
	"problems.sortOrder": "severity",

	// 控制问题是否在整个编辑器和工作台中可见。
	"problems.visibility": true,

	// 性能
	// 此会话报告输入延迟遥测数据的概率(0 到 1)。设置为 0 表示禁用，设置为 1 表示始终报告。
	"telemetry.performance.inputLatencySamplingProbability": 0,

	// Launchpad 视图（Pro）
	// 指定是否在 _Launchpad_ 视图中显示头像图片而不是提交（或状态）图标
	"gitlens.views.launchpad.avatars": true,

	// 指定是否压缩（平铺）_Launchpad_ 视图中不必要的文件嵌套。仅在 `gitlens.views.launchpad.files.layout` 设置为 `tree` 或 `auto` 时适用
	"gitlens.views.launchpad.files.compact": true,

	// 指定 _Launchpad_ 视图如何显示文件图标
	//  - status: 将文件的状态显示为图标
	//  - type: 将文件的类型（主题图标）显示为图标
	"gitlens.views.launchpad.files.icon": "type",

	// 指定 _Launchpad_ 视图如何显示文件
	//  - auto: 根据 `gitlens.views.launchpad.files.threshold` 值和每个嵌套级别的文件数量，自动切换文件的显示形式（`tree` 或 `list`）
	//  - list: 以列表形式显示文件
	//  - tree: 以树形式显示文件
	"gitlens.views.launchpad.files.layout": "auto",

	// 指定在 _Launchpad_ 视图中，根据一个嵌套级别中的文件数量，何时在以 `tree` 或 `list` 形式显示文件之间切换。仅在 `gitlens.views.launchpad.files.layout` 设置为 `auto` 时适用
	"gitlens.views.launchpad.files.threshold": 5,

	// 提交视图
	// 指定是否在 _提交_ 视图中显示头像图片而不是提交（或状态）图标
	"gitlens.views.commits.avatars": true,

	// 指定是否压缩（平铺）_提交_ 视图中不必要的文件嵌套。仅在 `gitlens.views.commits.files.layout` 设置为 `tree` 或 `auto` 时适用
	"gitlens.views.commits.files.compact": true,

	// 指定 _提交_ 视图如何显示文件图标
	//  - status: 将文件的状态显示为图标
	//  - type: 将文件的类型（主题图标）显示为图标
	"gitlens.views.commits.files.icon": "type",

	// 指定 _提交_ 视图如何显示文件
	//  - auto: 根据 `gitlens.views.commits.files.threshold` 值和每个嵌套级别的文件数量，自动切换文件的显示形式（`tree` 或 `list`）
	//  - list: 以列表形式显示文件
	//  - tree: 以树形式显示文件
	"gitlens.views.commits.files.layout": "auto",

	// 指定在 _提交_ 视图中，根据一个嵌套级别中的文件数量，何时在以 `tree` 或 `list` 形式显示文件之间切换。仅在 `gitlens.views.commits.files.layout` 设置为 `auto` 时适用
	"gitlens.views.commits.files.threshold": 5,

	// 指定是否在 _提交_ 视图中查询与当前分支和提交关联的拉取请求。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.commits.pullRequests.enabled": true,

	// 指定是否在 _提交_ 视图中显示与当前分支关联的拉取请求（如有）。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.commits.pullRequests.showForBranches": true,

	// 指定是否在 _提交_ 视图中显示与提交关联的拉取请求（如有）。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.commits.pullRequests.showForCommits": true,

	// 指定是否在 _提交_ 视图中显示提交，否则将在 _仓库_ 视图中显示
	"gitlens.views.commits.reveal": true,

	// 指定是否在 _提交_ 视图中显示当前分支或工作树与用户选择的引用（分支、标签等）的比较
	//  - false: 隐藏分支比较
	//  - branch: 将当前分支与用户选择的引用进行比较
	//  - working: 将工作树与用户选择的引用进行比较
	"gitlens.views.commits.showBranchComparison": "working",

	// 指定是否在 _提交_ 视图中显示贮藏
	"gitlens.views.commits.showStashes": false,

	// 遥测
	// 如果此设置为 false，则无论新设置的值如何，都不会发送遥测数据。由于合并到 `telemetry.telemetryLevel` 设置，目前已弃用。
	// 启用要收集的崩溃报告。这有助于我们提高稳定性。
	// 此选项需重启才可生效。
	"telemetry.enableCrashReporter": true,

	// 如果此设置为 false，则无论新设置的值如何，都不会发送遥测数据。已弃用，推荐使用 `telemetry.telemetryLevel` 设置。
	// 启用要收集的诊断数据。这有助于我们更好地了解 Visual Studio Code 的执行情况以及哪里需要改进。[阅读详细信息](https://go.microsoft.com/fwlink/?LinkId=521839)关于我们收集的内容和隐私声明。
	"telemetry.enableTelemetry": true,

	// 启用反馈机制，例如问题报告器、调查和其他反馈选项。
	"telemetry.feedback.enabled": true,

	// 
	// 控制 Visual Studio Code 遥测、第一方扩展遥测和参与的第三方扩展遥测。一些第三方扩展可能不遵守此设置。请查阅特定扩展的文档以确定。遥测有助于我们更好地了解 Visual Studio Code 的执行情况、需要改进的地方以及功能的使用方式。 详细了解[我们收集的数据](https://aka.ms/vscode-telemetry)和我们的[隐私声明](https://go.microsoft.com/fwlink/?LinkId=521839)。 若要使崩溃报告更改生效，必须完全重新启动应用程序。
	// 
	// &nbsp;
	// 
	// 下表概述了每个设置所发送的数据:
	// 
	// |       | 崩溃报告 | 错误遥测 | 用法数据 |
	// |:------|:-------------:|:---------------:|:----------:|
	// | all   |       ✓       |        ✓        |     ✓      |
	// | error |       ✓       |        ✓        |     -      |
	// | crash |       ✓       |        -        |     -      |
	// | off   |       -       |        -        |     -      |
	// 
	// 
	// &nbsp;
	// 
	// ****注意:*** 如果此设置为“关闭”，则无论其他遥测设置如何，都不会发送遥测数据。如果此设置为“关闭”以外的任何选项，并且使用弃用的设置禁用遥测，则不会发送遥测数据。*
	// 
	//  - all: 发送使用情况数据、错误、故障报告。
	//  - error: 发送常规错误遥测和故障报告。
	//  - crash: 发送 OS 级别故障报告。
	//  - off: 禁用所有产品遥测。
	"telemetry.telemetryLevel": "all",

	// 大纲
	// 控制大纲项是折叠还是展开。
	//  - alwaysCollapse: 折叠所有项。
	//  - alwaysExpand: 展开所有项。
	"outline.collapseItems": "alwaysExpand",

	// 使用图标呈现大纲元素。
	"outline.icons": true,

	// 对大纲元素的错误和警告使用锁屏提醒。被关闭时由 `problems.visibility` 覆盖。
	"outline.problems.badges": true,

	// 对大纲元素的错误和警告使用颜色。被关闭时由 `problems.visibility` 覆盖。
	"outline.problems.colors": true,

	// 显示大纲元素上的错误和警告。被关闭时由 `problems.visibility` 覆盖。
	"outline.problems.enabled": true,

	// 启用后，大纲将显示 `array` 符号。
	"outline.showArrays": true,

	// 启用后，大纲将显示 `boolean` 符号。
	"outline.showBooleans": true,

	// 启用后，大纲将显示 `class` 符号。
	"outline.showClasses": true,

	// 启用后，大纲将显示`constant`符号。
	"outline.showConstants": true,

	// 启用大纲时，大纲将显示 `constructor` 符号。
	"outline.showConstructors": true,

	// 启用后，大纲将显示 `enumMember` 符号。
	"outline.showEnumMembers": true,

	// 启用后，大纲将显示 `enum` 符号。
	"outline.showEnums": true,

	// 启用后，大纲将显示 `event` 符号。
	"outline.showEvents": true,

	// 启用时，大纲将显示 `field`符号。
	"outline.showFields": true,

	// 启用后，大纲将显示 `file` 符号。
	"outline.showFiles": true,

	// 启用时，大纲将显示 `function` 符号。
	"outline.showFunctions": true,

	// 启用后，大纲将显示 `interface` 符号。
	"outline.showInterfaces": true,

	// 启用后，大纲将显示 `key`符号。
	"outline.showKeys": true,

	// 启用后，大纲将显示 `method` 符号。
	"outline.showMethods": true,

	// 启用后，大纲将显示 `module` 符号。
	"outline.showModules": true,

	// 启用后，大纲将显示 `namespace` 符号。
	"outline.showNamespaces": true,

	// 启用后，大纲将显示 `null` 符号。
	"outline.showNull": true,

	// 启用后，大纲将显示 `number` 符号。
	"outline.showNumbers": true,

	// 启用后，大纲将显示 `object` 符号。
	"outline.showObjects": true,

	// 启用时，大纲显示 `operator` 符号。
	"outline.showOperators": true,

	// 启用后，大纲将显示 `package` 符号。
	"outline.showPackages": true,

	// 启用后，大纲将显示 `property` 符号。
	"outline.showProperties": true,

	// 启用后，大纲将显示 `string` 符号。
	"outline.showStrings": true,

	// 启用后，大纲将显示`struct` 符号。
	"outline.showStructs": true,

	// 启用后，大纲将显示 `typeParameter` 符号。
	"outline.showTypeParameters": true,

	// 启用后，大纲将显示 `variable` 符号。
	"outline.showVariables": true,

	// 检查器视图
	// 指定是否自动链接提交信息中的外部资源
	"gitlens.views.commitDetails.autolinks.enabled": true,

	// 指定是否查找有关自动链接提交信息中外部资源的更多详细信息。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.commitDetails.autolinks.enhanced": true,

	// 指定是否在 _提交详细信息_ 视图中显示头像图像而不是提交（或状态）图标
	"gitlens.views.commitDetails.avatars": true,

	// 指定是否在 _提交详细信息_ 视图中压缩（扁平化）不必要的文件嵌套。仅在 `gitlens.views.commitDetails.files.layout` 设置为 `tree` 或 `auto` 时适用
	"gitlens.views.commitDetails.files.compact": true,

	// 指定 _提交详细信息_ 视图显示文件图标的方式
	//  - status: 以文件的状态作为图标
	//  - type: 以文件的类型（主题图标）作为图标
	"gitlens.views.commitDetails.files.icon": "type",

	// 指定 _提交详细信息_ 视图显示文件的方式
	//  - auto: 根据 `gitlens.views.commitDetails.files.threshold` 值和每个嵌套级别的文件数量，自动切换文件的显示形式（`tree` 或 `list`）
	//  - list: 以列表形式显示文件
	//  - tree: 以树结构形式显示文件
	"gitlens.views.commitDetails.files.layout": "auto",

	// 指定在 _提交详细信息_ 视图中根据嵌套级别中的文件数量，在以 `tree` 或 `list` 形式显示文件之间切换的时机。仅在 `gitlens.views.commitDetails.files.layout` 设置为 `auto` 时适用
	"gitlens.views.commitDetails.files.threshold": 5,

	// 指定是否查询关联的拉取请求。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.commitDetails.pullRequests.enabled": true,

	// 拉取请求视图
	// 指定是否在 _拉取请求_ 视图中显示头像图片而不是提交（或状态）图标
	"gitlens.views.pullRequest.avatars": true,

	// 指定是否压缩（平铺）_拉取请求_ 视图中不必要的文件嵌套。仅在 `gitlens.views.pullRequest.files.layout` 设置为 `tree` 或 `auto` 时适用
	"gitlens.views.pullRequest.files.compact": true,

	// 指定 _拉取请求_ 视图如何显示文件图标
	//  - status: 将文件的状态显示为图标
	//  - type: 将文件的类型（主题图标）显示为图标
	"gitlens.views.pullRequest.files.icon": "type",

	// 指定 _拉取请求_ 视图如何显示文件
	//  - auto: 根据 `gitlens.views.pullRequest.files.threshold` 值和每个嵌套级别的文件数量，自动切换文件的显示形式（`tree` 或 `list`）
	//  - list: 以列表形式显示文件
	//  - tree: 以树形式显示文件
	"gitlens.views.pullRequest.files.layout": "auto",

	// 指定在 _拉取请求_ 视图中，根据一个嵌套级别中的文件数量，何时在以 `tree` 或 `list` 形式显示文件之间切换。仅在 `gitlens.views.pullRequest.files.layout` 设置为 `auto` 时适用
	"gitlens.views.pullRequest.files.threshold": 5,

	// 仓库视图
	// 指定在仓库或文件系统更改时是否自动刷新 _仓库_ 视图
	"gitlens.views.repositories.autoRefresh": true,

	// 指定打开文件时是否在 _仓库_ 视图中自动显示仓库
	"gitlens.views.repositories.autoReveal": true,

	// 指定是否在 _仓库_ 视图中显示头像图片而不是提交（或状态）图标
	"gitlens.views.repositories.avatars": true,

	// 指定是否压缩（平铺）_仓库_ 视图中不必要的分支和标签嵌套。仅在 `gitlens.views.repositories.branches.layout` 设置为 `tree` 时适用
	"gitlens.views.repositories.branches.compact": true,

	// 指定 _仓库_ 视图如何显示分支和标签
	//  - list: 以列表形式显示分支和标签
	//  - tree: 当名称包含斜杠 `/` 时，以树形式显示分支和标签
	"gitlens.views.repositories.branches.layout": "tree",

	// 指定是否在 _仓库_ 视图中的每个分支下方显示该分支与用户选择的引用（分支、标签等）的比较
	//  - false: 隐藏分支比较
	//  - branch: 将分支与用户选择的引用进行比较
	"gitlens.views.repositories.branches.showBranchComparison": "branch",

	// 指定是否在 _仓库_ 视图的 _提交_ 和 _分支_ 部分中显示贮藏
	"gitlens.views.repositories.branches.showStashes": false,

	// 指定是否以紧凑的显示密度显示 _仓库_ 视图
	"gitlens.views.repositories.compact": false,

	// 已弃用。此设置已不再使用
	// 
	"gitlens.views.repositories.enabled": null,

	// 指定是否压缩（平铺）_仓库_ 视图中不必要的文件嵌套。仅在 `gitlens.views.repositories.files.layout` 设置为 `tree` 或 `auto` 时适用
	"gitlens.views.repositories.files.compact": true,

	// 指定 _仓库_ 视图如何显示文件图标
	//  - status: 将文件的状态显示为图标
	//  - type: 将文件的类型（主题图标）显示为图标
	"gitlens.views.repositories.files.icon": "type",

	// 指定 _仓库_ 视图如何显示文件
	//  - auto: 根据 `gitlens.views.repositories.files.threshold` 值和每个嵌套级别的文件数量，自动切换文件的显示形式（`tree` 或 `list`）
	//  - list: 以列表形式显示文件
	//  - tree: 以树形式显示文件
	"gitlens.views.repositories.files.layout": "auto",

	// 指定在 _仓库_ 视图中，根据一个嵌套级别中的文件数量，何时在以 `tree` 或 `list` 形式显示文件之间切换。仅在 `gitlens.views.repositories.files.layout` 设置为 `auto` 时适用
	"gitlens.views.repositories.files.threshold": 5,

	// 指定是否在 _仓库_ 视图中包含每个仓库的工作树文件状态
	"gitlens.views.repositories.includeWorkingTree": false,

	// 指定是否在 _仓库_ 视图中查询与分支和提交关联的拉取请求。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.repositories.pullRequests.enabled": true,

	// 指定是否在 _仓库_ 视图中显示与分支关联的拉取请求（如有）。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.repositories.pullRequests.showForBranches": true,

	// 指定是否在 _仓库_ 视图中显示与提交关联的拉取请求（如有）。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.repositories.pullRequests.showForCommits": true,

	// 指定是否在 _仓库_ 视图中显示当前分支或工作树与用户选择的引用（分支、标签等）的比较
	//  - false: 隐藏分支比较
	//  - branch: 将当前分支与用户选择的引用进行比较
	//  - working: 将工作树与用户选择的引用进行比较
	"gitlens.views.repositories.showBranchComparison": "working",

	// 指定是否在 _仓库_ 视图中显示每个仓库的分支
	"gitlens.views.repositories.showBranches": true,

	// 指定是否在 _仓库_ 视图中显示每个仓库的当前分支上的提交
	"gitlens.views.repositories.showCommits": true,

	// 指定是否在 _仓库_ 视图中显示每个仓库的贡献者
	"gitlens.views.repositories.showContributors": true,

	// 指定是否在 _仓库_ 视图中显示每个仓库的实验性传入活动
	"gitlens.views.repositories.showIncomingActivity": false,

	// 指定是否在 _仓库_ 视图中显示每个仓库的远程
	"gitlens.views.repositories.showRemotes": true,

	// 指定是否在 _仓库_ 视图中显示每个仓库的贮藏
	"gitlens.views.repositories.showStashes": false,

	// 指定是否在 _仓库_ 视图中显示每个仓库的标签
	"gitlens.views.repositories.showTags": true,

	// 指定是否在 _仓库_ 视图中显示每个仓库当前分支的上游状态
	"gitlens.views.repositories.showUpstreamStatus": true,

	// 指定是否在 _仓库_ 视图中显示每个仓库的工作树
	"gitlens.views.repositories.showWorktrees": true,

	// 指定 _仓库_ 视图如何显示工作树
	//  - name: 显示工作树名称
	//  - path: 显示工作树路径
	//  - relativePath: 显示工作树相对路径
	"gitlens.views.repositories.worktrees.viewAs": "name",

	// 文件历史视图
	// 指定文件历史是否跟随重命名
	"gitlens.advanced.fileHistoryFollowsRenames": true,

	// 指定文件历史是否显示所有分支的提交
	"gitlens.advanced.fileHistoryShowAllBranches": false,

	// 指定文件历史是否显示合并提交
	"gitlens.advanced.fileHistoryShowMergeCommits": false,

	// 指定是否在 _文件历史_ 视图中显示头像图片而不是状态图标
	"gitlens.views.fileHistory.avatars": true,

	// 指定是否压缩（平铺）_文件历史_ 视图中不必要的文件嵌套。仅在 `gitlens.views.fileHistory.files.layout` 设置为 `tree` 或 `auto` 时适用
	"gitlens.views.fileHistory.files.compact": true,

	// 指定 _文件历史_ 视图如何显示文件图标
	//  - status: 将文件的状态显示为图标
	//  - type: 将文件的类型（主题图标）显示为图标
	"gitlens.views.fileHistory.files.icon": "type",

	// 指定 _文件历史_ 视图如何显示文件
	//  - auto: 根据 `gitlens.views.fileHistory.files.threshold` 值和每个嵌套级别的文件数量，自动切换文件的显示形式（`tree` 或 `list`）
	//  - list: 以列表形式显示文件
	//  - tree: 以树形式显示文件
	"gitlens.views.fileHistory.files.layout": "auto",

	// 指定在 _文件历史_ 视图中，根据一个嵌套级别中的文件数量，何时在以 `tree` 或 `list` 形式显示文件之间切换。仅在 `gitlens.views.fileHistory.files.layout` 设置为 `auto` 时适用
	"gitlens.views.fileHistory.files.threshold": 5,

	// 指定 _文件历史_ 视图的默认模式
	//  - commits: 显示所选文件或文件夹的提交
	//  - contributors: 显示所选文件或文件夹的贡献者
	"gitlens.views.fileHistory.mode": "commits",

	// 指定是否在 _文件历史_ 视图中查询与提交关联的拉取请求。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.fileHistory.pullRequests.enabled": true,

	// 指定是否在 _文件历史_ 视图中显示与提交关联的拉取请求（如有）。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.fileHistory.pullRequests.showForCommits": true,

	// 可视化文件历史（Pro）
	// 指定是否允许在编辑器区域中打开多个 _可视化文件历史_ 实例
	"gitlens.visualHistory.allowMultiple": true,

	// 指定当 _可视化文件历史_ 处于编辑器标签页中时，从其打开的编辑器（文件、差异等）应显示在哪个编辑器组中。在侧边栏中显示时无效。
	//  - auto: 当可视化文件历史是活动编辑器时，在其旁边打开编辑器；否则在活动编辑器组中打开
	//  - active: 始终在活动编辑器组中打开编辑器
	"gitlens.visualHistory.editorOpeningBehavior": "auto",

	// 指定在 _可视化文件历史_ 中可查询用于统计信息的提交数量上限（受速率限制影响）。仅适用于虚拟工作区。
	"gitlens.visualHistory.queryLimit": 20,

	// 行历史视图
	// 指定是否在 _行历史_ 视图中显示头像图片而不是状态图标
	"gitlens.views.lineHistory.avatars": true,

	// 已弃用。此设置已不再使用
	// 
	"gitlens.views.lineHistory.enabled": null,

	// 分支视图
	// 指定是否在 _分支_ 视图中显示头像图像而不是提交（或状态）图标
	"gitlens.views.branches.avatars": true,

	// 指定是否在 _分支_ 视图中压缩（扁平化）不必要的分支嵌套。仅在 `gitlens.views.branches.branches.layout` 设置为 `tree` 时适用
	"gitlens.views.branches.branches.compact": true,

	// 指定 _分支_ 视图显示分支的方式
	//  - list: 以列表形式显示分支
	//  - tree: 当名称包含斜杠 `/` 时以树结构形式显示分支
	"gitlens.views.branches.branches.layout": "tree",

	// 指定是否在 _分支_ 视图中压缩（扁平化）不必要的文件嵌套。仅在 `gitlens.views.branches.files.layout` 设置为 `tree` 或 `auto` 时适用
	"gitlens.views.branches.files.compact": true,

	// 指定 _分支_ 视图显示文件图标的方式
	//  - status: 以文件的状态作为图标
	//  - type: 以文件的类型（主题图标）作为图标
	"gitlens.views.branches.files.icon": "type",

	// 指定 _分支_ 视图显示文件的方式
	//  - auto: 根据 `gitlens.views.branches.files.threshold` 值和每个嵌套级别的文件数量，自动切换文件的显示形式（`tree` 或 `list`）
	//  - list: 以列表形式显示文件
	//  - tree: 以树结构形式显示文件
	"gitlens.views.branches.files.layout": "auto",

	// 指定在 _分支_ 视图中根据嵌套级别中的文件数量，在以 `tree` 或 `list` 形式显示文件之间切换的时机。仅在 `gitlens.views.branches.files.layout` 设置为 `auto` 时适用
	"gitlens.views.branches.files.threshold": 5,

	// 指定是否在 _分支_ 视图中查询与每个分支和提交关联的拉取请求。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.branches.pullRequests.enabled": true,

	// 指定是否在 _分支_ 视图中显示与每个分支关联的拉取请求（如有）。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.branches.pullRequests.showForBranches": true,

	// 指定是否在 _分支_ 视图中显示与提交关联的拉取请求（如有）。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.branches.pullRequests.showForCommits": true,

	// 指定是否在 _分支_ 视图中显示分支，否则在 _仓库_ 视图中显示
	"gitlens.views.branches.reveal": true,

	// 指定是否在 _分支_ 视图中显示分支与用户选择的引用（分支、标签等）的比较
	//  - false: 隐藏分支比较
	//  - branch: 将分支与用户选择的引用进行比较
	"gitlens.views.branches.showBranchComparison": "branch",

	// 指定是否在 _分支_ 视图和 _提交图_ 侧边栏中显示默认远程的远程分支
	"gitlens.views.branches.showRemoteBranches": false,

	// 指定是否在 _分支_ 视图中显示贮藏
	"gitlens.views.branches.showStashes": false,

	// 远程视图
	// 指定是否在 _远程_ 视图中显示头像图片而不是提交（或状态）图标
	"gitlens.views.remotes.avatars": true,

	// 指定是否压缩（平铺）_远程_ 视图中不必要的分支嵌套。仅在 `gitlens.views.remotes.branches.layout` 设置为 `tree` 时适用
	"gitlens.views.remotes.branches.compact": true,

	// 指定 _远程_ 视图如何显示分支
	//  - list: 以列表形式显示分支
	//  - tree: 当名称包含斜杠 `/` 时，以树形式显示分支
	"gitlens.views.remotes.branches.layout": "tree",

	// 指定是否压缩（平铺）_远程_ 视图中不必要的文件嵌套。仅在 `gitlens.views.remotes.files.layout` 设置为 `tree` 或 `auto` 时适用
	"gitlens.views.remotes.files.compact": true,

	// 指定 _远程_ 视图如何显示文件图标
	//  - status: 将文件的状态显示为图标
