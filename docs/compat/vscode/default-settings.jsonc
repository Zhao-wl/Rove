	// 指定是否在 _工作树_ 视图中显示头像图片而不是提交（或状态）图标
	"gitlens.views.worktrees.avatars": true,

	// 指定是否压缩（平铺）_工作树_ 视图中不必要的分支嵌套。仅在 `gitlens.views.worktrees.branches.layout` 设置为 `tree` 时适用
	"gitlens.views.worktrees.branches.compact": true,

	// 指定 _工作树_ 视图如何显示工作树分支
	//  - list: 以列表形式显示工作树分支
	//  - tree: 当名称包含斜杠 `/` 时，以树形式显示工作树分支
	"gitlens.views.worktrees.branches.layout": "tree",

	// 指定是否压缩（平铺）_工作树_ 视图中不必要的文件嵌套。仅在 `gitlens.views.worktrees.files.layout` 设置为 `tree` 或 `auto` 时适用
	"gitlens.views.worktrees.files.compact": true,

	// 指定 _工作树_ 视图如何显示文件图标
	//  - status: 将文件的状态显示为图标
	//  - type: 将文件的类型（主题图标）显示为图标
	"gitlens.views.worktrees.files.icon": "type",

	// 指定 _工作树_ 视图如何显示文件
	//  - auto: 根据 `gitlens.views.worktrees.files.threshold` 值和每个嵌套级别的文件数量，自动切换文件的显示形式（`tree` 或 `list`）
	//  - list: 以列表形式显示文件
	//  - tree: 以树形式显示文件
	"gitlens.views.worktrees.files.layout": "auto",

	// 指定在 _工作树_ 视图中，根据一个嵌套级别中的文件数量，何时在以 `tree` 或 `list` 形式显示文件之间切换。仅在 `gitlens.views.worktrees.files.layout` 设置为 `auto` 时适用
	"gitlens.views.worktrees.files.threshold": 5,

	// 指定是否在 _工作树_ 视图中查询与工作树分支和提交关联的拉取请求。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.worktrees.pullRequests.enabled": true,

	// 指定是否在 _工作树_ 视图中显示与工作树分支关联的拉取请求（如有）。需要连接到受支持的远程服务（例如 GitHub）
	"gitlens.views.worktrees.pullRequests.showForBranches": true,

