	"gitlens.views.stashes.files.threshold": 5,

	// 指定是否在 _贮藏_ 视图中显示贮藏，否则将在 _仓库_ 视图中显示
	"gitlens.views.stashes.reveal": true,

	// 标签视图
	// 指定是否在 _标签_ 视图中显示头像图片而不是提交（或状态）图标
	"gitlens.views.tags.avatars": true,

	// 指定是否压缩（平铺）_标签_ 视图中不必要的标签嵌套。仅在 `gitlens.views.tags.branches.layout` 设置为 `tree` 时适用
	"gitlens.views.tags.branches.compact": true,

